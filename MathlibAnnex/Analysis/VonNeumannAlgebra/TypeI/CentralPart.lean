import MathlibAnnex.Analysis.VonNeumannAlgebra.TypeI.Basic
import MathlibAnnex.Analysis.VonNeumannAlgebra.Projection.CentralSupport
import MathlibAnnex.Analysis.VonNeumannAlgebra.PolarDecomposition

/-!
# The central hull of abelian projections

The central hull of all abelian projections is the largest type I central
part and has an abelian-free complementary corner. A nonzero projection in
the hull has a nonzero algebraic overlap `r*a*q` with an abelian projection
`q`. Internal polar decomposition moves an abelian subprojection of `q` to
a nonzero abelian subprojection of `r`.
-/

set_option autoImplicit false
noncomputable section

open scoped CStarAlgebra

namespace VonNeumannAlgebra

universe u
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H]

/-- The central projection generated by all abelian projections of `M`. -/
def abelianCentralSupport (M : VonNeumannAlgebra H) : M.toStarSubalgebra :=
  centralHull M {p | IsAbelianProjection M p}

theorem isStarProjection_abelianCentralSupport (M : VonNeumannAlgebra H) :
    IsStarProjection (abelianCentralSupport M) :=
  isStarProjection_centralHull M {p | IsAbelianProjection M p}

theorem abelianCentralSupport_commute (M : VonNeumannAlgebra H)
    (a : M.toStarSubalgebra) :
    a * abelianCentralSupport M = abelianCentralSupport M * a :=
  centralHull_commute M {p | IsAbelianProjection M p} a

theorem IsAbelianProjection.mul_abelianCentralSupport
    {M : VonNeumannAlgebra H} {p : M.toStarSubalgebra}
    (hp : IsAbelianProjection M p) : p * abelianCentralSupport M = p :=
  mul_centralHull_eq M {p | IsAbelianProjection M p} hp

/-- Multiplication by a central projection cuts down an abelian corner. -/
theorem IsAbelianProjection.mul_central {M : VonNeumannAlgebra H}
    {p z : M.toStarSubalgebra} (hp : IsAbelianProjection M p)
    (hz : IsStarProjection z)
    (hcentral : ∀ a : M.toStarSubalgebra, a * z = z * a) :
    IsAbelianProjection M (p * z) := by
  have hpz : Commute p z := hcentral p
  have hproj : IsStarProjection (p * z) := hp.1.mul hz hpz
  apply hp.of_mul_eq_self hproj
  calc
    (p * z) * p = p * (z * p) := mul_assoc _ _ _
    _ = p * (p * z) := by rw [← hcentral p]
    _ = (p * p) * z := (mul_assoc _ _ _).symm
    _ = p * z := by rw [hp.1.isIdempotentElem.eq]

/-- There is no nonzero abelian projection in the complementary corner. -/
theorem eq_zero_of_abelian_of_mul_complement_eq {M : VonNeumannAlgebra H}
    {p : M.toStarSubalgebra} (hp : IsAbelianProjection M p)
    (hcomp : p * (1 - abelianCentralSupport M) = p) : p = 0 := by
  have hzero : p * (1 - abelianCentralSupport M) = 0 := by
    rw [mul_sub, mul_one, hp.mul_abelianCentralSupport, sub_self]
  exact hcomp.symm.trans hzero

/-- Every type I projection is below the central hull of the abelian
projections, even when the original projection is not central. -/
theorem IsTypeIProjection.mul_abelianCentralSupport {M : VonNeumannAlgebra H}
    {p : M.toStarSubalgebra} (hp : IsTypeIProjection M p) :
    p * abelianCentralSupport M = p := by
  let z : M.toStarSubalgebra := abelianCentralSupport M
  have hz : IsStarProjection z := isStarProjection_abelianCentralSupport M
  have hpz : p * z = z * p := abelianCentralSupport_commute M p
  have hpc : Commute p (1 - z) := by
    change p * (1 - z) = (1 - z) * p
    rw [mul_sub, sub_mul, mul_one, one_mul, hpz]
  let r : M.toStarSubalgebra := p * (1 - z)
  have hr : IsStarProjection r := hp.1.mul hz.one_sub hpc
  have hrp : r * p = r := by
    calc
      r * p = p * ((1 - z) * p) := mul_assoc _ _ _
      _ = p * (p * (1 - z)) := by rw [← hpc.eq]
      _ = (p * p) * (1 - z) := (mul_assoc _ _ _).symm
      _ = r := by rw [hp.1.isIdempotentElem.eq]
  have hrc : r * (1 - z) = r := by
    change (p * (1 - z)) * (1 - z) = p * (1 - z)
    rw [mul_assoc, hz.one_sub.isIdempotentElem.eq]
  have hrzero : r = 0 := by
    by_contra hr0
    obtain ⟨q, hq, hq0, hqr⟩ := hp.2 r hr hr0 hrp
    apply hq0
    apply eq_zero_of_abelian_of_mul_complement_eq hq
    change q * (1 - z) = q
    calc
      q * (1 - z) = (q * r) * (1 - z) := by rw [hqr]
      _ = q * (r * (1 - z)) := mul_assoc _ _ _
      _ = q := by rw [hrc, hqr]
  have hsub : p - p * z = 0 := by
    simpa only [r, mul_sub, mul_one] using hrzero
  exact (sub_eq_zero.mp hsub).symm

/-- Any central projection with abelian-free complement dominates the
central hull of all abelian projections. -/
theorem abelianCentralSupport_le_of_no_abelian_complement
    (M : VonNeumannAlgebra H) {z : M.toStarSubalgebra} (hz : IsStarProjection z)
    (hcentral : ∀ a : M.toStarSubalgebra, a * z = z * a)
    (hcomp : ∀ p : M.toStarSubalgebra, IsAbelianProjection M p →
      p * (1 - z) = p → p = 0) :
    abelianCentralSupport M * z = abelianCentralSupport M := by
  apply centralHull_le M {p | IsAbelianProjection M p} hz hcentral
  intro p hp
  have hc : ∀ a : M.toStarSubalgebra, a * (1 - z) = (1 - z) * a := by
    intro a
    rw [mul_sub, sub_mul, mul_one, one_mul, hcentral a]
  have hp' : IsAbelianProjection M (p * (1 - z)) := hp.mul_central hz.one_sub hc
  have hpc : (p * (1 - z)) * (1 - z) = p * (1 - z) := by
    rw [mul_assoc, hz.one_sub.isIdempotentElem.eq]
  have hzero := hcomp (p * (1 - z)) hp' hpc
  have hpz : p * z = p := by
    have hsub : p - p * z = 0 := by simpa only [mul_sub, mul_one] using hzero
    exact (sub_eq_zero.mp hsub).symm
  exact (hcentral p).symm.trans hpz

/-- Uniqueness of the type I central part. The type I hypothesis is used
only to prove the opposite inequality; no existence assertion is hidden. -/
theorem eq_abelianCentralSupport_of_type_i_decomposition
    (M : VonNeumannAlgebra H) {z : M.toStarSubalgebra}
    (hz : IsTypeIProjection M z)
    (hcentral : ∀ a : M.toStarSubalgebra, a * z = z * a)
    (hcomp : ∀ p : M.toStarSubalgebra, IsAbelianProjection M p →
      p * (1 - z) = p → p = 0) : z = abelianCentralSupport M := by
  have hzle := hz.mul_abelianCentralSupport
  have hle := abelianCentralSupport_le_of_no_abelian_complement M hz.1 hcentral hcomp
  calc
    z = z * abelianCentralSupport M := hzle.symm
    _ = abelianCentralSupport M * z := abelianCentralSupport_commute M z
    _ = abelianCentralSupport M := hle

/-- In a type I algebra the abelian central support is the identity. -/
theorem IsTypeI.abelianCentralSupport_eq_one {M : VonNeumannAlgebra H}
    (hM : IsTypeI M) : abelianCentralSupport M = 1 := by
  have h := (hM.isTypeIProjection (IsStarProjection.one _)).mul_abelianCentralSupport
  simpa only [one_mul] using h

theorem abelianCentralSupport_eq_zero_iff (M : VonNeumannAlgebra H) :
    abelianCentralSupport M = 0 ↔
      ∀ p : M.toStarSubalgebra, IsAbelianProjection M p → p = 0 := by
  constructor
  · intro h p hp
    have hfix := hp.mul_abelianCentralSupport
    simpa only [h, mul_zero] using hfix.symm
  · intro h
    have hle : abelianCentralSupport M * 0 = abelianCentralSupport M := by
      apply centralHull_le M {p | IsAbelianProjection M p} (IsStarProjection.zero _)
      · intro a
        simp
      · intro p hp
        rw [h p hp, zero_mul]
    simpa only [mul_zero] using hle.symm

/-- A nonzero projection in the central hull overlaps an abelian corner;
polar decomposition transports an abelian subprojection back into it. -/
theorem isTypeIProjection_abelianCentralSupport (M : VonNeumannAlgebra H) :
    IsTypeIProjection M (abelianCentralSupport M) := by
  refine ⟨isStarProjection_abelianCentralSupport M, ?_⟩
  intro r hr hr0 hrz
  have hoverlap : r * centralHull M {p | IsAbelianProjection M p} ≠ 0 := by
    change r * abelianCentralSupport M ≠ 0
    rwa [hrz]
  obtain ⟨q, hq, a, hneq⟩ :=
    exists_mul_mul_ne_zero_of_mul_centralHull_ne_zero
      M {p | IsAbelianProjection M p} r hoverlap
  let x : M.toStarSubalgebra := r * a * q
  have hx0 : x ≠ 0 := hneq
  have hrx : r * x = x := by
    change r * (r * a * q) = r * a * q
    calc
      r * (r * a * q) = (r * r) * a * q := by simp only [mul_assoc]
      _ = r * a * q := by rw [hr.isIdempotentElem.eq]
  have hxq : x * q = x := by
    change (r * a * q) * q = r * a * q
    rw [mul_assoc, hq.1.isIdempotentElem.eq]
  have hl : leftSupport M x ≤ r := (leftSupport_le_iff M x hr).mpr hrx
  have hs : rightSupport M x ≤ q := (rightSupport_le_iff M x hq.1).mpr hxq
  have habs : IsAbelianProjection M (rightSupport M x) :=
    hq.of_mul_eq_self (isStarProjection_rightSupport M x)
      (((isStarProjection_rightSupport M x).le_iff_mul_eq_left hq.1).mp hs)
  have habl : IsAbelianProjection M (leftSupport M x) :=
    habs.of_equivalent (murrayVonNeumannEquivalent_supports M x)
  have hl0 : leftSupport M x ≠ 0 := by
    intro h
    exact hx0 ((leftSupport_eq_zero_iff M x).mp h)
  exact ⟨leftSupport M x, habl, hl0,
    ((isStarProjection_leftSupport M x).le_iff_mul_eq_left hr).mp hl⟩

/-- The type I central part, with maximality and uniqueness. The local
predicate is the internal projection formulation for the corner with unit
`z`. Its complement has no nonzero abelian projection. -/
theorem exists_type_i_central_decomposition (M : VonNeumannAlgebra H) :
    ∃ z : M.toStarSubalgebra,
      IsTypeIProjection M z ∧
      (∀ a : M.toStarSubalgebra, a * z = z * a) ∧
      (∀ p : M.toStarSubalgebra, IsAbelianProjection M p →
        p * (1 - z) = p → p = 0) ∧
      (∀ p : M.toStarSubalgebra, IsTypeIProjection M p → p * z = p) ∧
      ∀ w : M.toStarSubalgebra, IsTypeIProjection M w →
        (∀ a : M.toStarSubalgebra, a * w = w * a) →
        (∀ p : M.toStarSubalgebra, IsAbelianProjection M p →
          p * (1 - w) = p → p = 0) → w = z := by
  refine ⟨abelianCentralSupport M, isTypeIProjection_abelianCentralSupport M,
    abelianCentralSupport_commute M, ?_, ?_, ?_⟩
  · intro p hp hpc
    exact eq_zero_of_abelian_of_mul_complement_eq hp hpc
  · intro p hp
    exact hp.mul_abelianCentralSupport
  · intro w hw hwc hwcomp
    exact eq_abelianCentralSupport_of_type_i_decomposition M hw hwc hwcomp

end VonNeumannAlgebra
