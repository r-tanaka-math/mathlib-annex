import MathlibAnnex.Analysis.VonNeumannAlgebra.TypeI.CentralPart
import MathlibAnnex.Analysis.VonNeumannAlgebra.Projection.Finite
import MathlibAnnex.Analysis.VonNeumannAlgebra.Projection.CentralSplit

/-!
# Type II and III central components

The central hull of the finite projections is the semifinite part. Internal
polar decomposition transports finite subprojections from a nonzero overlap
back to a given projection. Removing the type I part gives the type II part;
the complement of the semifinite part has no nonzero finite projection.

The predicates are stated on internal corners, with their projection as
unit. Zero components are permitted. The factor-only `IsTypeII1` predicate
from the accepted provider is not modified.
-/

set_option autoImplicit false
noncomputable section

open scoped CStarAlgebra

namespace VonNeumannAlgebra

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H]

/-- Semifiniteness of a corner, expressed by its internal subprojections. -/
def IsSemifiniteProjection (M : VonNeumannAlgebra H) (p : M.toStarSubalgebra) : Prop :=
  IsStarProjection p ∧
    ∀ q : M.toStarSubalgebra, IsStarProjection q → q ≠ 0 → q * p = q →
      ∃ r : M.toStarSubalgebra, IsFiniteProjection r ∧ r ≠ 0 ∧ r * q = r

/-- A type II corner is semifinite and contains no nonzero abelian projection. -/
def IsTypeIIProjection (M : VonNeumannAlgebra H) (p : M.toStarSubalgebra) : Prop :=
  IsSemifiniteProjection M p ∧
    ∀ q : M.toStarSubalgebra, IsAbelianProjection M q → q * p = q → q = 0

/-- A type III corner contains no nonzero finite projection. -/
def IsTypeIIIProjection (M : VonNeumannAlgebra H) (p : M.toStarSubalgebra) : Prop :=
  IsStarProjection p ∧
    ∀ q : M.toStarSubalgebra, IsFiniteProjection q → q * p = q → q = 0

/-- Semifiniteness of the whole algebra, without a factor hypothesis. -/
def IsSemifinite (M : VonNeumannAlgebra H) : Prop := IsSemifiniteProjection M 1

/-- General type II; this is separate from the accepted factor-only II₁ predicate. -/
def IsTypeII (M : VonNeumannAlgebra H) : Prop := IsTypeIIProjection M 1

/-- General type III; the zero algebra is included as an empty component. -/
def IsTypeIII (M : VonNeumannAlgebra H) : Prop := IsTypeIIIProjection M 1

theorem IsAbelianProjection.isFiniteProjection
    {M : VonNeumannAlgebra H} {p : M.toStarSubalgebra}
    (hp : IsAbelianProjection M p) : IsFiniteProjection p :=
  IsFiniteProjection.of_commutative_corner hp.1 hp.2

theorem IsTypeIProjection.isSemifiniteProjection
    {M : VonNeumannAlgebra H} {p : M.toStarSubalgebra}
    (hp : IsTypeIProjection M p) : IsSemifiniteProjection M p := by
  refine ⟨hp.1, ?_⟩
  intro q hq hq0 hqp
  obtain ⟨r, hr, hr0, hrq⟩ := hp.2 q hq hq0 hqp
  exact ⟨r, hr.isFiniteProjection, hr0, hrq⟩

theorem IsSemifiniteProjection.of_mul_eq_left
    {M : VonNeumannAlgebra H} {p q : M.toStarSubalgebra}
    (hp : IsSemifiniteProjection M p) (hq : IsStarProjection q)
    (hqp : q * p = q) : IsSemifiniteProjection M q := by
  refine ⟨hq, ?_⟩
  intro r hr hr0 hrq
  apply hp.2 r hr hr0
  calc
    r * p = (r * q) * p := by rw [hrq]
    _ = r * (q * p) := mul_assoc _ _ _
    _ = r := by rw [hqp, hrq]

theorem IsFinite.isSemifinite {M : VonNeumannAlgebra H} (hM : M.IsFinite) :
    IsSemifinite M := by
  refine ⟨IsStarProjection.one _, ?_⟩
  intro q hq hq0 _
  exact ⟨q, hM.isFiniteProjection hq, hq0, hq.isIdempotentElem.eq⟩

theorem IsTypeI.isSemifinite {M : VonNeumannAlgebra H} (hM : M.IsTypeI) :
    IsSemifinite M :=
  (hM.isTypeIProjection (IsStarProjection.one _)).isSemifiniteProjection

/-- Multiplication by a central projection preserves finiteness because
the result is an internal subprojection. -/
theorem isFiniteProjection_mul_central (M : VonNeumannAlgebra H)
    {p z : M.toStarSubalgebra} (hp : IsFiniteProjection p)
    (hz : IsStarProjection z)
    (hc : ∀ a : M.toStarSubalgebra, a * z = z * a) :
    IsFiniteProjection (p * z) := by
  apply hp.of_mul_eq_left (hp.1.mul hz (hc p))
  calc
    (p * z) * p = p * (z * p) := mul_assoc _ _ _
    _ = p * (p * z) := by rw [← hc p]
    _ = (p * p) * z := (mul_assoc _ _ _).symm
    _ = p * z := by rw [hp.1.isIdempotentElem.eq]

/-- The central projection generated by all finite internal projections. -/
def semifiniteCentralSupport (M : VonNeumannAlgebra H) : M.toStarSubalgebra :=
  centralHull M {p | IsFiniteProjection p}

theorem isStarProjection_semifiniteCentralSupport (M : VonNeumannAlgebra H) :
    IsStarProjection (semifiniteCentralSupport M) :=
  isStarProjection_centralHull M {p | IsFiniteProjection p}

theorem semifiniteCentralSupport_commute (M : VonNeumannAlgebra H)
    (a : M.toStarSubalgebra) :
    a * semifiniteCentralSupport M = semifiniteCentralSupport M * a :=
  centralHull_commute M {p | IsFiniteProjection p} a

theorem mul_semifiniteCentralSupport_of_finite (M : VonNeumannAlgebra H)
    {p : M.toStarSubalgebra} (hp : IsFiniteProjection p) :
    p * semifiniteCentralSupport M = p :=
  mul_centralHull_eq M {p | IsFiniteProjection p} hp

/-- No nonzero finite projection lies in the complementary corner. -/
theorem eq_zero_of_finite_of_mul_semifinite_complement_eq
    (M : VonNeumannAlgebra H) {p : M.toStarSubalgebra}
    (hp : IsFiniteProjection p)
    (hcomp : p * (1 - semifiniteCentralSupport M) = p) : p = 0 := by
  have hzero : p * (1 - semifiniteCentralSupport M) = 0 := by
    rw [mul_sub, mul_one, mul_semifiniteCentralSupport_of_finite M hp, sub_self]
  exact hcomp.symm.trans hzero

/-- The finite central hull is semifinite. Existence of a finite
subprojection is proved by overlap and internal polar decomposition. -/
theorem isSemifiniteProjection_semifiniteCentralSupport
    (M : VonNeumannAlgebra H) : IsSemifiniteProjection M (semifiniteCentralSupport M) := by
  refine ⟨isStarProjection_semifiniteCentralSupport M, ?_⟩
  intro r hr hr0 hrz
  have hoverlap : r * centralHull M {p | IsFiniteProjection p} ≠ 0 := by
    change r * semifiniteCentralSupport M ≠ 0
    rwa [hrz]
  obtain ⟨q, hq, a, hneq⟩ :=
    exists_mul_mul_ne_zero_of_mul_centralHull_ne_zero
      M {p | IsFiniteProjection p} r hoverlap
  let x : M.toStarSubalgebra := r * a * q
  have hx0 : x ≠ 0 := hneq
  have hrx : r * x = x := by
    change r * (r * a * q) = r * a * q
    calc
      r * (r * a * q) = (r * r) * a * q := by simp only [mul_assoc]
      _ = r * a * q := by rw [hr.isIdempotentElem.eq]
  have hxq : x * q = x := by
    change (r * a * q) * q = r * a * q
    rw [mul_assoc, hq.1.isIdempotentElem.eq]
  have hl : leftSupport M x ≤ r := (leftSupport_le_iff M x hr).mpr hrx
  have hs : rightSupport M x ≤ q := (rightSupport_le_iff M x hq.1).mpr hxq
  have hright : IsFiniteProjection (rightSupport M x) :=
    hq.of_mul_eq_left (isStarProjection_rightSupport M x)
      (((isStarProjection_rightSupport M x).le_iff_mul_eq_left hq.1).mp hs)
  have hleft : IsFiniteProjection (leftSupport M x) :=
    isFiniteProjection_of_equivalent M hright (murrayVonNeumannEquivalent_supports M x)
  have hl0 : leftSupport M x ≠ 0 := by
    intro h
    exact hx0 ((leftSupport_eq_zero_iff M x).mp h)
  exact ⟨leftSupport M x, hleft, hl0,
    ((isStarProjection_leftSupport M x).le_iff_mul_eq_left hr).mp hl⟩

/-- Every semifinite projection lies under the finite central hull. -/
theorem IsSemifiniteProjection.mul_semifiniteCentralSupport
    {M : VonNeumannAlgebra H} {p : M.toStarSubalgebra}
    (hp : IsSemifiniteProjection M p) : p * semifiniteCentralSupport M = p := by
  let z : M.toStarSubalgebra := semifiniteCentralSupport M
  have hz : IsStarProjection z := isStarProjection_semifiniteCentralSupport M
  have hc : ∀ a : M.toStarSubalgebra, a * (1 - z) = (1 - z) * a :=
    one_sub_commutes M z (semifiniteCentralSupport_commute M)
  let r : M.toStarSubalgebra := p * (1 - z)
  have hr : IsStarProjection r := hp.1.mul hz.one_sub (hc p)
  have hrp : r * p = r := by
    calc
      r * p = p * ((1 - z) * p) := mul_assoc _ _ _
      _ = p * (p * (1 - z)) := by rw [← hc p]
      _ = (p * p) * (1 - z) := (mul_assoc _ _ _).symm
      _ = r := by rw [hp.1.isIdempotentElem.eq]
  have hrc : r * (1 - z) = r := by
    change (p * (1 - z)) * (1 - z) = p * (1 - z)
    rw [mul_assoc, hz.one_sub.isIdempotentElem.eq]
  have hrzero : r = 0 := by
    by_contra hr0
    obtain ⟨q, hq, hq0, hqr⟩ := hp.2 r hr hr0 hrp
    apply hq0
    apply eq_zero_of_finite_of_mul_semifinite_complement_eq M hq
    change q * (1 - z) = q
    calc
      q * (1 - z) = (q * r) * (1 - z) := by rw [hqr]
      _ = q * (r * (1 - z)) := mul_assoc _ _ _
      _ = q := by rw [hrc, hqr]
  have hsub : p - p * z = 0 := by
    simpa only [r, mul_sub, mul_one] using hrzero
  exact (sub_eq_zero.mp hsub).symm

/-- The type I central part is contained in the semifinite central part. -/
theorem abelianCentralSupport_mul_semifiniteCentralSupport
    (M : VonNeumannAlgebra H) :
    abelianCentralSupport M * semifiniteCentralSupport M = abelianCentralSupport M :=
  (isTypeIProjection_abelianCentralSupport M).isSemifiniteProjection
    |>.mul_semifiniteCentralSupport

/-- The continuous semifinite central component. -/
def typeIIProjection (M : VonNeumannAlgebra H) : M.toStarSubalgebra :=
  semifiniteCentralSupport M - abelianCentralSupport M

/-- The central component without nonzero finite projections. -/
def typeIIIProjection (M : VonNeumannAlgebra H) : M.toStarSubalgebra :=
  1 - semifiniteCentralSupport M

theorem isStarProjection_typeIIProjection (M : VonNeumannAlgebra H) :
    IsStarProjection (typeIIProjection M) :=
  (isStarProjection_abelianCentralSupport M).sub_of_mul_eq_left
    (isStarProjection_semifiniteCentralSupport M)
    (abelianCentralSupport_mul_semifiniteCentralSupport M)

theorem isStarProjection_typeIIIProjection (M : VonNeumannAlgebra H) :
    IsStarProjection (typeIIIProjection M) :=
  (isStarProjection_semifiniteCentralSupport M).one_sub

theorem typeIIProjection_commute (M : VonNeumannAlgebra H)
    (a : M.toStarSubalgebra) : a * typeIIProjection M = typeIIProjection M * a := by
  simp only [typeIIProjection, mul_sub, sub_mul,
    semifiniteCentralSupport_commute M a, abelianCentralSupport_commute M a]

theorem typeIIIProjection_commute (M : VonNeumannAlgebra H)
    (a : M.toStarSubalgebra) : a * typeIIIProjection M = typeIIIProjection M * a :=
  one_sub_commutes M (semifiniteCentralSupport M) (semifiniteCentralSupport_commute M) a

theorem typeIIProjection_mul_semifiniteCentralSupport (M : VonNeumannAlgebra H) :
    typeIIProjection M * semifiniteCentralSupport M = typeIIProjection M := by
  rw [typeIIProjection, sub_mul,
    (isStarProjection_semifiniteCentralSupport M).isIdempotentElem.eq,
    abelianCentralSupport_mul_semifiniteCentralSupport]

theorem typeIIProjection_mul_abelian_complement (M : VonNeumannAlgebra H) :
    typeIIProjection M * (1 - abelianCentralSupport M) = typeIIProjection M := by
  have hfi : semifiniteCentralSupport M * abelianCentralSupport M =
      abelianCentralSupport M := by
    rw [abelianCentralSupport_commute M (semifiniteCentralSupport M),
      abelianCentralSupport_mul_semifiniteCentralSupport]
  rw [mul_sub, mul_one, typeIIProjection, sub_mul, hfi,
    (isStarProjection_abelianCentralSupport M).isIdempotentElem.eq, sub_self, sub_zero]

/-- The middle component has the general type II projection property. -/
theorem isTypeIIProjection_typeIIProjection (M : VonNeumannAlgebra H) :
    IsTypeIIProjection M (typeIIProjection M) := by
  refine ⟨(isSemifiniteProjection_semifiniteCentralSupport M).of_mul_eq_left
    (isStarProjection_typeIIProjection M) (typeIIProjection_mul_semifiniteCentralSupport M), ?_⟩
  intro p hp hpii
  apply eq_zero_of_abelian_of_mul_complement_eq hp
  calc
    p * (1 - abelianCentralSupport M) =
        (p * typeIIProjection M) * (1 - abelianCentralSupport M) := by rw [hpii]
    _ = p * (typeIIProjection M * (1 - abelianCentralSupport M)) := mul_assoc _ _ _
    _ = p := by rw [typeIIProjection_mul_abelian_complement, hpii]

/-- The remaining component has no nonzero finite projection. -/
theorem isTypeIIIProjection_typeIIIProjection (M : VonNeumannAlgebra H) :
    IsTypeIIIProjection M (typeIIIProjection M) := by
  refine ⟨isStarProjection_typeIIIProjection M, ?_⟩
  intro p hp hpcomp
  exact eq_zero_of_finite_of_mul_semifinite_complement_eq M hp hpcomp

/-- Every type II projection lies in the canonical type II central part. -/
theorem IsTypeIIProjection.mul_typeIIProjection
    {M : VonNeumannAlgebra H} {p : M.toStarSubalgebra}
    (hp : IsTypeIIProjection M p) : p * typeIIProjection M = p := by
  have hpf := hp.1.mul_semifiniteCentralSupport
  let z : M.toStarSubalgebra := abelianCentralSupport M
  have hz : IsTypeIProjection M z := isTypeIProjection_abelianCentralSupport M
  have hc : p * z = z * p := abelianCentralSupport_commute M p
  let r : M.toStarSubalgebra := p * z
  have hr : IsStarProjection r := hp.1.1.mul hz.1 hc
  have hrp : r * p = r := by
    calc
      r * p = p * (z * p) := mul_assoc _ _ _
      _ = p * (p * z) := by rw [← hc]
      _ = (p * p) * z := (mul_assoc _ _ _).symm
      _ = r := by rw [hp.1.1.isIdempotentElem.eq]
  have hrz : r * z = r := by
    change (p * z) * z = p * z
    rw [mul_assoc, hz.1.isIdempotentElem.eq]
  have hrzero : r = 0 := by
    by_contra hr0
    obtain ⟨q, hq, hq0, hqr⟩ := hz.2 r hr hr0 hrz
    apply hq0
    apply hp.2 q hq
    calc
      q * p = (q * r) * p := by rw [hqr]
      _ = q * (r * p) := mul_assoc _ _ _
      _ = q := by rw [hrp, hqr]
  change p * (semifiniteCentralSupport M - abelianCentralSupport M) = p
  rw [mul_sub, hpf, show p * abelianCentralSupport M = 0 from hrzero, sub_zero]

/-- Every type III projection lies in the canonical type III central part. -/
theorem IsTypeIIIProjection.mul_typeIIIProjection
    {M : VonNeumannAlgebra H} {p : M.toStarSubalgebra}
    (hp : IsTypeIIIProjection M p) : p * typeIIIProjection M = p := by
  let z : M.toStarSubalgebra := semifiniteCentralSupport M
  have hz : IsSemifiniteProjection M z := isSemifiniteProjection_semifiniteCentralSupport M
  have hc : p * z = z * p := semifiniteCentralSupport_commute M p
  let r : M.toStarSubalgebra := p * z
  have hr : IsStarProjection r := hp.1.mul hz.1 hc
  have hrp : r * p = r := by
    calc
      r * p = p * (z * p) := mul_assoc _ _ _
      _ = p * (p * z) := by rw [← hc]
      _ = (p * p) * z := (mul_assoc _ _ _).symm
      _ = r := by rw [hp.1.isIdempotentElem.eq]
  have hrz : r * z = r := by
    change (p * z) * z = p * z
    rw [mul_assoc, hz.1.isIdempotentElem.eq]
  have hrzero : r = 0 := by
    by_contra hr0
    obtain ⟨q, hq, hq0, hqr⟩ := hz.2 r hr hr0 hrz
    apply hq0
    apply hp.2 q hq
    calc
      q * p = (q * r) * p := by rw [hqr]
      _ = q * (r * p) := mul_assoc _ _ _
      _ = q := by rw [hrp, hqr]
  change p * (1 - semifiniteCentralSupport M) = p
  rw [mul_sub, mul_one, show p * semifiniteCentralSupport M = 0 from hrzero, sub_zero]

/-- Pairwise orthogonality of the three canonical central projections. -/
theorem type_projections_orthogonal (M : VonNeumannAlgebra H) :
    abelianCentralSupport M * typeIIProjection M = 0 ∧
      abelianCentralSupport M * typeIIIProjection M = 0 ∧
      typeIIProjection M * typeIIIProjection M = 0 := by
  have hi := isStarProjection_abelianCentralSupport M
  have hf := isStarProjection_semifiniteCentralSupport M
  have hif := abelianCentralSupport_mul_semifiniteCentralSupport M
  refine ⟨?_, ?_, ?_⟩
  · change abelianCentralSupport M *
      (semifiniteCentralSupport M - abelianCentralSupport M) = 0
    rw [mul_sub, hif, hi.isIdempotentElem.eq, sub_self]
  · change abelianCentralSupport M * (1 - semifiniteCentralSupport M) = 0
    rw [mul_sub, mul_one, hif, sub_self]
  · change (semifiniteCentralSupport M - abelianCentralSupport M) *
      (1 - semifiniteCentralSupport M) = 0
    rw [mul_sub, mul_one, sub_mul, hf.isIdempotentElem.eq, hif, sub_self]

/-- The three central components exhaust the unit, including zero components. -/
theorem type_projections_sum (M : VonNeumannAlgebra H) :
    abelianCentralSupport M + typeIIProjection M + typeIIIProjection M = 1 := by
  change abelianCentralSupport M +
    (semifiniteCentralSupport M - abelianCentralSupport M) +
    (1 - semifiniteCentralSupport M) = 1
  rw [add_comm (abelianCentralSupport M)
      (semifiniteCentralSupport M - abelianCentralSupport M),
    sub_add_cancel, add_comm (semifiniteCentralSupport M) (1 - semifiniteCentralSupport M),
    sub_add_cancel]

private theorem mul_zero_of_projection_below (M : VonNeumannAlgebra H)
    {a b q : M.toStarSubalgebra} (hb : IsStarProjection b) (hq : IsStarProjection q)
    (hab : a * b = 0) (hqb : q * b = q) : a * q = 0 := by
  have hbq : b * q = q := by
    simpa only [star_mul, hb.isSelfAdjoint.star_eq, hq.isSelfAdjoint.star_eq]
      using congrArg star hqb
  calc
    a * q = a * (b * q) := by rw [hbq]
    _ = (a * b) * q := (mul_assoc _ _ _).symm
    _ = 0 := by rw [hab, zero_mul]

/-- Uniqueness only requires the three type conditions and sum one.
Centrality and pairwise orthogonality then follow from the canonical components. -/
theorem type_decomposition_unique (M : VonNeumannAlgebra H)
    {p q r : M.toStarSubalgebra}
    (hp : IsTypeIProjection M p) (hq : IsTypeIIProjection M q)
    (hr : IsTypeIIIProjection M r) (hsum : p + q + r = 1) :
    p = abelianCentralSupport M ∧ q = typeIIProjection M ∧ r = typeIIIProjection M := by
  let e := abelianCentralSupport M
  let f := typeIIProjection M
  let g := typeIIIProjection M
  have he : IsStarProjection e := isStarProjection_abelianCentralSupport M
  have hf : IsStarProjection f := isStarProjection_typeIIProjection M
  have hg : IsStarProjection g := isStarProjection_typeIIIProjection M
  have hpe : p * e = p := hp.mul_abelianCentralSupport
  have hqf : q * f = q := hq.mul_typeIIProjection
  have hrg : r * g = r := hr.mul_typeIIIProjection
  have hep : e * p = p := by
    simpa only [star_mul, he.isSelfAdjoint.star_eq, hp.1.isSelfAdjoint.star_eq]
      using congrArg star hpe
  have hfq : f * q = q := by
    simpa only [star_mul, hf.isSelfAdjoint.star_eq, hq.1.1.isSelfAdjoint.star_eq]
      using congrArg star hqf
  have hgr : g * r = r := by
    simpa only [star_mul, hg.isSelfAdjoint.star_eq, hr.1.isSelfAdjoint.star_eq]
      using congrArg star hrg
  obtain ⟨hef, heg, hfg⟩ := type_projections_orthogonal M
  change e * f = 0 at hef
  change e * g = 0 at heg
  change f * g = 0 at hfg
  have hfe : f * e = 0 := by
    simpa only [star_mul, he.isSelfAdjoint.star_eq, hf.isSelfAdjoint.star_eq, star_zero]
      using congrArg star hef
  have hge : g * e = 0 := by
    simpa only [star_mul, he.isSelfAdjoint.star_eq, hg.isSelfAdjoint.star_eq, star_zero]
      using congrArg star heg
  have hgf : g * f = 0 := by
    simpa only [star_mul, hf.isSelfAdjoint.star_eq, hg.isSelfAdjoint.star_eq, star_zero]
      using congrArg star hfg
  have heq : e * q = 0 := mul_zero_of_projection_below M hf hq.1.1 hef hqf
  have her : e * r = 0 := mul_zero_of_projection_below M hg hr.1 heg hrg
  have hfp : f * p = 0 := mul_zero_of_projection_below M he hp.1 hfe hpe
  have hfr : f * r = 0 := mul_zero_of_projection_below M hg hr.1 hfg hrg
  have hgp : g * p = 0 := mul_zero_of_projection_below M he hp.1 hge hpe
  have hgq : g * q = 0 := mul_zero_of_projection_below M hf hq.1.1 hgf hqf
  refine ⟨?_, ?_, ?_⟩
  · have h : e * (p + q + r) = e := by rw [hsum, mul_one]
    simpa only [mul_add, hep, heq, her, add_zero] using h
  · have h : f * (p + q + r) = f := by rw [hsum, mul_one]
    simpa only [mul_add, hfp, hfq, hfr, zero_add, add_zero] using h
  · have h : g * (p + q + r) = g := by rw [hsum, mul_one]
    simpa only [mul_add, hgp, hgq, hgr, zero_add] using h

/-- Existence, orthogonality, maximality and uniqueness of the general
type I/II/III central decomposition, stated on internal corners. -/
theorem exists_type_decomposition (M : VonNeumannAlgebra H) :
    ∃ p q r : M.toStarSubalgebra,
      IsTypeIProjection M p ∧ IsTypeIIProjection M q ∧ IsTypeIIIProjection M r ∧
      (∀ a : M.toStarSubalgebra, a * p = p * a ∧ a * q = q * a ∧ a * r = r * a) ∧
      p * q = 0 ∧ p * r = 0 ∧ q * r = 0 ∧ p + q + r = 1 ∧
      (∀ s : M.toStarSubalgebra, IsTypeIProjection M s → s * p = s) ∧
      (∀ s : M.toStarSubalgebra, IsTypeIIProjection M s → s * q = s) ∧
      (∀ s : M.toStarSubalgebra, IsTypeIIIProjection M s → s * r = s) ∧
      ∀ p' q' r' : M.toStarSubalgebra,
        IsTypeIProjection M p' → IsTypeIIProjection M q' → IsTypeIIIProjection M r' →
        p' + q' + r' = 1 → p' = p ∧ q' = q ∧ r' = r := by
  obtain ⟨horthI, horthII, horthIII⟩ := type_projections_orthogonal M
  refine ⟨abelianCentralSupport M, typeIIProjection M, typeIIIProjection M,
    isTypeIProjection_abelianCentralSupport M, isTypeIIProjection_typeIIProjection M,
    isTypeIIIProjection_typeIIIProjection M, ?_, horthI, horthII, horthIII,
    type_projections_sum M, ?_, ?_, ?_, ?_⟩
  · intro a
    exact ⟨abelianCentralSupport_commute M a,
      typeIIProjection_commute M a, typeIIIProjection_commute M a⟩
  · intro s hs
    exact hs.mul_abelianCentralSupport
  · intro s hs
    exact hs.mul_typeIIProjection
  · intro s hs
    exact hs.mul_typeIIIProjection
  · intro p q r hp hq hr hsum
    exact type_decomposition_unique M hp hq hr hsum

/-- The actual star-algebra product equivalence for the canonical type
I/II/III components. The factors are the internal corners with their
distinguished projection units. -/
def typeDecompositionEquiv (M : VonNeumannAlgebra H) :
    M.toStarSubalgebra ≃⋆ₐ[ℂ]
      (corner M (abelianCentralSupport M) (isStarProjection_abelianCentralSupport M) ×
       corner M (typeIIProjection M) (isStarProjection_typeIIProjection M) ×
       corner M (typeIIIProjection M) (isStarProjection_typeIIIProjection M)) :=
  centralCornerTripleEquiv M (abelianCentralSupport M) (typeIIProjection M) (typeIIIProjection M)
    (isStarProjection_abelianCentralSupport M) (isStarProjection_typeIIProjection M)
    (isStarProjection_typeIIIProjection M) (abelianCentralSupport_commute M)
    (typeIIProjection_commute M) (typeIIIProjection_commute M)
    (type_projections_orthogonal M).1 (type_projections_orthogonal M).2.1
    (type_projections_orthogonal M).2.2 (type_projections_sum M)

/-- The component maps are multiplication by the three central projections. -/
theorem typeDecompositionEquiv_apply (M : VonNeumannAlgebra H)
    (a : M.toStarSubalgebra) :
    ((typeDecompositionEquiv M a).1 : M.toStarSubalgebra) = abelianCentralSupport M * a ∧
    ((typeDecompositionEquiv M a).2.1 : M.toStarSubalgebra) = typeIIProjection M * a ∧
    ((typeDecompositionEquiv M a).2.2 : M.toStarSubalgebra) = typeIIIProjection M * a :=
  ⟨rfl, rfl, rfl⟩

/-- Addition is the inverse; the three components reconstruct the original element. -/
theorem typeDecompositionEquiv_symm_apply (M : VonNeumannAlgebra H)
    (a : corner M (abelianCentralSupport M) (isStarProjection_abelianCentralSupport M) ×
       corner M (typeIIProjection M) (isStarProjection_typeIIProjection M) ×
       corner M (typeIIIProjection M) (isStarProjection_typeIIIProjection M)) :
    (typeDecompositionEquiv M).symm a =
      (a.1 : M.toStarSubalgebra) + (a.2.1 : M.toStarSubalgebra) +
        (a.2.2 : M.toStarSubalgebra) := rfl

theorem isometry_typeDecompositionEquiv (M : VonNeumannAlgebra H) :
    Isometry (typeDecompositionEquiv M) :=
  isometry_centralCornerTripleEquiv M
    (abelianCentralSupport M) (typeIIProjection M) (typeIIIProjection M)
    (isStarProjection_abelianCentralSupport M) (isStarProjection_typeIIProjection M)
    (isStarProjection_typeIIIProjection M) (abelianCentralSupport_commute M)
    (typeIIProjection_commute M) (typeIIIProjection_commute M)
    (type_projections_orthogonal M).1 (type_projections_orthogonal M).2.1
    (type_projections_orthogonal M).2.2 (type_projections_sum M)

/-- The product identity is the tuple of the three central projections. -/
theorem typeDecompositionEquiv_one (M : VonNeumannAlgebra H) :
    typeDecompositionEquiv M 1 =
      (cornerUnit M (abelianCentralSupport M) (isStarProjection_abelianCentralSupport M),
       cornerUnit M (typeIIProjection M) (isStarProjection_typeIIProjection M),
       cornerUnit M (typeIIIProjection M) (isStarProjection_typeIIIProjection M)) :=
  centralCornerTripleEquiv_one M
    (abelianCentralSupport M) (typeIIProjection M) (typeIIIProjection M)
    (isStarProjection_abelianCentralSupport M) (isStarProjection_typeIIProjection M)
    (isStarProjection_typeIIIProjection M) (abelianCentralSupport_commute M)
    (typeIIProjection_commute M) (typeIIIProjection_commute M)
    (type_projections_orthogonal M).1 (type_projections_orthogonal M).2.1
    (type_projections_orthogonal M).2.2 (type_projections_sum M)

theorem IsSemifinite.semifiniteCentralSupport_eq_one
    {M : VonNeumannAlgebra H} (hM : IsSemifinite M) :
    semifiniteCentralSupport M = 1 := by
  have h := hM.mul_semifiniteCentralSupport
  simpa only [one_mul] using h

theorem IsTypeI.typeIIProjection_eq_zero
    {M : VonNeumannAlgebra H} (hM : IsTypeI M) : typeIIProjection M = 0 := by
  rw [typeIIProjection, hM.isSemifinite.semifiniteCentralSupport_eq_one,
    hM.abelianCentralSupport_eq_one, sub_self]

theorem IsSemifinite.typeIIIProjection_eq_zero
    {M : VonNeumannAlgebra H} (hM : IsSemifinite M) : typeIIIProjection M = 0 := by
  rw [typeIIIProjection, hM.semifiniteCentralSupport_eq_one, sub_self]

theorem IsTypeII.abelianCentralSupport_eq_zero
    {M : VonNeumannAlgebra H} (hM : IsTypeII M) : abelianCentralSupport M = 0 := by
  apply (abelianCentralSupport_eq_zero_iff M).2
  intro p hp
  exact hM.2 p hp (mul_one p)

theorem IsTypeII.typeIIProjection_eq_one
    {M : VonNeumannAlgebra H} (hM : IsTypeII M) : typeIIProjection M = 1 := by
  have hsf : IsSemifinite M := hM.1
  rw [typeIIProjection, hsf.semifiniteCentralSupport_eq_one,
    hM.abelianCentralSupport_eq_zero, sub_zero]

theorem IsTypeIII.semifiniteCentralSupport_eq_zero
    {M : VonNeumannAlgebra H} (hM : IsTypeIII M) : semifiniteCentralSupport M = 0 := by
  have hle : semifiniteCentralSupport M * 0 = semifiniteCentralSupport M := by
    apply centralHull_le M {p | IsFiniteProjection p} (IsStarProjection.zero _)
    · intro a
      simp only [mul_zero, zero_mul]
    · intro p hp
      rw [hM.2 p hp (mul_one p), zero_mul]
  simpa only [mul_zero] using hle.symm

theorem IsTypeIII.typeIIIProjection_eq_one
    {M : VonNeumannAlgebra H} (hM : IsTypeIII M) : typeIIIProjection M = 1 := by
  rw [typeIIIProjection, hM.semifiniteCentralSupport_eq_zero, sub_zero]

end VonNeumannAlgebra
