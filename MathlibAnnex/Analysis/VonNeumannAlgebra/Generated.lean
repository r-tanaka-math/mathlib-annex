import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
import Mathlib.Analysis.VonNeumannAlgebra.Basic
import MathlibAnnex.Analysis.VonNeumannAlgebra.Commutant

/-!
# The concrete von Neumann algebra generated by a star subalgebra

For a unital star subalgebra `S` of the bounded operators on a complex Hilbert
space, `generated S` has carrier exactly `S''`. The algebraic construction uses
`StarSubalgebra.centralizer`; its star-closure does not enlarge `S`.

Every concrete von Neumann algebra is closed in the weak and strong operator
topologies and in operator norm. Its underlying star subalgebra therefore
inherits its C*-algebra and completeness instances from Mathlib's standard
closed-star-subalgebra instance.
-/

set_option autoImplicit false

open Filter Topology
open scoped Pointwise

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The concrete von Neumann algebra generated by a unital star subalgebra. -/
noncomputable def generated (S : StarSubalgebra ℂ (H →L[ℂ] H)) : VonNeumannAlgebra H where
  toStarSubalgebra :=
    (StarSubalgebra.centralizer ℂ
      (StarSubalgebra.centralizer ℂ (S : Set (H →L[ℂ] H)) : Set (H →L[ℂ] H))).copy
      (Set.centralizer (Set.centralizer (S : Set (H →L[ℂ] H)))) (by
        rw [StarSubalgebra.coe_centralizer_centralizer,
          StarMemClass.star_coe_eq, Set.union_self])
  centralizer_centralizer' := by
    change Set.centralizer (Set.centralizer
      (Set.centralizer (Set.centralizer (S : Set (H →L[ℂ] H))))) =
        Set.centralizer (Set.centralizer (S : Set (H →L[ℂ] H)))
    simp only [Set.centralizer_centralizer_centralizer]

/-- The carrier is the algebraic double centralizer of the original set. -/
@[simp]
theorem coe_generated (S : StarSubalgebra ℂ (H →L[ℂ] H)) :
    (generated S : Set (H →L[ℂ] H)) =
      Set.centralizer (Set.centralizer (S : Set (H →L[ℂ] H))) :=
  rfl

/-- Membership in the generated algebra is membership in the double commutant. -/
theorem mem_generated_iff (S : StarSubalgebra ℂ (H →L[ℂ] H)) (T : H →L[ℂ] H) :
    T ∈ generated S ↔ T ∈ Set.centralizer (Set.centralizer (S : Set (H →L[ℂ] H))) :=
  Iff.rfl

/-- A star subalgebra is contained in the concrete von Neumann algebra it generates. -/
theorem subset_generated (S : StarSubalgebra ℂ (H →L[ℂ] H)) :
    (S : Set (H →L[ℂ] H)) ⊆ (generated S : Set (H →L[ℂ] H)) :=
  Set.subset_centralizer_centralizer

/-- The generated algebra is the least concrete von Neumann algebra containing the source. -/
theorem generated_le (S : StarSubalgebra ℂ (H →L[ℂ] H)) (M : VonNeumannAlgebra H)
    (h : S ≤ M.toStarSubalgebra) : generated S ≤ M := by
  intro T hT
  change T ∈ (M : Set (H →L[ℂ] H))
  rw [← M.centralizer_centralizer]
  exact Set.centralizer_subset (Set.centralizer_subset h) hT

/-- Generation is monotone in the source star subalgebra. -/
theorem generated_mono {S T : StarSubalgebra ℂ (H →L[ℂ] H)} (h : S ≤ T) :
    generated S ≤ generated T :=
  generated_le S (generated T) fun x hx ↦ subset_generated T (h hx)

/-- A concrete von Neumann algebra is fixed by generation. This also gives idempotence. -/
@[simp]
theorem generated_toStarSubalgebra (M : VonNeumannAlgebra H) :
    generated M.toStarSubalgebra = M := by
  apply le_antisymm
  · exact generated_le M.toStarSubalgebra M le_rfl
  · exact subset_generated M.toStarSubalgebra

/-- Every concrete von Neumann algebra is closed in operator norm. -/
theorem isClosed (M : VonNeumannAlgebra H) : IsClosed (M : Set (H →L[ℂ] H)) := by
  rw [← M.centralizer_centralizer]
  exact Set.isClosed_centralizer _

/-- Supply closedness to Mathlib's existing C*-algebra instance for star subalgebras. -/
instance instIsClosedToStarSubalgebra (M : VonNeumannAlgebra H) :
    IsClosed (M.toStarSubalgebra : Set (H →L[ℂ] H)) :=
  M.isClosed

/-- Every concrete von Neumann algebra is weak-operator closed in the standard type copy. -/
theorem isClosed_wot (M : VonNeumannAlgebra H) :
    IsClosed (ContinuousLinearMapWOT.ofCLM '' (M : Set (H →L[ℂ] H))) := by
  rw [← M.centralizer_centralizer]
  exact ContinuousLinearMapWOT.isClosed_image_centralizer _

/-- Every concrete von Neumann algebra is strong-operator closed in the standard type copy. -/
theorem isClosed_sot (M : VonNeumannAlgebra H) :
    IsClosed ((ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ) H H) ''
      (M : Set (H →L[ℂ] H))) := by
  rw [← M.centralizer_centralizer]
  exact PointwiseConvergenceCLM.isClosed_image_centralizer _

/-- A weak operator limit along a nontrivial filter remains in the algebra. -/
theorem mem_of_tendsto_wot (M : VonNeumannAlgebra H)
    {ι : Type*} {l : Filter ι} [l.NeBot] {f : ι → H →L[ℂ] H} {T : H →L[ℂ] H}
    (hf : ∀ i, f i ∈ M)
    (hT : Tendsto (fun i ↦ ContinuousLinearMapWOT.ofCLM (f i)) l
      (𝓝 (ContinuousLinearMapWOT.ofCLM T))) : T ∈ M := by
  have hmem : ContinuousLinearMapWOT.ofCLM T ∈
      ContinuousLinearMapWOT.ofCLM '' (M : Set (H →L[ℂ] H)) :=
    M.isClosed_wot.mem_of_tendsto hT
      (Filter.Eventually.of_forall fun i ↦ ⟨f i, hf i, rfl⟩)
  rcases hmem with ⟨Q, hQ, hQT⟩
  have hQT' : Q = T := ContinuousLinearMapWOT.ofCLM_injective hQT
  exact hQT' ▸ hQ

/-- A strong operator limit along a nontrivial filter remains in the algebra. -/
theorem mem_of_stronglyConverges (M : VonNeumannAlgebra H)
    {ι : Type*} {l : Filter ι} [l.NeBot] {f : ι → H →L[ℂ] H} {T : H →L[ℂ] H}
    (hf : ∀ i, f i ∈ M) (hT : ContinuousLinearMap.StronglyConverges f l T) : T ∈ M :=
  M.mem_of_tendsto_wot hf hT.tendsto_wot

end VonNeumannAlgebra
