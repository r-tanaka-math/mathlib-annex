module

public import MathlibAnnex.Analysis.Normed.GeometricStructure.SmoothKernel
public import MathlibAnnex.Analysis.Normed.Module.DualKernelGeometry
public import MathlibAnnex.Analysis.Normed.GeometricStructure.Spectrum
public import MathlibAnnex.Analysis.Normed.GeometricStructure.Separation

/-!
# The spectra of a reflexive smooth normed space

Every distinct pair of geometric-structure points has a third point in its
hull-kernel closure, using the sum of two nonzero continuous functionals. Thus
all points lie in one component. This is different from saying that every
component is a singleton. For a nontrivial space the geometric spectrum is the
singleton whose member is the whole geometric structure space, and the
primitive spectrum is the singleton whose member is `{0}`.

Smoothness and analytic reflexivity are expanded using the existing norming-set
and canonical double-continuous-dual maps. Dimension at least two is not needed
for these singleton conclusions; the non-topologizability conclusion of
Example 4.10 is a separate assertion.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

open Set

universe u v

namespace NormedSpace

variable (𝕜 : Type v) [RCLike 𝕜]
variable {E : Type u} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
variable (hsmooth : ∀ x : E, x ≠ 0 → (normingFunctionals 𝕜 x).Subsingleton)
variable (hreflexive : Function.Surjective (inclusionInDoubleDual 𝕜 E))
include hsmooth hreflexive

/-- A distinct pair of actual geometric-structure points is not closed.
The witness is the kernel of the sum of representing functionals. -/
theorem not_isClosed_pair_geometricStructureClosure_of_smooth_of_reflexive
    {I J : GeometricStructureSpace 𝕜 E} (hIJ : I ≠ J) :
    ¬ (geometricStructureClosure 𝕜 E).IsClosed {I, J} := by
  obtain ⟨f, hf, hfI⟩ :=
    (mem_geometricStructureFamily_iff_exists_ne_zero_dual_of_smooth_of_reflexive
      𝕜 hsmooth hreflexive I.val).1 I.property
  obtain ⟨g, hg, hgJ⟩ :=
    (mem_geometricStructureFamily_iff_exists_ne_zero_dual_of_smooth_of_reflexive
      𝕜 hsmooth hreflexive J.val).1 J.property
  have hfg : (f : E → 𝕜) ⁻¹' {0} ≠ (g : E → 𝕜) ⁻¹' {0} := by
    intro heq
    apply hIJ
    apply Subtype.ext
    exact hfI.symm.trans (heq.trans hgJ)
  obtain ⟨hadd, hleft, hright, hinter⟩ :=
    add_dual_ne_zero_and_preimage_zero_ne_of_preimage_zero_ne hf hg hfg
  let K : GeometricStructureSpace 𝕜 E :=
    ⟨((f + g : StrongDual 𝕜 E) : E → 𝕜) ⁻¹' {0},
      preimage_zero_mem_geometricStructureFamily_of_smooth_of_surjective_inclusionInDoubleDual
        𝕜 hsmooth hreflexive hadd⟩
  have hKI : K ≠ I := by
    intro heq
    exact hleft ((congrArg Subtype.val heq).trans hfI.symm)
  have hKJ : K ≠ J := by
    intro heq
    exact hright ((congrArg Subtype.val heq).trans hgJ.symm)
  have hKclosure : K ∈ (geometricStructureClosure 𝕜 E).closure {I, J} := by
    change ∀ x : E, (∀ L : GeometricStructureSpace 𝕜 E, L ∈ ({I, J} : Set _) →
      x ∈ L.val) → x ∈ K.val
    intro x hx
    apply hinter
    constructor
    · rw [hfI]
      exact hx I (by simp)
    · rw [hgJ]
      exact hx J (by simp)
  intro hclosed
  have hclosure := ((geometricStructureClosure 𝕜 E).isClosed_iff {I, J}).1 hclosed
  rw [hclosure] at hKclosure
  have hor : K = I ∨ K = J := by simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hKclosure
  exact hor.elim hKI hKJ

/-- Every two geometric-structure points are linked in a reflexive smooth space. -/
theorem linked_geometricStructureClosure_of_smooth_of_reflexive
    (I J : GeometricStructureSpace 𝕜 E) : (geometricStructureClosure 𝕜 E).Linked I J := by
  classical
  by_cases hIJ : I = J
  · exact Or.inl hIJ
  · exact Or.inr
      (not_isClosed_pair_geometricStructureClosure_of_smooth_of_reflexive
        𝕜 hsmooth hreflexive hIJ)

/-- Consequently the relation generated by links is universal, not equality. -/
theorem related_geometricStructureClosure_of_smooth_of_reflexive
    (I J : GeometricStructureSpace 𝕜 E) : (geometricStructureClosure 𝕜 E).Related I J :=
  (geometricStructureClosure 𝕜 E).related_of_linked
    (linked_geometricStructureClosure_of_smooth_of_reflexive 𝕜 hsmooth hreflexive I J)

/-- Each existing component is the whole geometric structure space. -/
theorem component_geometricStructureClosure_eq_univ_of_smooth_of_reflexive
    (I : GeometricStructureSpace 𝕜 E) :
    (geometricStructureClosure 𝕜 E).component I = Set.univ := by
  apply Set.eq_univ_iff_forall.2
  intro J
  exact related_geometricStructureClosure_of_smooth_of_reflexive 𝕜 hsmooth hreflexive I J

/-- The carrier of each concrete geometric-spectrum point is the full GSS. -/
theorem geometricSpectrum_val_eq_univ_of_smooth_of_reflexive
    (C : GeometricSpectrum 𝕜 E) : C.val = Set.univ := by
  obtain ⟨I, rfl⟩ := toGeometricSpectrum_surjective 𝕜 E C
  exact component_geometricStructureClosure_eq_univ_of_smooth_of_reflexive
    𝕜 hsmooth hreflexive I

/-- Its component intersection is exactly zero, by the existing full-family separation theorem. -/
theorem geometricSpectrumKernel_eq_singleton_zero_of_smooth_of_reflexive
    (C : GeometricSpectrum 𝕜 E) : geometricSpectrumKernel 𝕜 E C = {0} := by
  change ClosureSpace.HullKernel.kernel (geometricStructureFamily 𝕜 E) C.val = _
  rw [geometricSpectrum_val_eq_univ_of_smooth_of_reflexive 𝕜 hsmooth hreflexive]
  exact kernel_geometricStructureFamily_univ 𝕜 E

/-- Every primitive geometric point is the subset `{0}` of the original space. -/
theorem primitiveGeometricSpectrum_val_eq_singleton_zero_of_smooth_of_reflexive
    (J : PrimitiveGeometricSpectrum 𝕜 E) : J.val = {0} := by
  obtain ⟨C, rfl⟩ := geometricSpectrumToPrimitive_surjective 𝕜 E J
  exact geometricSpectrumKernel_eq_singleton_zero_of_smooth_of_reflexive 𝕜 hsmooth hreflexive C

/-- At most one geometric-spectrum point exists; in the zero space none exists. -/
theorem subsingleton_geometricSpectrum_of_smooth_of_reflexive :
    Subsingleton (GeometricSpectrum 𝕜 E) := by
  refine ⟨fun C D => Subtype.ext ?_⟩
  exact (geometricSpectrum_val_eq_univ_of_smooth_of_reflexive 𝕜 hsmooth hreflexive C).trans
    (geometricSpectrum_val_eq_univ_of_smooth_of_reflexive 𝕜 hsmooth hreflexive D).symm

/-- At most one primitive-spectrum point exists, without assuming nontriviality. -/
theorem subsingleton_primitiveGeometricSpectrum_of_smooth_of_reflexive :
    Subsingleton (PrimitiveGeometricSpectrum 𝕜 E) := by
  refine ⟨fun C D => Subtype.ext ?_⟩
  exact (primitiveGeometricSpectrum_val_eq_singleton_zero_of_smooth_of_reflexive
    𝕜 hsmooth hreflexive C).trans
      (primitiveGeometricSpectrum_val_eq_singleton_zero_of_smooth_of_reflexive
        𝕜 hsmooth hreflexive D).symm

/-- The geometric closure is the singleton-space closure (also valid on the empty spectrum). -/
theorem geometricSpectrumClosure_closure_eq_of_smooth_of_reflexive
    (S : Set (GeometricSpectrum 𝕜 E)) : (geometricSpectrumClosure 𝕜 E).closure S = S := by
  classical
  letI : Subsingleton (GeometricSpectrum 𝕜 E) :=
    subsingleton_geometricSpectrum_of_smooth_of_reflexive 𝕜 hsmooth hreflexive
  apply Set.Subset.antisymm ?_ ((geometricSpectrumClosure 𝕜 E).subset_closure S)
  intro x hx
  by_cases hS : S.Nonempty
  · obtain ⟨y, hy⟩ := hS
    exact (Subsingleton.elim y x) ▸ hy
  · have hSempty : S = ∅ := Set.eq_empty_iff_forall_notMem.2 (fun y hy => hS ⟨y, hy⟩)
    rw [hSempty, ClosureSpace.closure_empty] at hx
    exact hx.elim

/-- The primitive closure likewise agrees with the closure of a singleton topological space. -/
theorem primitiveGeometricSpectrumClosure_closure_eq_of_smooth_of_reflexive
    (S : Set (PrimitiveGeometricSpectrum 𝕜 E)) :
    (primitiveGeometricSpectrumClosure 𝕜 E).closure S = S := by
  classical
  letI : Subsingleton (PrimitiveGeometricSpectrum 𝕜 E) :=
    subsingleton_primitiveGeometricSpectrum_of_smooth_of_reflexive 𝕜 hsmooth hreflexive
  apply Set.Subset.antisymm ?_ ((primitiveGeometricSpectrumClosure 𝕜 E).subset_closure S)
  intro x hx
  by_cases hS : S.Nonempty
  · obtain ⟨y, hy⟩ := hS
    exact (Subsingleton.elim y x) ▸ hy
  · have hSempty : S = ∅ := Set.eq_empty_iff_forall_notMem.2 (fun y hy => hS ⟨y, hy⟩)
    rw [hSempty, ClosureSpace.closure_empty] at hx
    exact hx.elim

/-- Topologizability here follows from the computed closure, not merely from T1. -/
theorem isTopologizable_geometricSpectrumClosure_of_smooth_of_reflexive :
    (geometricSpectrumClosure 𝕜 E).IsTopologizable := by
  intro S T
  rw [geometricSpectrumClosure_closure_eq_of_smooth_of_reflexive 𝕜 hsmooth hreflexive,
    geometricSpectrumClosure_closure_eq_of_smooth_of_reflexive 𝕜 hsmooth hreflexive,
    geometricSpectrumClosure_closure_eq_of_smooth_of_reflexive 𝕜 hsmooth hreflexive]

/-- The same conclusion for the computed primitive-spectrum closure. -/
theorem isTopologizable_primitiveGeometricSpectrumClosure_of_smooth_of_reflexive :
    (primitiveGeometricSpectrumClosure 𝕜 E).IsTopologizable := by
  intro S T
  rw [primitiveGeometricSpectrumClosure_closure_eq_of_smooth_of_reflexive 𝕜 hsmooth hreflexive,
    primitiveGeometricSpectrumClosure_closure_eq_of_smooth_of_reflexive 𝕜 hsmooth hreflexive,
    primitiveGeometricSpectrumClosure_closure_eq_of_smooth_of_reflexive 𝕜 hsmooth hreflexive]

section Nontrivial

variable [Nontrivial E]

/-- In a nontrivial reflexive smooth space the geometric spectrum is the singleton
consisting of the entire GSS, not the family of singleton components. -/
theorem geometricSpectrumFamily_eq_singleton_univ_of_smooth_of_reflexive :
    geometricSpectrumFamily 𝕜 E = {Set.univ} := by
  obtain ⟨x, hx⟩ := exists_ne (0 : E)
  obtain ⟨I, _⟩ := exists_geometricStructureSpace_notMem 𝕜 E hx
  have hC := (toGeometricSpectrum 𝕜 E I).property
  have hval := geometricSpectrum_val_eq_univ_of_smooth_of_reflexive
    𝕜 hsmooth hreflexive (toGeometricSpectrum 𝕜 E I)
  apply Set.ext
  intro C
  constructor
  · intro h
    exact Set.mem_singleton_iff.2
      (geometricSpectrum_val_eq_univ_of_smooth_of_reflexive 𝕜 hsmooth hreflexive ⟨C, h⟩)
  · intro h
    have hCu : C = Set.univ := Set.mem_singleton_iff.1 h
    rw [hCu, ← hval]
    exact hC

/-- The primitive geometric spectrum is the singleton family containing the set `{0}`. -/
theorem primitiveGeometricSpectrumFamily_eq_singleton_zero_of_smooth_of_reflexive :
    primitiveGeometricSpectrumFamily 𝕜 E = {{0}} := by
  obtain ⟨x, hx⟩ := exists_ne (0 : E)
  obtain ⟨I, _⟩ := exists_geometricStructureSpace_notMem 𝕜 E hx
  have hJ := (toPrimitiveGeometricSpectrum 𝕜 E I).property
  have hval := primitiveGeometricSpectrum_val_eq_singleton_zero_of_smooth_of_reflexive
    𝕜 hsmooth hreflexive (toPrimitiveGeometricSpectrum 𝕜 E I)
  apply Set.ext
  intro J
  constructor
  · intro h
    exact Set.mem_singleton_iff.2
      (primitiveGeometricSpectrum_val_eq_singleton_zero_of_smooth_of_reflexive
        𝕜 hsmooth hreflexive ⟨J, h⟩)
  · intro h
    have hJ0 : J = ({0} : Set E) := Set.mem_singleton_iff.1 h
    rw [hJ0, ← hval]
    exact hJ

end Nontrivial

end NormedSpace
