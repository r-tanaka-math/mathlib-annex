import MathlibAnnex.Analysis.InnerProductSpace.MatrixCoefficient.Proportionality
import Mathlib.LinearAlgebra.Dimension.FreeAndStrongRankCondition
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import Mathlib.Analysis.InnerProductSpace.Positive

/-!
# Complex semilinear operators determined by coefficient zero sets

A linear map of range dimension at least two and a nonzero semilinear map
with the same coefficient annihilation implication have one common nonzero
proportionality scalar. The scalar homomorphism is the identity. The core
argument uses only addition, one independent pair in the range, and scalar
cancellation over the COMMUTATIVE field of complex numbers. It needs neither
boundedness nor positivity nor completeness.

The proof first forces the scalar homomorphism to be the identity on the
plane generated by a nonzero value of the second map and an independent
range vector. The already supplied linear proportionality theorem then
applies to the actual maps. The bounded positive specialization records the
hypotheses of Lemma 6.15 separately; its positivity assumption is redundant
in this stronger proof. No assertion over arbitrary division rings is made.
-/

set_option autoImplicit false
noncomputable section

namespace InnerProductSpace

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F]

/-- Bridge the vector annihilation condition to the existing scalar-functional
kernel theorem. The scalar is conjugated when the representing vector is recovered. -/
private theorem exists_eq_smul_of_ker_inner_le (a b : F)
    (h : ∀ y : F, inner ℂ y a = 0 → inner ℂ y b = 0) :
    ∃ c : ℂ, b = c • a := by
  by_cases ha : a = 0
  · have hb : inner ℂ b b = 0 := h b (by simp only [ha, inner_zero_right])
    exact ⟨0, by simpa only [zero_smul] using (inner_self_eq_zero (𝕜 := ℂ)).mp hb⟩
  have hf : (innerSL ℂ a : F →L[ℂ] ℂ) ≠ 0 := by
    intro hf0
    have hz := congrArg (fun f : F →L[ℂ] ℂ => f a) hf0
    change inner ℂ a a = 0 at hz
    exact (inner_self_ne_zero.mpr ha) hz
  have hker : (innerSL ℂ a).ker ≤ (innerSL ℂ b).ker := by
    intro y hy
    change inner ℂ a y = 0 at hy
    change inner ℂ b y = 0
    exact inner_eq_zero_symm.mp (h y (inner_eq_zero_symm.mp hy))
  obtain ⟨c, hc⟩ := (ContinuousLinearMap.ker_le_ker_iff_exists_smul hf).mp hker
  refine ⟨star c, ?_⟩
  apply ext_inner_right ℂ
  intro y
  have hcy : inner ℂ b y = c * inner ℂ a y :=
    congrArg (fun f : F →L[ℂ] ℂ => f y) hc
  simpa only [inner_smul_left, starRingEnd_apply, star_star] using hcy

end InnerProductSpace

namespace LinearMap

universe u v
variable {E : Type u} [AddCommGroup E] [Module ℂ E]
variable {F : Type v} [NormedAddCommGroup F] [InnerProductSpace ℂ F]
variable {σ : ℂ →+* ℂ}

/-- Range dimension strictly greater than one forces the actual scalar homomorphism
of a nonzero semilinear map to be the identity, and yields a single nonzero scalar.
The domain is algebraic; boundedness is not assumed. -/
theorem eq_id_and_exists_ne_zero_smul_of_forall_inner_eq_zero_imp
    (A : E →ₗ[ℂ] F) (B : E →ₛₗ[σ] F)
    (hA : 1 < Module.rank ℂ A.range) (hB : B ≠ 0)
    (h : ∀ (x : E) (y : F), inner ℂ y (A x) = 0 → inner ℂ y (B x) = 0) :
    σ = RingHom.id ℂ ∧ ∃ c : ℂ, c ≠ 0 ∧ ∀ x : E, B x = c • A x := by
  classical
  have hlocal (x : E) : ∃ c : ℂ, B x = c • A x :=
    InnerProductSpace.exists_eq_smul_of_ker_inner_le (A x) (B x) (h x)
  obtain ⟨x₀, hxB⟩ : ∃ x₀ : E, B x₀ ≠ 0 := by
    by_contra! hall
    exact hB (LinearMap.ext hall)
  have hxA : A x₀ ≠ 0 := by
    intro hx0
    have hBB : inner ℂ (B x₀) (B x₀) = 0 := h x₀ (B x₀) (by simp only [hx0, inner_zero_right])
    exact hxB ((inner_self_eq_zero (𝕜 := ℂ)).mp hBB)
  obtain ⟨x₁, hx₁⟩ : ∃ x₁ : E, A x₁ ∉ ℂ ∙ (A x₀) := by
    by_contra hnone
    have hall : ∀ x₁ : E, A x₁ ∈ ℂ ∙ (A x₀) := by
      simpa only [not_exists, not_not] using hnone
    have hsmall : Module.rank ℂ A.range ≤ 1 :=
      (rank_submodule_le_one_iff' A.range).mpr ⟨A x₀, by
        rintro z ⟨x, rfl⟩
        exact hall x⟩
    exact (not_le_of_gt hA) hsmall
  have hpair : LinearIndependent ℂ ![A x₀, A x₁] := by
    apply (LinearIndependent.pair_iff' hxA).mpr
    intro c hc
    apply hx₁
    rw [← hc]
    exact Submodule.smul_mem _ c (Submodule.mem_span_singleton_self (A x₀))
  obtain ⟨c₀, hc₀⟩ := hlocal x₀
  obtain ⟨c₁, hc₁⟩ := hlocal x₁
  obtain ⟨d, hd⟩ := hlocal (x₀ + x₁)
  have hcd : c₀ = d ∧ c₁ = d := hpair.eq_of_pair (by
    simpa only [map_add, hc₀, hc₁, smul_add] using hd)
  have hc₁' : B x₁ = c₀ • A x₁ := by
    rw [hc₁, hcd.2, ← hcd.1]
  have hc₀_ne : c₀ ≠ 0 := by
    intro hc0
    exact hxB (by simpa only [hc0, zero_smul] using hc₀)
  have hσ : σ = RingHom.id ℂ := by
    apply RingHom.ext
    intro t
    obtain ⟨d', hd'⟩ := hlocal (t • x₀ + x₁)
    have hcoeff : (σ t * c₀) • A x₀ + c₀ • A x₁ =
        (d' * t) • A x₀ + d' • A x₁ := by
      calc
        (σ t * c₀) • A x₀ + c₀ • A x₁ = B (t • x₀ + x₁) := by
          rw [map_add, B.map_smulₛₗ, hc₀, hc₁', smul_smul]
        _ = d' • A (t • x₀ + x₁) := hd'
        _ = (d' * t) • A x₀ + d' • A x₁ := by
          rw [map_add, map_smul, smul_add, smul_smul]
    obtain ⟨hleft, hright⟩ := hpair.eq_of_pair hcoeff
    have ht : σ t * c₀ = t * c₀ := by
      calc
        σ t * c₀ = d' * t := hleft
        _ = c₀ * t := by rw [← hright]
        _ = t * c₀ := mul_comm _ _
    exact mul_right_cancel₀ hc₀_ne ht
  subst σ
  obtain ⟨c, hc⟩ := exists_eq_smul_of_forall_inner_eq_zero_imp A B h
  refine ⟨rfl, c, ?_, ?_⟩
  · intro hc0
    exact hB (by simpa only [hc0, zero_smul] using hc)
  · intro x
    exact congrArg (fun L : E →ₗ[ℂ] F => L x) hc

/-- The same statement with the literal cardinal rank-at-least-two hypothesis. -/
theorem eq_id_and_exists_ne_zero_smul_of_two_le_rank_of_inner_eq_zero_imp
    (A : E →ₗ[ℂ] F) (B : E →ₛₗ[σ] F)
    (hA : 2 ≤ Module.rank ℂ A.range) (hB : B ≠ 0)
    (h : ∀ (x : E) (y : F), inner ℂ y (A x) = 0 → inner ℂ y (B x) = 0) :
    σ = RingHom.id ℂ ∧ ∃ c : ℂ, c ≠ 0 ∧ ∀ x : E, B x = c • A x :=
  eq_id_and_exists_ne_zero_smul_of_forall_inner_eq_zero_imp A B
    (Cardinal.two_le_iff_one_lt.mp hA) hB h

end LinearMap

namespace ContinuousLinearMap

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable {σ : ℂ →+* ℂ}

/-- Bounded-operator specialization using a nonzero diagonal coefficient of B.
Positivity of A is not required for this stronger statement. -/
theorem eq_id_and_exists_ne_zero_smul_of_inner_eq_zero_imp_of_diagonal_ne_zero
    (A : H →L[ℂ] H) (B : H →SL[σ] H)
    (hA : 2 ≤ Module.rank ℂ A.range)
    (h : ∀ x y : H, inner ℂ y (A x) = 0 → inner ℂ y (B x) = 0)
    (x₀ : H) (hdiag : inner ℂ (B x₀) x₀ ≠ 0) :
    σ = RingHom.id ℂ ∧ ∃ c : ℂ, c ≠ 0 ∧ ∀ x : H, B x = c • A x := by
  have hB : B.toLinearMap ≠ 0 := by
    intro hB0
    have hx : B x₀ = 0 := congrArg (fun L : H →ₛₗ[σ] H => L x₀) hB0
    exact hdiag (by rw [hx, inner_zero_left])
  exact LinearMap.eq_id_and_exists_ne_zero_smul_of_two_le_rank_of_inner_eq_zero_imp
    A.toLinearMap B.toLinearMap hA hB h

/-- Lemma 6.15 with the original positive/bounded/diagonal hypotheses made explicit.
The coefficient orientation is converted by conjugate symmetry. Positivity is
redundant in the stronger theorem above, rather than an unproved order instance.
Both the linear case and the conjugate-linear case are actual specializations
of the scalar homomorphism parameter; the latter is ruled out by the conclusion. -/
theorem IsPositive.eq_id_and_exists_ne_zero_smul_of_inner_eq_zero_imp
    (A : H →L[ℂ] H) (hpos : A.IsPositive) (B : H →SL[σ] H)
    (hA : 2 ≤ Module.rank ℂ A.range)
    (h : ∀ x y : H, inner ℂ (A x) y = 0 → inner ℂ (B x) y = 0)
    (x₀ : H) (hx₀ : x₀ ≠ 0) (hdiag : inner ℂ (B x₀) x₀ ≠ 0) :
    σ = RingHom.id ℂ ∧ ∃ c : ℂ, c ≠ 0 ∧ ∀ x : H, B x = c • A x := by
  exact eq_id_and_exists_ne_zero_smul_of_inner_eq_zero_imp_of_diagonal_ne_zero
    A B hA (fun x y hxy => inner_eq_zero_symm.mp (h x y (inner_eq_zero_symm.mp hxy)))
    x₀ hdiag

end ContinuousLinearMap
