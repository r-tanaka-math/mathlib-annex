import MathlibAnnex.Analysis.CStarAlgebra.Bidual.EnvelopingEquivalence

/-!
# Extending a nondegenerate representation from the concrete envelope

The literal bidual equivalence transports the existing represented extension
to a unital star homomorphism from the all-state envelope. Its values belong
to the concrete von Neumann algebra generated by the given representation.

Unitality is proved from nondegeneracy of the original-algebra action. The
topology statements use weak-star on the literal bidual and WOT on explicitly
topologized operator subtypes. No surjectivity or central-kernel assertion is
included in this interface; those conclusions require further proofs.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000
noncomputable section

open MathlibAnnex.RepresentedBidual
open scoped CStarAlgebra

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v

variable {A : Type u} [NonUnitalCStarAlgebra A]
variable [PartialOrder A] [StarOrderedRing A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The actual bidual unit acts as the identity in every nondegenerate
representation of the original algebra. -/
theorem extension_bidualUnit_of_isNondegenerate
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate) :
    extension pi (bidualUnit (A := A)) = 1 := by
  apply ContinuousLinearMap.ext
  intro x
  change extension pi (bidualUnit (A := A)) x = x
  apply sub_eq_zero.mp
  apply hnd
  intro a
  have hmul : pi a * extension pi (bidualUnit (A := A)) = pi a := by
    calc
      pi a * extension pi (bidualUnit (A := A)) =
          extension pi (NormedSpace.inclusionInDoubleDual ℂ A a) *
            extension pi (bidualUnit (A := A)) := by rw [extension_canonical]
      _ = extension pi (arensProduct (NormedSpace.inclusionInDoubleDual ℂ A a)
          (bidualUnit (A := A))) := (extension_arensProduct pi _ _).symm
      _ = pi a := by rw [arensProduct_bidualUnit_right, extension_canonical]
  have hx := congrArg (fun T : H →L[ℂ] H => T x) hmul
  change pi a (extension pi (bidualUnit (A := A)) x) = pi a x at hx
  rw [map_sub, hx, sub_self]

/-- A nondegenerate representation extends to a unital star homomorphism
on the actual concrete all-state envelope. Its codomain is the generated
von Neumann algebra on the original represented Hilbert space. -/
def envelopingRepresentationExtension
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate) :
    (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra →⋆ₐ[ℂ]
      (VonNeumannAlgebra.generated pi.unitization.range).toStarSubalgebra := by
  let e := bidualEnvelopingEquiv (A := A)
  let f : (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra →ₗ[ℂ] (H →L[ℂ] H) :=
    (extension pi).toLinearMap.comp e.symm.toLinearEquiv.toLinearMap
  have hone : f 1 = 1 := extension_bidualUnit_of_isNondegenerate pi hnd
  have hmul (S T : (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra) :
      f (S * T) = f S * f T :=
    (congrArg (extension pi) (bidualEnvelopingEquiv_symm_mul (A := A) S T)).trans
      (extension_arensProduct pi (e.symm S) (e.symm T))
  let raw : (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra →⋆ₐ[ℂ] (H →L[ℂ] H) :=
    { toAlgHom := AlgHom.ofLinearMap f hone hmul
      map_star' T := (congrArg (extension pi) (bidualEnvelopingEquiv_symm_star (A := A) T)).trans
        (extension_bidualStar pi (e.symm T)) }
  exact raw.codRestrict (VonNeumannAlgebra.generated pi.unitization.range).toStarSubalgebra
    (fun T => extension_mem_vonNeumannAlgebra pi (VonNeumannAlgebra.generated pi.unitization.range)
      (fun a => VonNeumannAlgebra.subset_generated pi.unitization.range
        ⟨Unitization.inr a, NonUnitalCStarRepresentation.unitization_inr pi a⟩) (e.symm T))

/-- The concrete extension is exactly the existing literal-bidual map
composed with the inverse isometric envelope identification. -/
@[simp]
theorem envelopingRepresentationExtension_apply_coe
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate)
    (T : (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra) :
    (envelopingRepresentationExtension pi hnd T : H →L[ℂ] H) =
      extension pi ((bidualEnvelopingEquiv (A := A)).symm T) := rfl

/-- The extension agrees with the prescribed original-algebra action. -/
@[simp]
theorem envelopingRepresentationExtension_inclusion
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate) (a : A) :
    (envelopingRepresentationExtension pi hnd (envelopingInclusion (A := A) a) :
      H →L[ℂ] H) = pi a := by
  let e := bidualEnvelopingEquiv (A := A)
  have hinv := (congrArg e.symm (bidualEnvelopingEquiv_canonical (A := A) a).symm).trans
    (e.symm_apply_apply (NormedSpace.inclusionInDoubleDual ℂ A a))
  exact (envelopingRepresentationExtension_apply_coe pi hnd _).trans
    ((congrArg (extension pi) hinv).trans (extension_canonical pi a))

/-- Pulling back along the proved bidual identification gives the prescribed
weak-star-to-WOT continuity. -/
theorem envelopingRepresentationExtension_weakStar_wot
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate) :
    Continuous (fun F : WeakDual ℂ (StrongDual ℂ A) =>
      ContinuousLinearMapWOT.ofCLM
        (envelopingRepresentationExtension pi hnd
          (bidualEnvelopingEquiv (A := A) (WeakDual.toStrongDual F)) : H →L[ℂ] H)) := by
  simpa only [envelopingRepresentationExtension_apply_coe,
    LinearIsometryEquiv.symm_apply_apply] using extension_weakStar_wotContinuous pi

/-- On the universal envelope's explicit WOT subtype, the same map is WOT
continuous. The normality terminology is not substituted for this topology. -/
theorem continuous_envelopingRepresentationExtension_wot
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate) :
    Continuous (fun T :
      {T : UniversalHilbertSpace A →WOT[ℂ] UniversalHilbertSpace A //
        T.toCLM ∈ envelopingVonNeumannAlgebra (A := A)} =>
      ContinuousLinearMapWOT.ofCLM
        (envelopingRepresentationExtension pi hnd ⟨T.val.toCLM, T.property⟩ : H →L[ℂ] H)) := by
  have h := (extension_weakStar_wotContinuous pi).comp
    (bidualEnvelopingWeakStarEquiv (A := A)).symm.continuous
  change Continuous (fun T :
    {T : UniversalHilbertSpace A →WOT[ℂ] UniversalHilbertSpace A //
      T.toCLM ∈ envelopingVonNeumannAlgebra (A := A)} =>
    ContinuousLinearMapWOT.ofCLM (extension pi
      (WeakDual.toStrongDual ((bidualEnvelopingWeakStarEquiv (A := A)).symm T)))) at h
  simpa only [bidualEnvelopingWeakStarEquiv_symm_apply,
    envelopingRepresentationExtension_apply_coe] using h

/-- Uniqueness among all maps with the prescribed weak-star-to-WOT
continuity and canonical-source values. No linearity hypothesis on a
competing map is necessary. -/
theorem envelopingRepresentationExtension_unique
    (pi : NonUnitalCStarRepresentation A H) (hnd : pi.IsNondegenerate)
    (T : (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra → (H →L[ℂ] H))
    (hcont : Continuous (fun F : WeakDual ℂ (StrongDual ℂ A) =>
      ContinuousLinearMapWOT.ofCLM
        (T (bidualEnvelopingEquiv (A := A) (WeakDual.toStrongDual F)))))
    (hsource : ∀ a : A, T (envelopingInclusion (A := A) a) = pi a) :
    T = fun S => (envelopingRepresentationExtension pi hnd S : H →L[ℂ] H) := by
  have hraw : (fun F : StrongDual ℂ (StrongDual ℂ A) =>
      T (bidualEnvelopingEquiv (A := A) F)) = extension pi := by
    apply extension_unique pi _ hcont
    intro a
    rw [bidualEnvelopingEquiv_canonical (A := A) a, hsource]
  funext S
  have h := congrFun hraw ((bidualEnvelopingEquiv (A := A)).symm S)
  simpa only [LinearIsometryEquiv.apply_symm_apply,
    envelopingRepresentationExtension_apply_coe] using h

end MathlibAnnex.Analysis.CStarAlgebra
