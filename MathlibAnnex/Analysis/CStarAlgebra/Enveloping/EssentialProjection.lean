import MathlibAnnex.Analysis.CStarAlgebra.Enveloping.Representation
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Topology.Algebra.Module.Basic

/-!
# The essential projection of a possibly degenerate representation

The represented image of the actual Banach-bidual unit is a star projection,
even when the original representation is degenerate. Its range is exactly
the closed linear span of all represented vectors, and its kernel is the
common kernel of the represented algebra. It belongs to, and is central in,
the von Neumann algebra generated by the canonical unitization.

Thus restricting a representation to the canonical closed ideal in a
unitization produces its actual essential projection on the same Hilbert
space. No nondegeneracy premise is used in this construction. The existing
bidual unit, extension, and approximation net are reused without changing
their norm, multiplication, involution, or frozen source module.
-/

set_option autoImplicit false
noncomputable section

open Filter Set Topology
open MathlibAnnex.RepresentedBidual
open scoped CStarAlgebra InnerProduct

namespace MathlibAnnex.Analysis.CStarAlgebra.NonUnitalCStarRepresentation

universe u v

variable {A : Type u} [NonUnitalCStarAlgebra A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The closed span of all vectors on which the represented algebra acts. -/
def essentialSubspace (pi : NonUnitalCStarRepresentation A H) : Submodule ℂ H :=
  (Submodule.span ℂ (Set.range (fun p : A × H => pi p.1 p.2))).topologicalClosure

theorem isClosed_essentialSubspace (pi : NonUnitalCStarRepresentation A H) :
    IsClosed (pi.essentialSubspace : Set H) :=
  Submodule.isClosed_topologicalClosure _

theorem apply_mem_essentialSubspace (pi : NonUnitalCStarRepresentation A H)
    (a : A) (x : H) : pi a x ∈ pi.essentialSubspace :=
  (Submodule.le_topologicalClosure _)
    (Submodule.subset_span (Set.mem_range.mpr ⟨(a, x), rfl⟩))

variable [PartialOrder A] [StarOrderedRing A]

/-- The actual bidual unit acts as the essential projection. This definition
does not require the representation to be nonzero or nondegenerate. -/
def essentialProjection (pi : NonUnitalCStarRepresentation A H) : H →L[ℂ] H :=
  extension pi (bidualUnit (A := A))

theorem isStarProjection_essentialProjection (pi : NonUnitalCStarRepresentation A H) :
    IsStarProjection pi.essentialProjection := by
  constructor
  · change extension pi (bidualUnit (A := A)) * extension pi (bidualUnit (A := A)) =
      extension pi (bidualUnit (A := A))
    rw [← extension_arensProduct, arensProduct_bidualUnit_left]
  · change star (extension pi (bidualUnit (A := A))) = extension pi (bidualUnit (A := A))
    rw [← extension_bidualStar, bidualStar_bidualUnit]

@[simp]
theorem essentialProjection_mul (pi : NonUnitalCStarRepresentation A H) (a : A) :
    pi.essentialProjection * pi a = pi a := by
  simpa only [essentialProjection, arensProduct_bidualUnit_left, extension_canonical] using
    (extension_arensProduct pi (bidualUnit (A := A))
      (NormedSpace.inclusionInDoubleDual ℂ A a)).symm

@[simp]
theorem mul_essentialProjection (pi : NonUnitalCStarRepresentation A H) (a : A) :
    pi a * pi.essentialProjection = pi a := by
  simpa only [essentialProjection, arensProduct_bidualUnit_right, extension_canonical] using
    (extension_arensProduct pi (NormedSpace.inclusionInDoubleDual ℂ A a)
      (bidualUnit (A := A))).symm

/-- The star projection just constructed projects onto the actual closed
span of the represented ranges. The range inclusion from the bidual uses
the existing strong-star source net, also valid for degenerate actions. -/
theorem range_essentialProjection (pi : NonUnitalCStarRepresentation A H) :
    pi.essentialProjection.range = pi.essentialSubspace := by
  classical
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact (isClosed_essentialSubspace pi).mem_of_tendsto
      (universalSample_strongStar (fun _ : Unit => H) (fun _ => pi)
        (bidualUnit (A := A)) () x).1
      (Filter.Eventually.of_forall (fun d => apply_mem_essentialSubspace pi
        (universalSample (fun _ : Unit => H) (fun _ => pi) (bidualUnit (A := A)) d) x))
  · change (Submodule.span ℂ (Set.range (fun p : A × H => pi p.1 p.2))).topologicalClosure ≤
      pi.essentialProjection.range
    apply Submodule.topologicalClosure_minimal
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨a, x⟩, rfl⟩
      exact ⟨pi a x, congrArg (fun T : H →L[ℂ] H => T x)
        (essentialProjection_mul pi a)⟩
    · exact ContinuousLinearMap.IsIdempotentElem.isClosed_range
        (isStarProjection_essentialProjection pi).isIdempotentElem

/-- This operator is the existing orthogonal projection onto the closed
essential subspace, not merely an idempotent with a new projection label. -/
theorem essentialProjection_eq_starProjection
    (pi : NonUnitalCStarRepresentation A H) :
    ∃ (_ : pi.essentialSubspace.HasOrthogonalProjection),
      pi.essentialProjection = pi.essentialSubspace.starProjection := by
  have h := isStarProjection_iff_eq_starProjection_range.mp
    (isStarProjection_essentialProjection pi)
  rwa [range_essentialProjection pi] at h

/-- The essential projection has exactly the common kernel of the original
action. This does not assume that the common kernel is zero. -/
theorem essentialProjection_apply_eq_zero_iff
    (pi : NonUnitalCStarRepresentation A H) (x : H) :
    pi.essentialProjection x = 0 ↔ ∀ a : A, pi a x = 0 := by
  constructor
  · intro hx a
    have h := congrArg (fun T : H →L[ℂ] H => T x) (mul_essentialProjection pi a)
    change pi a (pi.essentialProjection x) = pi a x at h
    simpa only [hx, map_zero] using h.symm
  · intro hx
    apply MathlibAnnex.HilbertBidual.eq_of_dual_eq
    intro g
    have hc : coefficient pi x g = 0 := by
      ext a
      change g (pi a x) = 0
      rw [hx a, map_zero]
    change g (extension pi (bidualUnit (A := A)) x) = g 0
    simp only [coefficient_extension, hc, map_zero]

/-- Vanishing of the essential projection is equivalent to vanishing of
the whole original-algebra action. -/
theorem essentialProjection_eq_zero_iff (pi : NonUnitalCStarRepresentation A H) :
    pi.essentialProjection = 0 ↔ ∀ a : A, pi a = 0 := by
  constructor
  · intro h a
    apply ContinuousLinearMap.ext
    intro x
    exact (essentialProjection_apply_eq_zero_iff pi x).mp
      (by rw [h]; rfl) a
  · intro h
    apply ContinuousLinearMap.ext
    intro x
    apply (essentialProjection_apply_eq_zero_iff pi x).mpr
    intro a
    rw [h a]
    rfl

/-- Nondegeneracy is proved equivalent to the essential projection being
the ambient identity, rather than built into its definition. -/
theorem essentialProjection_eq_one_iff (pi : NonUnitalCStarRepresentation A H) :
    pi.essentialProjection = 1 ↔ pi.IsNondegenerate := by
  constructor
  · intro h x hx
    have hz := (essentialProjection_apply_eq_zero_iff pi x).mpr hx
    simpa only [h, ContinuousLinearMap.one_apply] using hz
  · intro hnd
    exact extension_bidualUnit_of_isNondegenerate pi hnd

/-- The projection belongs to the generated algebra on the original
represented Hilbert space, including when it is a proper projection. -/
theorem essentialProjection_mem_generated (pi : NonUnitalCStarRepresentation A H) :
    pi.essentialProjection ∈ VonNeumannAlgebra.generated pi.unitization.range :=
  extension_mem_vonNeumannAlgebra pi (VonNeumannAlgebra.generated pi.unitization.range)
    (fun a => VonNeumannAlgebra.subset_generated pi.unitization.range
      ⟨Unitization.inr a, unitization_inr pi a⟩) (bidualUnit (A := A))

/-- The essential projection is central in the algebra generated by the
unitization. Source commutation and the existing bicommutant description
are sufficient; no type classification or irreducibility is used. -/
theorem essentialProjection_commute (pi : NonUnitalCStarRepresentation A H)
    (T : H →L[ℂ] H) (hT : T ∈ VonNeumannAlgebra.generated pi.unitization.range) :
    T * pi.essentialProjection = pi.essentialProjection * T := by
  have hP : pi.essentialProjection ∈ Set.centralizer (Set.range pi) := by
    rintro _ ⟨a, rfl⟩
    exact (mul_essentialProjection pi a).trans (essentialProjection_mul pi a).symm
  have hPunit : pi.essentialProjection ∈ Set.centralizer (Set.range pi.unitization) := by
    rw [centralizer_range_unitization]
    exact hP
  exact ((VonNeumannAlgebra.mem_generated_iff pi.unitization.range T).mp hT
    pi.essentialProjection hPunit).symm

end MathlibAnnex.Analysis.CStarAlgebra.NonUnitalCStarRepresentation
