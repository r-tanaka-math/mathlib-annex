import MathlibAnnex.Analysis.CStarAlgebra.Enveloping.UniversalRepresentation
import MathlibAnnex.Analysis.CStarAlgebra.Enveloping.ApproximateUnit
import MathlibAnnex.Analysis.VonNeumannAlgebra.Bicommutant

/-!
# The concrete enveloping von Neumann algebra

The Hilbert space is the all-state GNS sum of the original algebra. Its
original-algebra action is already proved nondegenerate. We use the accepted
unital `VonNeumannAlgebra.generated` construction on the range of its canonical
unitization on this same space. This does not add a Hilbert-space summand.

The centralizer calculation identifies the resulting carrier with the double
commutant of the original-algebra range. Thus the construction is independent
of writing the scalar identity explicitly in the generating star subalgebra.
The norm on the concrete envelope is its inherited operator norm.
-/

set_option autoImplicit false
set_option maxHeartbeats 1600000
noncomputable section

open Set
open scoped CStarAlgebra

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v

variable {A : Type u} [NonUnitalCStarAlgebra A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

namespace NonUnitalCStarRepresentation

/-- The unitization on the same Hilbert space does not change the commutant
of the represented original algebra. This algebraic fact needs no
nondegeneracy premise. -/
theorem centralizer_range_unitization (pi : NonUnitalCStarRepresentation A H) :
    Set.centralizer (Set.range pi.unitization) = Set.centralizer (Set.range pi) := by
  ext T
  constructor
  · intro h S hS
    obtain ⟨a, rfl⟩ := hS
    have ha := h (pi.unitization (Unitization.inr a)) ⟨Unitization.inr a, rfl⟩
    simpa only [unitization_inr] using ha
  · intro h S hS
    obtain ⟨z, rfl⟩ := hS
    induction z using Unitization.ind with
    | inl_add_inr c a =>
        have ha := h (pi a) ⟨a, rfl⟩
        change pi.unitization (Unitization.inl c + Unitization.inr a) * T =
          T * pi.unitization (Unitization.inl c + Unitization.inr a)
        simpa [unitization, Unitization.starLift, Unitization.lift,
          NonUnitalAlgHom.toAlgHom, Algebra.algebraMap_eq_smul_one, add_mul, mul_add,
          smul_mul_assoc, mul_smul_comm] using
          congrArg (fun Q : H →L[ℂ] H => c • T + Q) ha

end NonUnitalCStarRepresentation

variable [PartialOrder A] [StarOrderedRing A]

/-- The concrete envelope generated by the all-state universal action.
Unitization acts on the already nondegenerate universal Hilbert space. -/
def envelopingVonNeumannAlgebra : VonNeumannAlgebra (UniversalHilbertSpace A) :=
  VonNeumannAlgebra.generated
    (StarAlgHom.range ((universalRepresentation (A := A)).unitization))

/-- Its carrier is exactly the double commutant of the original-algebra
range, with no scalar-character Hilbert summand. -/
theorem coe_envelopingVonNeumannAlgebra :
    (envelopingVonNeumannAlgebra (A := A) :
      Set (UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A)) =
        Set.centralizer (Set.centralizer (Set.range (universalRepresentation (A := A)))) := by
  change Set.centralizer (Set.centralizer
    (Set.range ((universalRepresentation (A := A)).unitization))) = _
  rw [NonUnitalCStarRepresentation.centralizer_range_unitization]

/-- Every original element acts inside the concrete envelope. -/
theorem universalRepresentation_mem_envelopingVonNeumannAlgebra (a : A) :
    universalRepresentation (A := A) a ∈ envelopingVonNeumannAlgebra (A := A) := by
  rw [← SetLike.mem_coe, coe_envelopingVonNeumannAlgebra]
  exact Set.subset_centralizer_centralizer ⟨a, rfl⟩

/-- The faithful original-algebra map into the actual envelope, with its
concrete C*-algebra subtype as codomain. -/
def envelopingInclusion :
    A →⋆ₙₐ[ℂ] (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra where
  toFun a := ⟨universalRepresentation a,
    universalRepresentation_mem_envelopingVonNeumannAlgebra a⟩
  map_zero' := Subtype.ext (map_zero (universalRepresentation (A := A)))
  map_add' a b := Subtype.ext (map_add (universalRepresentation (A := A)) a b)
  map_mul' a b := Subtype.ext (map_mul (universalRepresentation (A := A)) a b)
  map_smul' c a := Subtype.ext (map_smul (universalRepresentation (A := A)) c a)
  map_star' a := Subtype.ext (map_star (universalRepresentation (A := A)) a)

@[simp]
theorem envelopingInclusion_apply_coe (a : A) :
    ((envelopingInclusion (A := A) a :
      (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra) :
        UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A) =
          universalRepresentation a := rfl

/-- Faithfulness survives restriction of the codomain to the envelope. -/
theorem envelopingInclusion_injective : Function.Injective (envelopingInclusion (A := A)) := by
  intro a b hab
  apply universalRepresentation_injective
  exact congrArg Subtype.val hab

@[simp]
theorem norm_envelopingInclusion (a : A) : ‖envelopingInclusion (A := A) a‖ = ‖a‖ :=
  norm_universalRepresentation a

/-- Minimality is stated against the original range, not merely the
unitization range. -/
theorem envelopingVonNeumannAlgebra_le (M : VonNeumannAlgebra (UniversalHilbertSpace A))
    (hM : ∀ a : A, universalRepresentation (A := A) a ∈ M) :
    envelopingVonNeumannAlgebra (A := A) ≤ M := by
  intro T hT
  have hs : Set.range (universalRepresentation (A := A)) ⊆
      (M : Set (UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A)) := by
    rintro _ ⟨a, rfl⟩
    exact hM a
  change T ∈ (M : Set (UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A))
  rw [← M.centralizer_centralizer]
  apply Set.centralizer_subset (Set.centralizer_subset hs)
  change T ∈ (envelopingVonNeumannAlgebra (A := A) :
    Set (UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A)) at hT
  rwa [coe_envelopingVonNeumannAlgebra] at hT

/-- The accepted bicommutant theorem identifies the envelope with the SOT
closure of the unitized range on the same universal Hilbert space. -/
theorem mem_envelopingVonNeumannAlgebra_iff_mem_sotClosure_unitization
    (T : UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A) :
    T ∈ envelopingVonNeumannAlgebra (A := A) ↔
      ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ)
        (UniversalHilbertSpace A) (UniversalHilbertSpace A) T ∈
          closure (ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ)
            (UniversalHilbertSpace A) (UniversalHilbertSpace A) ''
              Set.range ((universalRepresentation (A := A)).unitization)) :=
  VonNeumannAlgebra.mem_generated_iff_mem_sotClosure _ T

/-- The corresponding WOT statement keeps WOT explicit; it does not
identify WOT with the ultraweak topology on unbounded sets. -/
theorem mem_envelopingVonNeumannAlgebra_iff_mem_wotClosure_unitization
    (T : UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A) :
    T ∈ envelopingVonNeumannAlgebra (A := A) ↔
      ContinuousLinearMapWOT.ofCLM T ∈
        closure (ContinuousLinearMapWOT.ofCLM ''
          Set.range ((universalRepresentation (A := A)).unitization)) :=
  VonNeumannAlgebra.mem_generated_iff_mem_wotClosure _ T

/-- The concrete envelope is the strong closure of the ORIGINAL algebra's
all-state representation. Nondegeneracy and the canonical approximate unit
remove the unitization from the bicommutant density theorem. -/
theorem mem_envelopingVonNeumannAlgebra_iff_mem_sotClosure
    (T : UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A) :
    T ∈ envelopingVonNeumannAlgebra (A := A) ↔
      ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ)
        (UniversalHilbertSpace A) (UniversalHilbertSpace A) T ∈
          closure (ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ)
            (UniversalHilbertSpace A) (UniversalHilbertSpace A) ''
              Set.range (universalRepresentation (A := A))) := by
  rw [mem_envelopingVonNeumannAlgebra_iff_mem_sotClosure_unitization,
    NonUnitalCStarRepresentation.sotClosure_range_unitization
      (universalRepresentation (A := A)) isNondegenerate_universalRepresentation]

/-- The concrete envelope is also the weak operator closure of the original
range. No assertion identifies WOT with an ultraweak topology on unbounded
sets. -/
theorem mem_envelopingVonNeumannAlgebra_iff_mem_wotClosure
    (T : UniversalHilbertSpace A →L[ℂ] UniversalHilbertSpace A) :
    T ∈ envelopingVonNeumannAlgebra (A := A) ↔
      ContinuousLinearMapWOT.ofCLM T ∈
        closure (ContinuousLinearMapWOT.ofCLM ''
          Set.range (universalRepresentation (A := A))) := by
  rw [mem_envelopingVonNeumannAlgebra_iff_mem_wotClosure_unitization,
    NonUnitalCStarRepresentation.wotClosure_range_unitization
      (universalRepresentation (A := A)) isNondegenerate_universalRepresentation]

/-- The zero algebra has zero concrete envelope. This uses the empty
all-state Hilbert sum, with no scalar-character summand. -/
theorem subsingleton_envelopingVonNeumannAlgebra [Subsingleton A] :
    Subsingleton (envelopingVonNeumannAlgebra (A := A)).toStarSubalgebra := by
  letI : Subsingleton (UniversalHilbertSpace A) := subsingleton_universalHilbertSpace
  infer_instance

end MathlibAnnex.Analysis.CStarAlgebra
