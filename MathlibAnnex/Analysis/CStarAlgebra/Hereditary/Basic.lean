import Mathlib.Analysis.CStarAlgebra.Classes
import Mathlib.Algebra.Order.Star.Basic

/-!
# Sandwich subalgebras and the order-hereditary predicate

The algebraic sandwich space `a A a⋆` is already a non-unital star subalgebra.
Its elements use arbitrary middle coefficients in the ambient algebra. In particular,
this construction is different from the commutative algebra generated by one normal
element. The topological closure is constructed in `Hereditary.Generated`.

The order-hereditary predicate below does not assert closedness: closedness is kept
as a separate, explicit hypothesis on the existing subalgebra carrier.
-/

set_option autoImplicit false

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- The algebraic sandwich space `a A a⋆`, with all middle coefficients from `A`. -/
def sandwichSubalgebra (a : A) : NonUnitalStarSubalgebra ℂ A where
  carrier := Set.range (fun x : A => a * x * star a)
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x + y, by simp only [mul_add, add_mul]⟩
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * star a * a * y, by simp only [mul_assoc]⟩
  smul_mem' := by
    rintro c _ ⟨x, rfl⟩
    exact ⟨c • x, by simp only [mul_smul_comm, smul_mul_assoc]⟩
  star_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨star x, by simp only [star_mul, star_star, mul_assoc]⟩

@[simp]
theorem mem_sandwichSubalgebra (a x : A) :
    x ∈ sandwichSubalgebra a ↔ ∃ y : A, a * y * star a = x := Iff.rfl

@[simp]
theorem coe_sandwichSubalgebra (a : A) :
    (sandwichSubalgebra a : Set A) = Set.range (fun x : A => a * x * star a) := rfl

theorem sandwich_mem_sandwichSubalgebra (a x : A) :
    a * x * star a ∈ sandwichSubalgebra a := ⟨x, rfl⟩

/-- Sandwich spaces are inner ideals: both outer coefficients, but not the middle
coefficient, are required to belong to the sandwich space. -/
theorem mul_mul_mem_sandwichSubalgebra (a b : A) {x y : A}
    (hx : x ∈ sandwichSubalgebra a) (hy : y ∈ sandwichSubalgebra a) :
    x * b * y ∈ sandwichSubalgebra a := by
  rcases hx with ⟨u, rfl⟩
  rcases hy with ⟨v, rfl⟩
  exact ⟨u * star a * b * a * v, by simp only [mul_assoc]⟩

section Order

variable [PartialOrder A]

/-- A non-unital star subalgebra is order hereditary if it contains every positive
element dominated by one of its elements. Norm closedness is a separate condition. -/
def IsHereditary (S : NonUnitalStarSubalgebra ℂ A) : Prop :=
  ∀ ⦃x y : A⦄, 0 ≤ x → x ≤ y → y ∈ S → x ∈ S

theorem isHereditary_top : IsHereditary (⊤ : NonUnitalStarSubalgebra ℂ A) := by
  intro x y hx hxy hy
  trivial

theorem isHereditary_bot : IsHereditary (⊥ : NonUnitalStarSubalgebra ℂ A) := by
  intro x y hx hxy hy
  have hy0 : y = 0 := NonUnitalStarAlgebra.mem_bot.mp hy
  have hx0 : x = 0 := le_antisymm (hy0 ▸ hxy) hx
  simp [hx0]

theorem IsHereditary.inf {S T : NonUnitalStarSubalgebra ℂ A}
    (hS : IsHereditary S) (hT : IsHereditary T) : IsHereditary (S ⊓ T) := by
  intro x y hx hxy hy
  exact ⟨hS hx hxy hy.1, hT hx hxy hy.2⟩

end Order

end MathlibAnnex.Analysis.CStarAlgebra
