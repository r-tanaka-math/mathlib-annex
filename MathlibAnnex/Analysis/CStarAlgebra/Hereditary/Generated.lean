import MathlibAnnex.Analysis.CStarAlgebra.Hereditary.Basic
import Mathlib.Analysis.CStarAlgebra.ApproximateUnit
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Range
import Mathlib.Analysis.Normed.Group.Continuity
import Mathlib.Tactic.Abel
import Mathlib.Tactic.Linarith

/-!
# The norm closure of a sandwich subalgebra

`hereditarySubalgebra a` is the norm closure of `a A a⋆`. For self-adjoint `a`,
the carrier is exactly `closure (Set.range (fun x => a * x * a))`.

The construction uses the inherited norm and operations. Positivity is only
needed for membership of the generator itself; the closed sandwich construction
and its inner-ideal property hold for every element of a non-unital C⋆-algebra.
-/

set_option autoImplicit false
noncomputable section

open Set Filter
open scoped Topology CStarAlgebra NNReal

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- The norm-closed sandwich subalgebra. For positive `a`, its carrier is
`closure (a A a)`, with arbitrary middle coefficients from `A`. -/
def hereditarySubalgebra (a : A) : NonUnitalStarSubalgebra ℂ A :=
  (sandwichSubalgebra a).topologicalClosure

@[simp]
theorem coe_hereditarySubalgebra (a : A) :
    (hereditarySubalgebra a : Set A) =
      closure (Set.range (fun x : A => a * x * star a)) := rfl

theorem coe_hereditarySubalgebra_of_isSelfAdjoint {a : A} (ha : IsSelfAdjoint a) :
    (hereditarySubalgebra a : Set A) =
      closure (Set.range (fun x : A => a * x * a)) := by
  rw [coe_hereditarySubalgebra, ha.star_eq]

instance isClosed_hereditarySubalgebra (a : A) :
    IsClosed (hereditarySubalgebra a : Set A) := isClosed_closure

theorem sandwich_mem_hereditarySubalgebra (a x : A) :
    a * x * star a ∈ hereditarySubalgebra a :=
  subset_closure (sandwich_mem_sandwichSubalgebra a x)

/-- Minimality among norm-closed non-unital star subalgebras containing every
sandwich with an arbitrary ambient middle coefficient. -/
theorem hereditarySubalgebra_le (a : A) {S : NonUnitalStarSubalgebra ℂ A}
    (hS : IsClosed (S : Set A)) (h : ∀ x : A, a * x * star a ∈ S) :
    hereditarySubalgebra a ≤ S := by
  apply NonUnitalStarSubalgebra.topologicalClosure_minimal _ _ hS
  rintro _ ⟨x, rfl⟩
  exact h x

theorem hereditarySubalgebra_le_iff (a : A) {S : NonUnitalStarSubalgebra ℂ A}
    (hS : IsClosed (S : Set A)) :
    hereditarySubalgebra a ≤ S ↔ ∀ x : A, a * x * star a ∈ S := by
  exact ⟨fun h x => h (sandwich_mem_hereditarySubalgebra a x),
    hereditarySubalgebra_le a hS⟩

@[simp]
theorem hereditarySubalgebra_zero : hereditarySubalgebra (0 : A) = ⊥ := by
  apply le_antisymm _ bot_le
  apply hereditarySubalgebra_le 0
  · rw [NonUnitalStarAlgebra.coe_bot]
    exact isClosed_singleton
  · intro x
    simp

/-- Closing the two outer variables independently preserves the inner-ideal
property. No commutativity of the ambient algebra is used. -/
theorem mul_mul_mem_hereditarySubalgebra (a b : A) {x y : A}
    (hx : x ∈ hereditarySubalgebra a) (hy : y ∈ hereditarySubalgebra a) :
    x * b * y ∈ hereditarySubalgebra a := by
  have hraw (u : A) : (a * u * star a) * b * y ∈ hereditarySubalgebra a := by
    apply closure_minimal
      (s := (sandwichSubalgebra a : Set A))
      (t := {z : A | (a * u * star a) * b * z ∈ hereditarySubalgebra a})
      _ _ hy
    · intro z hz
      exact subset_closure (mul_mul_mem_sandwichSubalgebra a b
        (sandwich_mem_sandwichSubalgebra a u) hz)
    · exact (isClosed_hereditarySubalgebra a).preimage
        (continuous_const.mul continuous_id)
  apply closure_minimal
    (s := (sandwichSubalgebra a : Set A))
    (t := {z : A | z * b * y ∈ hereditarySubalgebra a}) _ _ hx
  · rintro _ ⟨u, rfl⟩
    exact hraw u
  · exact (isClosed_hereditarySubalgebra a).preimage
      ((continuous_id.mul continuous_const).mul continuous_const)

/-- Membership in a closed sandwich algebra controls every further sandwich
generated by that element. -/
theorem hereditarySubalgebra_le_of_mem {a b : A} (hb : b ∈ hereditarySubalgebra a) :
    hereditarySubalgebra b ≤ hereditarySubalgebra a := by
  apply hereditarySubalgebra_le b (isClosed_hereditarySubalgebra a)
  intro x
  exact mul_mul_mem_hereditarySubalgebra a x hb (star_mem hb)

section Order

variable [PartialOrder A] [StarOrderedRing A]

/-- Positive domination controls the right-multiplication error of square roots.
The coefficient is arbitrary; no unit or contraction assumption is needed. -/
theorem norm_sqrt_sub_sqrt_mul_le {x y : A} (hx : 0 ≤ x) (hxy : x ≤ y) (e : A) :
    ‖CFC.sqrt x - CFC.sqrt x * e‖ ≤ ‖CFC.sqrt y - CFC.sqrt y * e‖ := by
  have hform (b : A) (hb : 0 ≤ b) :
      star (CFC.sqrt b - CFC.sqrt b * e) * (CFC.sqrt b - CFC.sqrt b * e) =
        b - b * e - star e * b + star e * b * e := by
    calc
      _ = star (CFC.sqrt b) * CFC.sqrt b -
          (star (CFC.sqrt b) * CFC.sqrt b) * e -
          star e * (star (CFC.sqrt b) * CFC.sqrt b) +
          star e * (star (CFC.sqrt b) * CFC.sqrt b) * e := by
            simp only [star_sub, star_mul, sub_mul, mul_sub, mul_assoc]
            abel
      _ = _ := by
        simp only [(CFC.sqrt_nonneg b).star_eq, CFC.sqrt_mul_sqrt_self b hb]
  have hdiff :
      star (CFC.sqrt y - CFC.sqrt y * e) * (CFC.sqrt y - CFC.sqrt y * e) -
        star (CFC.sqrt x - CFC.sqrt x * e) * (CFC.sqrt x - CFC.sqrt x * e) =
      star (CFC.sqrt (y - x) - CFC.sqrt (y - x) * e) *
        (CFC.sqrt (y - x) - CFC.sqrt (y - x) * e) := by
    rw [hform y (hx.trans hxy), hform x hx, hform (y - x) (sub_nonneg.mpr hxy)]
    simp only [sub_mul, mul_sub]
    abel
  have hle :
      star (CFC.sqrt x - CFC.sqrt x * e) * (CFC.sqrt x - CFC.sqrt x * e) ≤
        star (CFC.sqrt y - CFC.sqrt y * e) * (CFC.sqrt y - CFC.sqrt y * e) := by
    apply sub_nonneg.mp
    rw [hdiff]
    exact star_mul_self_nonneg _
  have hn := _root_.CStarAlgebra.norm_le_norm_of_le_of_nonneg hle
    (star_mul_self_nonneg _)
  rw [CStarRing.norm_star_mul_self, CStarRing.norm_star_mul_self] at hn
  nlinarith only [hn, norm_nonneg (CFC.sqrt x - CFC.sqrt x * e),
    norm_nonneg (CFC.sqrt y - CFC.sqrt y * e)]

/-- A norm-closed star subalgebra closed under arbitrary-middle sandwiches is
order hereditary. Its own approximate unit approximates the square root of
the dominating element; positive domination then approximates the smaller
element by sandwiches in the original subalgebra. -/
theorem isHereditary_of_isClosed_of_mul_mul_mem
    (S : NonUnitalStarSubalgebra ℂ A) (hS : IsClosed (S : Set A))
    (hinner : ∀ p ∈ S, ∀ b : A, ∀ q ∈ S, p * b * q ∈ S) : IsHereditary S := by
  letI : IsClosed (S : Set A) := hS
  letI : StarOrderedRing S := Subtype.starOrderedRing (𝕜 := ℂ) S
  intro x y hx hxy hy
  have hsy : CFC.sqrt y ∈ S := cfcₙ_nnreal_mem (𝕜 := ℂ) NNReal.sqrt hy
  let sy : S := ⟨CFC.sqrt y, hsy⟩
  have hmul_y : Tendsto (fun e : S => CFC.sqrt y * (e : A))
      (_root_.CStarAlgebra.approximateUnit S) (𝓝 (CFC.sqrt y)) :=
    (continuous_subtype_val.tendsto sy).comp
      ((_root_.CStarAlgebra.increasingApproximateUnit S).tendsto_mul_left sy)
  have herr_y : Tendsto (fun e : S => ‖CFC.sqrt y - CFC.sqrt y * (e : A)‖)
      (_root_.CStarAlgebra.approximateUnit S) (𝓝 0) := by
    simpa only [sub_self, norm_zero] using
      ((tendsto_const_nhds : Tendsto (fun _ : S => CFC.sqrt y) _ _).sub hmul_y).norm
  have herr_x : Tendsto (fun e : S => CFC.sqrt x - CFC.sqrt x * (e : A))
      (_root_.CStarAlgebra.approximateUnit S) (𝓝 0) :=
    squeeze_zero_norm (fun e => norm_sqrt_sub_sqrt_mul_le hx hxy (e : A)) herr_y
  have hmul_x : Tendsto (fun e : S => CFC.sqrt x * (e : A))
      (_root_.CStarAlgebra.approximateUnit S) (𝓝 (CFC.sqrt x)) := by
    simpa using
      (tendsto_const_nhds : Tendsto (fun _ : S => CFC.sqrt x) _ _).sub herr_x
  have hproduct : Tendsto
      (fun e : S => star (CFC.sqrt x * (e : A)) * (CFC.sqrt x * (e : A)))
      (_root_.CStarAlgebra.approximateUnit S) (𝓝 x) := by
    simpa only [Function.comp_apply, (CFC.sqrt_nonneg x).star_eq, CFC.sqrt_mul_sqrt_self x hx] using
      ((continuous_star.tendsto (CFC.sqrt x)).comp hmul_x).mul hmul_x
  apply hS.mem_of_tendsto hproduct
  apply Filter.Eventually.of_forall
  intro e
  have heq : star (CFC.sqrt x * (e : A)) * (CFC.sqrt x * (e : A)) =
      star (e : A) * x * (e : A) := by
    rw [star_mul, (CFC.sqrt_nonneg x).star_eq]
    calc
      (star (e : A) * CFC.sqrt x) * (CFC.sqrt x * (e : A)) =
          star (e : A) * (CFC.sqrt x * CFC.sqrt x) * (e : A) := by
        simp only [mul_assoc]
      _ = _ := by rw [CFC.sqrt_mul_sqrt_self x hx]
  rw [heq]
  exact hinner (star (e : A)) (star_mem e.property) x (e : A) e.property

/-- The closed sandwich subalgebra is genuinely order hereditary. -/
theorem isHereditary_hereditarySubalgebra (a : A) :
    IsHereditary (hereditarySubalgebra a) :=
  isHereditary_of_isClosed_of_mul_mul_mem _ (isClosed_hereditarySubalgebra a)
    (fun p hp b q hq => mul_mul_mem_hereditarySubalgebra a b hp hq)

/-- The ambient approximate unit supplies `a a⋆` in the closed sandwich space;
no ambient unit is inserted into the middle coefficient. -/
theorem mul_star_self_mem_hereditarySubalgebra (a : A) :
    a * star a ∈ hereditarySubalgebra a := by
  have ht := (_root_.CStarAlgebra.increasingApproximateUnit A).tendsto_mul_left a
  apply (isClosed_hereditarySubalgebra a).mem_of_tendsto (ht.mul_const (star a))
  exact Filter.Eventually.of_forall (sandwich_mem_hereditarySubalgebra a)

/-- A positive generator itself belongs to its closed sandwich subalgebra. The
proof takes the positive square root of `a a⋆` inside the closed subalgebra. -/
theorem self_mem_hereditarySubalgebra {a : A} (ha : 0 ≤ a) :
    a ∈ hereditarySubalgebra a := by
  have haa : a * a ∈ hereditarySubalgebra a := by
    simpa only [ha.star_eq] using mul_star_self_mem_hereditarySubalgebra a
  have hsqrt : CFC.sqrt (a * a) ∈ hereditarySubalgebra a :=
    cfcₙ_nnreal_mem (𝕜 := ℂ) NNReal.sqrt haa
  simpa only [CFC.sqrt_mul_self a ha] using hsqrt

/-- Positive domination gives inclusion of the actual closed sandwich algebras. -/
theorem hereditarySubalgebra_le_of_nonneg_le {a b : A}
    (ha : 0 ≤ a) (hab : a ≤ b) : hereditarySubalgebra a ≤ hereditarySubalgebra b :=
  hereditarySubalgebra_le_of_mem
    (isHereditary_hereditarySubalgebra b ha hab
      (self_mem_hereditarySubalgebra (ha.trans hab)))

/-- In a non-unital algebra, zero-preserving continuous functional calculus of
the positive generator remains in the genuine closed sandwich algebra. -/
theorem cfcₙ_mem_hereditarySubalgebra {a : A} (ha : 0 ≤ a) (f : ℝ → ℝ) :
    cfcₙ f a ∈ hereditarySubalgebra a :=
  cfcₙ_mem (𝕜' := ℂ) f (self_mem_hereditarySubalgebra ha)

/-- The positive spectral cutoff is evaluated by the existing nonunital
functional calculus and belongs to the genuine ambient sandwich algebra. -/
theorem cfcₙ_tsub_mem_hereditarySubalgebra {a : A} (ha : 0 ≤ a) (ε : ℝ≥0) :
    cfcₙ (fun t : ℝ≥0 => t - ε) a ∈ hereditarySubalgebra a :=
  cfcₙ_nnreal_mem (𝕜 := ℂ) (fun t : ℝ≥0 => t - ε)
    (self_mem_hereditarySubalgebra ha)

/-- The standard positive cutoff approximates the original positive element
in norm, with its actual cutoff parameter as the error bound. -/
theorem nnnorm_sub_cfcₙ_tsub_le {a : A} (ha : 0 ≤ a) (ε : ℝ≥0) :
    ‖a - cfcₙ (fun t : ℝ≥0 => t - ε) a‖₊ ≤ ε := by
  have heq := cfcₙ_tsub (fun t : ℝ≥0 => t) (fun t : ℝ≥0 => t - ε) a
    (fun t _ => tsub_le_self) ha
  rw [cfcₙ_id' ℝ≥0 a ha] at heq
  rw [← heq]
  apply nnnorm_cfcₙ_nnreal_le
  intro t ht
  rcases le_total t ε with h | h
  · simpa only [tsub_eq_zero_of_le h, tsub_zero] using h
  · simp only [tsub_tsub_cancel_of_le h, le_refl]

theorem hereditarySubalgebra_eq_of_mutual_mem {a b : A}
    (hab : a ∈ hereditarySubalgebra b) (hba : b ∈ hereditarySubalgebra a) :
    hereditarySubalgebra a = hereditarySubalgebra b :=
  le_antisymm (hereditarySubalgebra_le_of_mem hab) (hereditarySubalgebra_le_of_mem hba)

end Order

section Unital

variable {B : Type u} [CStarAlgebra B]

/-- `Her(1)` is the whole ambient algebra, not the one-generator algebra of `1`. -/
@[simp]
theorem hereditarySubalgebra_one : hereditarySubalgebra (1 : B) = ⊤ := by
  apply top_unique
  intro x hx
  simpa using sandwich_mem_hereditarySubalgebra (1 : B) x

end Unital

end MathlibAnnex.Analysis.CStarAlgebra
