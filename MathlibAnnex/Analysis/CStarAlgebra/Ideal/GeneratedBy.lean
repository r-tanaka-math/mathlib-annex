import MathlibAnnex.Analysis.CStarAlgebra.Ideal.MinimalCompactCorner
import MathlibAnnex.Analysis.CStarAlgebra.Representation.ExactCompactModel

/-!
# The closed C-star ideal generated by a minimal compact corner

This file records the exact closed ideal generated by a projection as an
intersection of all norm-closed two-sided C-star ideals which contain it.  The
construction is nonunital, preserves universes, and does not assume the
classification theorem it is intended to support.

For a minimal projection obtained from a faithful compact representation, the
generated ideal is nonzero.  We construct its genuine cyclic restriction,
prove from the scalar corner that the represented generator has one-dimensional
range, prove that this same cyclic representation is irreducible and faithful,
and identify its range with all compact operators through the generic exact
compact-model theorem.  A maximal orthogonal elementary-ideal family and the
subsequent norm-dense `c₀` assembly remain beyond this local endpoint.
-/

@[expose] public section

set_option autoImplicit false
set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 200000
noncomputable section

open Set
open scoped CStarAlgebra

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v
variable {A : Type u} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Membership in every norm-closed two-sided C-star ideal containing `p`. -/
def MemClosedIdealGeneratedBy (p x : A) : Prop :=
  ∀ I : ClosedStarIdeal A,
    p ∈ I.toNonUnitalStarSubalgebra → x ∈ I.toNonUnitalStarSubalgebra

/-- The smallest norm-closed two-sided C-star ideal containing `p`, constructed
as an actual intersection rather than postulated as a classification result. -/
def closedIdealGeneratedBy (p : A) : ClosedStarIdeal A where
  toNonUnitalStarSubalgebra :=
    { carrier := {x | MemClosedIdealGeneratedBy p x}
      zero_mem' := fun I _ => I.toNonUnitalStarSubalgebra.zero_mem
      add_mem' := fun hx hy I hp => I.toNonUnitalStarSubalgebra.add_mem (hx I hp) (hy I hp)
      mul_mem' := fun hx hy I hp => I.toNonUnitalStarSubalgebra.mul_mem (hx I hp) (hy I hp)
      smul_mem' := fun c _ hx I hp => I.toNonUnitalStarSubalgebra.smul_mem c (hx I hp)
      star_mem' := fun hx I hp => StarMemClass.star_mem (hx I hp) }
  isClosed_carrier := by
    change IsClosed {x : A | MemClosedIdealGeneratedBy p x}
    have hcarrier : ({x : A | MemClosedIdealGeneratedBy p x} : Set A) =
        ⋂ I : {I : ClosedStarIdeal A |
          p ∈ I.toNonUnitalStarSubalgebra},
          (I.1.toNonUnitalStarSubalgebra : Set A) := by
      ext x
      simp only [MemClosedIdealGeneratedBy, Set.mem_setOf_eq, Set.mem_iInter,
        Subtype.forall, SetLike.mem_coe]
    rw [hcarrier]
    exact isClosed_iInter fun I => I.1.isClosed_carrier
  mul_mem_left := by
    intro a x hx I hp
    exact I.mul_mem_left a (hx I hp)
  mul_mem_right := by
    intro x a hx I hp
    exact I.mul_mem_right a (hx I hp)

@[simp]
theorem mem_closedIdealGeneratedBy (p x : A) :
    x ∈ (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra ↔
      ∀ I : ClosedStarIdeal A,
        p ∈ I.toNonUnitalStarSubalgebra → x ∈ I.toNonUnitalStarSubalgebra :=
  Iff.rfl

/-- The generating projection belongs to the generated closed ideal. -/
theorem self_mem_closedIdealGeneratedBy (p : A) :
    p ∈ (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra := by
  intro I hp
  exact hp

/-- Minimality among actual closed two-sided C-star ideals. -/
theorem closedIdealGeneratedBy_le (p : A) (I : ClosedStarIdeal A)
    (hp : p ∈ I.toNonUnitalStarSubalgebra) :
    (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra ≤
      I.toNonUnitalStarSubalgebra := by
  intro x hx
  exact hx I hp

/-- A nonzero generator gives a nonzero generated ideal. -/
theorem exists_ne_zero_mem_closedIdealGeneratedBy {p : A} (hp : p ≠ 0) :
    ∃ x : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra, x ≠ 0 := by
  refine ⟨⟨p, self_mem_closedIdealGeneratedBy p⟩, ?_⟩
  intro h
  exact hp (congrArg Subtype.val h)

/-- The star-stable two-sided annihilator condition used to prove that the
cyclic representation of a minimal generated ideal is faithful.  The clauses
with an additional left multiplier are what make the carrier stable under
ambient left multiplication in the nonunital setting. -/
private def MemTwoSidedLeftAnnihilator (a x : A) : Prop :=
  a * x = 0 ∧ a * star x = 0 ∧
    ∀ b : A, a * b * x = 0 ∧ a * b * star x = 0

/-- The preceding annihilator is an actual norm-closed two-sided C-star ideal.
It is kept private because it is an auxiliary kernel argument, not a second
public ideal interface. -/
private def twoSidedLeftAnnihilator (a : A) : ClosedStarIdeal A where
  toNonUnitalStarSubalgebra :=
    { carrier := {x | MemTwoSidedLeftAnnihilator a x}
      zero_mem' := by
        refine ⟨by simp, by simp, ?_⟩
        intro b
        simp
      add_mem' := by
        intro x y hx hy
        refine ⟨?_, ?_, ?_⟩
        · rw [mul_add, hx.1, hy.1, add_zero]
        · rw [star_add, mul_add, hx.2.1, hy.2.1, add_zero]
        · intro b
          refine ⟨?_, ?_⟩
          · rw [mul_add, (hx.2.2 b).1, (hy.2.2 b).1, add_zero]
          · rw [star_add, mul_add, (hx.2.2 b).2, (hy.2.2 b).2, add_zero]
      mul_mem' := by
        intro x y hx hy
        refine ⟨?_, ?_, ?_⟩
        · calc
            a * (x * y) = (a * x) * y := by rw [mul_assoc]
            _ = 0 := by rw [hx.1, zero_mul]
        · rw [star_mul]
          calc
            a * (star y * star x) = (a * star y) * star x := by rw [mul_assoc]
            _ = 0 := by rw [hy.2.1, zero_mul]
        · intro b
          refine ⟨?_, ?_⟩
          · calc
              a * b * (x * y) = (a * b * x) * y := by simp only [mul_assoc]
              _ = 0 := by rw [(hx.2.2 b).1, zero_mul]
          · rw [star_mul]
            calc
              a * b * (star y * star x) = (a * b * star y) * star x := by
                simp only [mul_assoc]
              _ = 0 := by rw [(hy.2.2 b).2, zero_mul]
      smul_mem' := by
        intro c x hx
        refine ⟨?_, ?_, ?_⟩
        · rw [_root_.mul_smul_comm, hx.1, smul_zero]
        · rw [star_smul, _root_.mul_smul_comm, hx.2.1, smul_zero]
        · intro b
          refine ⟨?_, ?_⟩
          · rw [_root_.mul_smul_comm, (hx.2.2 b).1, smul_zero]
          · rw [star_smul, _root_.mul_smul_comm, (hx.2.2 b).2, smul_zero]
      star_mem' := by
        intro x hx
        refine ⟨hx.2.1, ?_, ?_⟩
        · simpa only [star_star] using hx.1
        · intro b
          refine ⟨(hx.2.2 b).2, ?_⟩
          simpa only [star_star] using (hx.2.2 b).1 }
  isClosed_carrier := by
    change IsClosed {x : A | MemTwoSidedLeftAnnihilator a x}
    have h₁ : IsClosed {x : A | a * x = 0} :=
      isClosed_eq (continuous_const.mul continuous_id) continuous_const
    have h₂ : IsClosed {x : A | a * star x = 0} :=
      isClosed_eq (continuous_const.mul continuous_star) continuous_const
    have h₃ : IsClosed {x : A |
        ∀ b : A, a * b * x = 0 ∧ a * b * star x = 0} := by
      simp only [Set.setOf_forall]
      apply isClosed_iInter
      intro b
      have hleft : Continuous (fun x : A => a * b * x) :=
        (continuous_const.mul continuous_const).mul continuous_id
      have hstar : Continuous (fun x : A => a * b * star x) :=
        (continuous_const.mul continuous_const).mul continuous_star
      exact (isClosed_eq hleft continuous_const).inter
        (isClosed_eq hstar continuous_const)
    simpa only [MemTwoSidedLeftAnnihilator, Set.setOf_and] using
      h₁.inter (h₂.inter h₃)
  mul_mem_left := by
    intro c x hx
    refine ⟨?_, ?_, ?_⟩
    · simpa only [mul_assoc] using (hx.2.2 c).1
    · rw [star_mul]
      calc
        a * (star x * star c) = (a * star x) * star c := by rw [mul_assoc]
        _ = 0 := by rw [hx.2.1, zero_mul]
    · intro b
      refine ⟨?_, ?_⟩
      · simpa only [mul_assoc] using (hx.2.2 (b * c)).1
      · rw [star_mul]
        calc
          a * b * (star x * star c) = (a * b * star x) * star c := by
            simp only [mul_assoc]
          _ = 0 := by rw [(hx.2.2 b).2, zero_mul]
  mul_mem_right := by
    intro x c hx
    refine ⟨?_, ?_, ?_⟩
    · calc
        a * (x * c) = (a * x) * c := by rw [mul_assoc]
        _ = 0 := by rw [hx.1, zero_mul]
    · rw [star_mul]
      simpa only [mul_assoc] using (hx.2.2 (star c)).2
    · intro b
      refine ⟨?_, ?_⟩
      · calc
          a * b * (x * c) = (a * b * x) * c := by simp only [mul_assoc]
          _ = 0 := by rw [(hx.2.2 b).1, zero_mul]
      · rw [star_mul]
        simpa only [mul_assoc] using (hx.2.2 (b * star c)).2

namespace NonUnitalCStarRepresentation

/-- The original representation restricted to the generated ideal. -/
def restrictClosedIdealGeneratedBy
    (pi : NonUnitalCStarRepresentation A H) (p : A) :
    NonUnitalCStarRepresentation
      (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra H :=
  MathlibAnnex.Analysis.CStarAlgebra.NonUnitalStarSubalgebra.restrictedRepresentation
    (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra pi

@[simp]
theorem restrictClosedIdealGeneratedBy_apply
    (pi : NonUnitalCStarRepresentation A H) (p : A)
    (x : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra) :
    pi.restrictClosedIdealGeneratedBy p x = pi x.1 := rfl

/-- Faithful compact representability passes to the exact generated ideal. -/
theorem isCompactlyRepresented_restrictClosedIdealGeneratedBy
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) (p : A) :
    (pi.restrictClosedIdealGeneratedBy p).IsCompactlyRepresented := by
  constructor
  · intro x y hxy
    apply Subtype.ext
    exact hpi.1 hxy
  · intro x
    exact hpi.2 x.1

/-- The generated ideal acting on the closure of one of its
original-representation orbits. -/
def restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H) (p : A) (x : H) :
    NonUnitalCStarRepresentation
      (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra
      ((pi.restrictClosedIdealGeneratedBy p).cyclicSubspace x) :=
  (pi.restrictClosedIdealGeneratedBy p).cyclicRestriction x

/-- Every operator in the generated-ideal cyclic restriction is compact. -/
theorem isCompactOperator_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) (p : A) (x : H)
    (a : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra) :
    IsCompactOperator (pi.restrictClosedIdealGeneratedByCyclic p x a) := by
  change IsCompactOperator
    ((pi.restrictClosedIdealGeneratedBy p).cyclicRestriction x a)
  exact (pi.restrictClosedIdealGeneratedBy p).isCompactOperator_cyclicRestriction
    (pi.isCompactlyRepresented_restrictClosedIdealGeneratedBy hpi p).2 x a

/-- If the generating element has a nonzero value on the selected vector, the
resulting generated-ideal cyclic representation is nonzero. -/
theorem isNonzero_restrictClosedIdealGeneratedByCyclic_of_apply_ne_zero
    (pi : NonUnitalCStarRepresentation A H) {p : A} {x : H}
    (hpx : pi p x ≠ 0) :
    (pi.restrictClosedIdealGeneratedByCyclic p x).IsNonzero := by
  change ((pi.restrictClosedIdealGeneratedBy p).cyclicRestriction x).IsNonzero
  let pJ : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra :=
    ⟨p, self_mem_closedIdealGeneratedBy p⟩
  apply (pi.restrictClosedIdealGeneratedBy p).isNonzero_cyclicRestriction_of_apply_ne_zero
    (x := x) (a := pJ)
  simpa only [pJ, restrictClosedIdealGeneratedBy_apply] using hpx

/-- A nonzero generator admits an actual nonzero cyclic representation of its
closed generated ideal, and every represented operator is compact. -/
theorem exists_nonzero_compact_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A} (hp : p ≠ 0) :
    ∃ x : H,
      (pi.restrictClosedIdealGeneratedByCyclic p x).IsNonzero ∧
      ∀ a : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra,
        IsCompactOperator (pi.restrictClosedIdealGeneratedByCyclic p x a) := by
  obtain ⟨x, hpx⟩ := pi.exists_apply_ne_zero_of_injective hpi.1 hp
  refine ⟨x,
    pi.isNonzero_restrictClosedIdealGeneratedByCyclic_of_apply_ne_zero hpx, ?_⟩
  intro a
  exact pi.isCompactOperator_restrictClosedIdealGeneratedByCyclic hpi p x a

/-- A represented nonzero star projection supplies a nonzero fixed
vector.  The generated-ideal cyclic representation based at that fixed vector
is nonzero and still consists entirely of compact operators. -/
theorem exists_fixed_nonzero_compact_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsStarProjection p) (hp0 : p ≠ 0) :
    ∃ x : H,
      x ≠ 0 ∧ pi p x = x ∧
      (pi.restrictClosedIdealGeneratedByCyclic p x).IsNonzero ∧
      ∀ a : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra,
        IsCompactOperator (pi.restrictClosedIdealGeneratedByCyclic p x a) := by
  obtain ⟨y, hpy⟩ := pi.exists_apply_ne_zero_of_injective hpi.1 hp0
  let x : H := pi p y
  have hx0 : x ≠ 0 := by simpa only [x] using hpy
  have hpx : pi p x = x := by
    dsimp only [x]
    change (pi p * pi p) y = pi p y
    rw [← map_mul, hp.isIdempotentElem.eq]
  have hpx0 : pi p x ≠ 0 := by simpa only [hpx] using hx0
  refine ⟨x, hx0, hpx,
    pi.isNonzero_restrictClosedIdealGeneratedByCyclic_of_apply_ne_zero hpx0, ?_⟩
  intro a
  exact pi.isCompactOperator_restrictClosedIdealGeneratedByCyclic hpi p x a

/-- The projected source vector is cyclic for the generated-ideal cyclic
restriction. -/
theorem denseRange_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H) (p : A) (x : H) :
    DenseRange (fun a : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra =>
      pi.restrictClosedIdealGeneratedByCyclic p x a
        (((pi.restrictClosedIdealGeneratedBy p).cyclicSubspace x).orthogonalProjectionOnto x)) := by
  exact (pi.restrictClosedIdealGeneratedBy p).denseRange_cyclicRestriction x

/-- On the cyclic space generated by a vector fixed by a minimal projection,
the represented generator has one-dimensional range.  The conclusion is
stated pointwise: every value is a scalar multiple of the projected cyclic
vector.  No rank-one hypothesis is made in the original representation. -/
theorem exists_eq_smul_projected_cyclic_vector_of_isMinimalStarProjection
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsMinimalStarProjection p) {x : H} (hpx : pi p x = x)
    (z : (pi.restrictClosedIdealGeneratedBy p).cyclicSubspace x) :
    ∃ c : ℂ,
      pi.restrictClosedIdealGeneratedByCyclic p x
          ⟨p, self_mem_closedIdealGeneratedBy p⟩ z =
        c • (((pi.restrictClosedIdealGeneratedBy p).cyclicSubspace x).orthogonalProjectionOnto x) := by
  let J := (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra
  let sigma : NonUnitalCStarRepresentation J H :=
    pi.restrictClosedIdealGeneratedBy p
  let M : Submodule ℂ H := sigma.cyclicSubspace x
  let rho : NonUnitalCStarRepresentation J M := sigma.cyclicRestriction x
  let pJ : J := ⟨p, self_mem_closedIdealGeneratedBy p⟩
  let v : M := M.orthogonalProjectionOnto x
  change ∃ c : ℂ, rho pJ z = c • v
  have hxM : x ∈ M := by
    rw [← hpx]
    exact sigma.apply_mem_cyclicSubspace x pJ
  have hvEq : v = ⟨x, hxM⟩ := by
    exact M.orthogonalProjectionOnto_mem_subspace_eq_self ⟨x, hxM⟩
  have hvcoe : (v : H) = x := congrArg Subtype.val hvEq
  have hvfix : rho pJ v = v := by
    apply Subtype.ext
    change pi p (v : H) = (v : H)
    rw [hvcoe, hpx]
  let line : Submodule ℂ M :=
    LinearMap.range (ContinuousLinearMap.toSpanSingleton ℂ v).toLinearMap
  letI : FiniteDimensional ℂ line := by
    dsimp only [line]
    infer_instance
  have hlineClosed : IsClosed (line : Set M) :=
    Submodule.closed_of_finiteDimensional line
  have hcyclic : DenseRange (fun a : J => rho a v) := by
    exact pi.denseRange_restrictClosedIdealGeneratedByCyclic p x
  have hpLine (w : M) : rho pJ w ∈ line := by
    exact hcyclic.induction_on w
      (hlineClosed.preimage (rho pJ).continuous) fun a => by
        have hpp : p * p = p := hp.isStarProjection.isIdempotentElem.eq
        have hcorner : p * (p * a.1 * p) * p = p * a.1 * p := by
          calc
            p * (p * a.1 * p) * p = (p * p) * a.1 * (p * p) := by
              simp only [mul_assoc]
            _ = p * a.1 * p := by rw [hpp]
        obtain ⟨c, hc⟩ := hp.exists_eq_smul_of_mem_corner pi hpi hcorner
        have hcJ : pJ * a * pJ = c • pJ := by
          apply Subtype.ext
          exact hc
        have horbit : rho pJ (rho a v) = c • v := by
          calc
            rho pJ (rho a v) = (rho pJ * rho a) v := rfl
            _ = rho (pJ * a) v := by rw [map_mul]
            _ = rho (pJ * a) (rho pJ v) := by rw [hvfix]
            _ = (rho (pJ * a) * rho pJ) v := rfl
            _ = rho ((pJ * a) * pJ) v := by simp only [map_mul, mul_assoc]
            _ = rho (pJ * a * pJ) v := rfl
            _ = rho (c • pJ) v := by rw [hcJ]
            _ = (c • rho pJ) v := by rw [map_smul]
            _ = c • rho pJ v := rfl
            _ = c • v := by rw [hvfix]
        refine ⟨c, ?_⟩
        change c • v = rho pJ (rho a v)
        exact horbit.symm
  obtain ⟨c, hc⟩ := hpLine z
  change c • v = rho pJ z at hc
  exact ⟨c, hc.symm⟩

/-- The cyclic representation of the ideal generated by a minimal projection is
irreducible.  A reducing projection either kills the cyclic vector, hence is
zero by density, or has a nonzero component in the one-dimensional range of
the represented generator; in the latter case it contains the cyclic vector
and therefore the whole cyclic space. -/
theorem isIrreducible_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsMinimalStarProjection p) {x : H}
    (hx0 : x ≠ 0) (hpx : pi p x = x) :
    (pi.restrictClosedIdealGeneratedByCyclic p x).IsIrreducible := by
  let J := (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra
  let sigma : NonUnitalCStarRepresentation J H :=
    pi.restrictClosedIdealGeneratedBy p
  let M : Submodule ℂ H := sigma.cyclicSubspace x
  let rho : NonUnitalCStarRepresentation J M := sigma.cyclicRestriction x
  let pJ : J := ⟨p, self_mem_closedIdealGeneratedBy p⟩
  let v : M := M.orthogonalProjectionOnto x
  change rho.IsIrreducible
  have hxM : x ∈ M := by
    rw [← hpx]
    exact sigma.apply_mem_cyclicSubspace x pJ
  have hvEq : v = ⟨x, hxM⟩ := by
    exact M.orthogonalProjectionOnto_mem_subspace_eq_self ⟨x, hxM⟩
  have hvcoe : (v : H) = x := congrArg Subtype.val hvEq
  have hv0 : v ≠ 0 := by
    intro hv
    apply hx0
    calc
      x = (v : H) := hvcoe.symm
      _ = 0 := congrArg Subtype.val hv
  have hvfix : rho pJ v = v := by
    apply Subtype.ext
    change pi p (v : H) = (v : H)
    rw [hvcoe, hpx]
  have hcyclic : DenseRange (fun a : J => rho a v) := by
    exact pi.denseRange_restrictClosedIdealGeneratedByCyclic p x
  refine ⟨?_, ?_⟩
  · have hpx0 : pi p x ≠ 0 := by simpa only [hpx] using hx0
    exact pi.isNonzero_restrictClosedIdealGeneratedByCyclic_of_apply_ne_zero hpx0
  · intro L hL
    letI : IsClosed (L : Set M) := hL.1
    letI : CompleteSpace L := inferInstance
    letI : L.HasOrthogonalProjection := inferInstance
    let P : M →L[ℂ] M := L.starProjection
    have hPcomm (a : J) (w : M) : P (rho a w) = rho a (P w) := by
      have h := Representation.starProjection_commutes_of_reduces rho.unitization L
        (reduces_unitization_of_reduces rho L hL) (Unitization.inr a)
      simpa only [unitization_inr, ContinuousLinearMap.mul_apply] using
        congrArg (fun T : M →L[ℂ] M => T w) h
    let w : M := P v
    by_cases hw0 : w = 0
    · left
      have hPzero : P = 0 := by
        apply ContinuousLinearMap.ext
        intro z
        exact hcyclic.induction_on z (isClosed_eq P.continuous continuous_const) fun a => by
          rw [hPcomm]
          change rho a w = 0
          rw [hw0, map_zero]
      rw [← L.range_starProjection, show L.starProjection = 0 from hPzero]
      simp
    · right
      have hpw : rho pJ w = w := by
        calc
          rho pJ w = P (rho pJ v) := (hPcomm pJ v).symm
          _ = P v := by rw [hvfix]
          _ = w := rfl
      obtain ⟨c, hc⟩ :=
        pi.exists_eq_smul_projected_cyclic_vector_of_isMinimalStarProjection hpi hp hpx w
      have hwscalar : w = c • v := hpw.symm.trans hc
      have hc0 : c ≠ 0 := by
        intro hc0
        apply hw0
        rw [hwscalar, hc0, _root_.zero_smul ℂ v]
      have hwL : w ∈ L := L.starProjection_apply_mem v
      have hvL : v ∈ L := by
        have h := L.smul_mem c⁻¹ hwL
        rw [hwscalar, smul_smul, inv_mul_cancel₀ hc0, one_smul] at h
        exact h
      apply top_unique
      intro z hz
      exact hcyclic.induction_on z hL.1 fun a => (hL.2 a v hvL).1

/-- The cyclic representation of the ideal generated by a minimal projection is
faithful.  If an element acts as zero, all products `a b p` vanish by applying
the scalar-corner theorem to their positive squares.  These identities put the
generator in a norm-closed two-sided annihilator ideal; minimality of the
closed generated ideal then forces that annihilator to contain the whole
ideal, and the C-star identity gives `a = 0`. -/
theorem eq_zero_of_restrictClosedIdealGeneratedByCyclic_eq_zero
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsMinimalStarProjection p) {x : H}
    (hx0 : x ≠ 0) (hpx : pi p x = x)
    (a : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra)
    (ha : pi.restrictClosedIdealGeneratedByCyclic p x a = 0) : a = 0 := by
  let J := (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra
  let sigma : NonUnitalCStarRepresentation J H :=
    pi.restrictClosedIdealGeneratedBy p
  let M : Submodule ℂ H := sigma.cyclicSubspace x
  let rho : NonUnitalCStarRepresentation J M := sigma.cyclicRestriction x
  let pJ : J := ⟨p, self_mem_closedIdealGeneratedBy p⟩
  let v : M := M.orthogonalProjectionOnto x
  change rho a = 0 at ha
  have hxM : x ∈ M := by
    rw [← hpx]
    exact sigma.apply_mem_cyclicSubspace x pJ
  have hvEq : v = ⟨x, hxM⟩ := by
    exact M.orthogonalProjectionOnto_mem_subspace_eq_self ⟨x, hxM⟩
  have hvcoe : (v : H) = x := congrArg Subtype.val hvEq
  have hv0 : v ≠ 0 := by
    intro hv
    apply hx0
    calc
      x = (v : H) := hvcoe.symm
      _ = 0 := congrArg Subtype.val hv
  have hvfix : rho pJ v = v := by
    apply Subtype.ext
    change pi p (v : H) = (v : H)
    rw [hvcoe, hpx]
  have hpp : p * p = p := hp.isStarProjection.isIdempotentElem.eq
  have hpSelf : IsSelfAdjoint p := hp.isStarProjection.isSelfAdjoint
  have habp (b : A) : a.1 * b * p = 0 := by
    let bpJ : J :=
      ⟨b * p, (closedIdealGeneratedBy p).mul_mem_left b
        (self_mem_closedIdealGeneratedBy p)⟩
    let eJ : J := a * bpJ
    let dJ : J := star eJ * eJ
    have heRho : rho eJ = 0 := by
      dsimp only [eJ]
      rw [map_mul, ha, zero_mul]
    have hdRho : rho dJ = 0 := by
      dsimp only [dJ]
      rw [map_mul, map_star, heRho, star_zero, zero_mul]
    have hep : eJ.1 * p = eJ.1 := by
      change (a.1 * (b * p)) * p = a.1 * (b * p)
      simp only [mul_assoc, hpp]
    have hpstar : p * star eJ.1 = star eJ.1 := by
      have h := congrArg star hep
      simpa only [star_mul, hpSelf.star_eq, star_star] using h
    have hdcorner : p * (star eJ.1 * eJ.1) * p = star eJ.1 * eJ.1 := by
      calc
        p * (star eJ.1 * eJ.1) * p =
            (p * star eJ.1) * (eJ.1 * p) := by simp only [mul_assoc]
        _ = star eJ.1 * eJ.1 := by rw [hpstar, hep]
    obtain ⟨c, hc⟩ := hp.exists_eq_smul_of_mem_corner pi hpi hdcorner
    have hcJ : dJ = c • pJ := by
      apply Subtype.ext
      exact hc
    have hcOp : c • rho pJ = 0 := by
      calc
        c • rho pJ = rho (c • pJ) := by rw [map_smul]
        _ = rho dJ := by rw [← hcJ]
        _ = 0 := hdRho
    have hcv : c • v = 0 := by
      have h := congrArg (fun T : M →L[ℂ] M => T v) hcOp
      simpa only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.zero_apply,
        hvfix] using h
    have hc0 : c = 0 := (smul_eq_zero.mp hcv).resolve_right hv0
    have hd0 : star eJ.1 * eJ.1 = 0 := by
      simpa only [hc0, _root_.zero_smul ℂ p] using hc
    have he0 : eJ.1 = 0 := (CStarRing.star_mul_self_eq_zero_iff eJ.1).mp hd0
    change a.1 * (b * p) = 0 at he0
    simpa only [mul_assoc] using he0
  have hap : a.1 * p = 0 := by
    have h := habp p
    simpa only [mul_assoc, hpp] using h
  let K : ClosedStarIdeal A := twoSidedLeftAnnihilator a.1
  have hpK : p ∈ K.toNonUnitalStarSubalgebra := by
    change MemTwoSidedLeftAnnihilator a.1 p
    refine ⟨hap, ?_, ?_⟩
    · simpa only [hpSelf.star_eq] using hap
    · intro b
      exact ⟨habp b, by simpa only [hpSelf.star_eq] using habp b⟩
  have hJK : J ≤ K.toNonUnitalStarSubalgebra :=
    closedIdealGeneratedBy_le p K hpK
  have hstarJ : star a.1 ∈ J := StarMemClass.star_mem a.2
  have hstarK := hJK hstarJ
  change MemTwoSidedLeftAnnihilator a.1 (star a.1) at hstarK
  apply Subtype.ext
  exact (CStarRing.mul_star_self_eq_zero_iff (a : A)).mp hstarK.1

/-- Faithfulness of the concrete generated-ideal cyclic representation. -/
theorem injective_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsMinimalStarProjection p) {x : H}
    (hx0 : x ≠ 0) (hpx : pi p x = x) :
    Function.Injective (pi.restrictClosedIdealGeneratedByCyclic p x) := by
  intro a b hab
  have hzero : pi.restrictClosedIdealGeneratedByCyclic p x (a - b) = 0 := by
    rw [map_sub, hab, sub_self]
  exact sub_eq_zero.mp
    (pi.eq_zero_of_restrictClosedIdealGeneratedByCyclic_eq_zero
      hpi hp hx0 hpx (a - b) hzero)

/-- The actual cyclic representation of the closed ideal generated by a
minimal projection is an exact compact-operator model.  Faithfulness,
irreducibility, and compactness all refer to this same representation. -/
theorem isCompactOperatorModel_restrictClosedIdealGeneratedByCyclic
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented) {p : A}
    (hp : IsMinimalStarProjection p) {x : H}
    (hx0 : x ≠ 0) (hpx : pi p x = x) :
    IsCompactOperatorModel (pi.restrictClosedIdealGeneratedByCyclic p x) :=
  (pi.restrictClosedIdealGeneratedByCyclic p x).isCompactOperatorModel_of_injective_of_isIrreducible_of_isCompactOperator
      (pi.injective_restrictClosedIdealGeneratedByCyclic hpi hp hx0 hpx)
      (pi.isIrreducible_restrictClosedIdealGeneratedByCyclic hpi hp hx0 hpx)
      (pi.isCompactOperator_restrictClosedIdealGeneratedByCyclic hpi p x)

end NonUnitalCStarRepresentation

/-- The minimal compact corner selected in a nonzero closed ideal generates a
nonzero closed subideal of that ideal and retains the same faithful compact
representation.  This theorem records the pre-cyclic restriction; the later
compact-model theorem closes the faithful irreducible cyclic realization. -/
theorem exists_isMinimalStarProjection_generated_subideal
    (I : ClosedStarIdeal A)
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented)
    (hI0 : ∃ x : I.toNonUnitalStarSubalgebra, x ≠ 0) :
    ∃ p : A,
      p ∈ I.toNonUnitalStarSubalgebra ∧
      IsMinimalStarProjection p ∧
      (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra ≤
        I.toNonUnitalStarSubalgebra ∧
      (pi.restrictClosedIdealGeneratedBy p).IsCompactlyRepresented ∧
      ∃ x : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra, x ≠ 0 := by
  obtain ⟨p, hpI, hpmin, -⟩ :=
    I.exists_isMinimalStarProjection_mem pi hpi hI0
  refine ⟨p, hpI, hpmin,
    closedIdealGeneratedBy_le p I hpI,
    pi.isCompactlyRepresented_restrictClosedIdealGeneratedBy hpi p,
    exists_ne_zero_mem_closedIdealGeneratedBy hpmin.ne_zero⟩

/-- The minimal projection selected in a nonzero closed ideal has scalar
corner and a fixed nonzero cyclic vector for an actual generated-subideal
representation consisting only of compact operators.  This intermediate
statement does not itself assert faithfulness or irreducibility; both are
supplied for the same representation by the subsequent compact-model theorem. -/
theorem exists_isMinimalStarProjection_generated_subideal_cyclicRepresentation
    (I : ClosedStarIdeal A)
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented)
    (hI0 : ∃ x : I.toNonUnitalStarSubalgebra, x ≠ 0) :
    ∃ p : A,
      p ∈ I.toNonUnitalStarSubalgebra ∧
      IsMinimalStarProjection p ∧
      (∀ a : A, p * a * p = a → ∃ c : ℂ, a = c • p) ∧
      (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra ≤
        I.toNonUnitalStarSubalgebra ∧
      ∃ x : H,
        x ≠ 0 ∧ pi p x = x ∧
        (pi.restrictClosedIdealGeneratedByCyclic p x).IsNonzero ∧
        ∀ a : (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra,
          IsCompactOperator (pi.restrictClosedIdealGeneratedByCyclic p x a) := by
  obtain ⟨p, hpI, hpmin, hle, -, -⟩ :=
    exists_isMinimalStarProjection_generated_subideal I pi hpi hI0
  obtain ⟨x, hx0, hpx, hnonzero, hcompact⟩ :=
    pi.exists_fixed_nonzero_compact_restrictClosedIdealGeneratedByCyclic
      hpi hpmin.isStarProjection hpmin.ne_zero
  exact ⟨p, hpI, hpmin,
    fun a ha ↦ hpmin.exists_eq_smul_of_mem_corner pi hpi ha,
    hle, x, hx0, hpx, hnonzero, hcompact⟩

/-- Every nonzero closed ideal in a faithfully compactly represented algebra
contains the closed ideal generated by an ambient minimal projection, and that
generated ideal has an actual exact compact-operator model on its cyclic space.
The model is not obtained by adding faithfulness or irreducibility as
hypotheses: both were proved above for the displayed cyclic restriction. -/
theorem exists_isMinimalStarProjection_generated_subideal_compactOperatorModel
    (I : ClosedStarIdeal A)
    (pi : NonUnitalCStarRepresentation A H)
    (hpi : pi.IsCompactlyRepresented)
    (hI0 : ∃ x : I.toNonUnitalStarSubalgebra, x ≠ 0) :
    ∃ p : A,
      p ∈ I.toNonUnitalStarSubalgebra ∧
      IsMinimalStarProjection p ∧
      (closedIdealGeneratedBy p).toNonUnitalStarSubalgebra ≤
        I.toNonUnitalStarSubalgebra ∧
      ∃ x : H,
        x ≠ 0 ∧ pi p x = x ∧
        IsCompactOperatorModel
          (pi.restrictClosedIdealGeneratedByCyclic p x) := by
  obtain ⟨p, hpI, hpmin, hle, -, -⟩ :=
    exists_isMinimalStarProjection_generated_subideal I pi hpi hI0
  obtain ⟨x, hx0, hpx, -, -⟩ :=
    pi.exists_fixed_nonzero_compact_restrictClosedIdealGeneratedByCyclic
      hpi hpmin.isStarProjection hpmin.ne_zero
  exact ⟨p, hpI, hpmin, hle, x, hx0, hpx,
    pi.isCompactOperatorModel_restrictClosedIdealGeneratedByCyclic
      hpi hpmin hx0 hpx⟩

end MathlibAnnex.Analysis.CStarAlgebra
