/-!
# Primitive separation of a point from a closed ideal

For a closed two-sided ideal `J` of a possibly nonunital complex C-star
algebra and `a ∉ J`, Hahn--Banach first gives a functional annihilating `J`
and detecting `a`.  The existing coefficient realization of that functional
is used only as an auxiliary representation.  Its auxiliary matrix state is
proved to annihilate the pointwise matrix ideal generated by the unitization
of `J`; hence the resulting representation kills `J` and still detects `a`.

A unit vector on which `a` acts nontrivially then gives a genuine state of the
unitization, annihilating the unitized ideal and positive on `a⋆a`.  The
existing maximizing-face theorem replaces it by a pure state without losing
that value.  The GNS representation of the pure state, restricted to the
original algebra, is the required nonzero irreducible separator.

No C-star quotient by an arbitrary ideal, Pedersen separation theorem,
separability, or unit is assumed.
-/

set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section

open Set Filter Topology BoundedContinuousFunction
open scoped CStarAlgebra ComplexOrder InnerProduct BigOperators

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u

section HahnBanachRepresentation

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- The Hahn--Banach quotient functional separating `a` from `J`. -/
def idealSeparatorFunctional (J : TwoSidedIdeal A)
    (hJ : IsClosed (J : Set A)) (a : A) (ha : a ∉ J) : StrongDual ℂ A := by
  let M := (MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)
  letI : IsClosed (M : Set A) := hJ
  let q : A →L[ℂ] A ⧸ M := M.mkQL
  have hqa : q a ≠ 0 := by
    intro hzero
    apply ha
    exact (Submodule.Quotient.mk_eq_zero M).mp hzero
  have hqanorm : ‖q a‖ ≠ 0 := norm_ne_zero_iff.mpr hqa
  exact (exists_dual_vector ℂ (q a) hqanorm).choose.comp q

/-- The separator annihilates the ideal. -/
theorem idealSeparatorFunctional_eq_zero_of_mem
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) {j : A} (hj : j ∈ J) :
    idealSeparatorFunctional J hJ a ha j = 0 := by
  let M := (MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)
  letI : IsClosed (M : Set A) := hJ
  let q : A →L[ℂ] A ⧸ M := M.mkQL
  have hqa : q a ≠ 0 := by
    intro hzero
    exact ha ((Submodule.Quotient.mk_eq_zero M).mp hzero)
  have hqanorm : ‖q a‖ ≠ 0 := norm_ne_zero_iff.mpr hqa
  change (exists_dual_vector ℂ (q a) hqanorm).choose (q j) = 0
  have hqj : q j = 0 := (Submodule.Quotient.mk_eq_zero M).mpr hj
  rw [hqj, map_zero]

/-- The separator takes the positive real quotient norm at the specified point. -/
theorem idealSeparatorFunctional_apply
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) :
    idealSeparatorFunctional J hJ a ha a =
      (‖(((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)).mkQ a : A ⧸ ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)))‖ : ℂ) := by
  let M := (MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)
  letI : IsClosed (M : Set A) := hJ
  let q : A →L[ℂ] A ⧸ M := M.mkQL
  have hqa : q a ≠ 0 := by
    intro hzero
    exact ha ((Submodule.Quotient.mk_eq_zero M).mp hzero)
  have hqanorm : ‖q a‖ ≠ 0 := norm_ne_zero_iff.mpr hqa
  change (exists_dual_vector ℂ (q a) hqanorm).choose (q a) = _
  exact (exists_dual_vector ℂ (q a) hqanorm).choose_spec.2

/-- The separator is genuinely nonzero. -/
theorem idealSeparatorFunctional_ne_zero
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) : idealSeparatorFunctional J hJ a ha ≠ 0 := by
  intro hzero
  let M := MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ
  letI : IsClosed (M : Set A) := hJ
  have hqa : (((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)).mkQ a : A ⧸ ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ))) ≠ 0 := by
    intro h
    exact ha ((Submodule.Quotient.mk_eq_zero ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ))).mp h)
  have hnormC :
      (‖(((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)).mkQ a : A ⧸ ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)))‖ : ℂ) ≠ 0 := by
    exact_mod_cast norm_ne_zero_iff.mpr hqa
  have hv := idealSeparatorFunctional_apply J hJ a ha
  rw [hzero, ContinuousLinearMap.zero_apply] at hv
  exact hnormC hv.symm

/-- The actual auxiliary coefficient representation annihilates `J`.  This is
proved through the pointwise matrix ideal, not inferred from one coefficient. -/
theorem idealSeparatorRepresentation_eq_zero_of_mem
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) {j : A} (hj : j ∈ J) :
    NonUnitalFunctional.representation
      (idealSeparatorFunctional J hJ a ha)
      (idealSeparatorFunctional_ne_zero J hJ a ha) j = 0 := by
  let rho := idealSeparatorFunctional J hJ a ha
  have hrho : rho ≠ 0 := idealSeparatorFunctional_ne_zero J hJ a ha
  let F := unitizationDualExtension rho
  have hF : F ≠ 0 := unitizationDualExtension_ne_zero hrho
  letI : PartialOrder (ℕ →ᵇ Unitization ℂ A) := CStarAlgebra.spectralOrder _
  letI : StarOrderedRing (ℕ →ᵇ Unitization ℂ A) := CStarAlgebra.spectralOrderedRing _
  letI : PartialOrder
      (MathlibAnnex.FunctionalCoefficient.AuxiliaryMatrixAlgebra (Unitization ℂ A)) :=
    CStarAlgebra.spectralOrder _
  letI : StarOrderedRing
      (MathlibAnnex.FunctionalCoefficient.AuxiliaryMatrixAlgebra (Unitization ℂ A)) :=
    CStarAlgebra.spectralOrderedRing _
  let JU := unitizationIdeal J hJ
  let K := auxiliaryMatrixIdeal JU
  have hFann : ∀ z : Unitization ℂ A, z ∈ JU → F z = 0 := by
    intro z hz
    rw [eq_inr_snd_of_mem_unitizationIdeal J hJ hz,
      unitizationDualExtension_inr]
    exact idealSeparatorFunctional_eq_zero_of_mem J hJ a ha
      ((mem_unitizationIdeal_iff J hJ z).1 hz).2
  have haux : ∀ M : MathlibAnnex.FunctionalCoefficient.AuxiliaryMatrixAlgebra
      (Unitization ℂ A), M ∈ K →
      MathlibAnnex.FunctionalCoefficient.auxiliaryState F M = 0 := by
    intro M hM
    exact auxiliaryState_eq_zero_of_mem_auxiliaryMatrixIdeal F JU hFann hM
  have hdiag : MathlibAnnex.FunctionalCoefficient.diagonalConstants
      (Unitization.inr j) ∈ K :=
    diagonalConstants_mem_auxiliaryMatrixIdeal JU
      ((inr_mem_unitizationIdeal_iff J hJ j).2 hj)
  have hz := MathlibAnnex.Analysis.CStarAlgebra.gnsStarAlgHom_eq_zero_of_mem
    (A := MathlibAnnex.FunctionalCoefficient.AuxiliaryMatrixAlgebra (Unitization ℂ A))
    (phi := MathlibAnnex.FunctionalCoefficient.auxiliaryState F)
    (hphi := MathlibAnnex.FunctionalCoefficient.auxiliaryState_mem F hF)
    (I := K) (hann := haux)
    (x := MathlibAnnex.FunctionalCoefficient.diagonalConstants (Unitization.inr j))
    (hx := hdiag)
  change (MathlibAnnex.FunctionalCoefficient.positive F hF).gnsStarAlgHom
    (MathlibAnnex.FunctionalCoefficient.diagonalConstants (Unitization.inr j)) = 0
  exact hz

/-- The same auxiliary representation still detects the chosen point. -/
theorem idealSeparatorRepresentation_apply_ne_zero
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) :
    NonUnitalFunctional.representation
      (idealSeparatorFunctional J hJ a ha)
      (idealSeparatorFunctional_ne_zero J hJ a ha) a ≠ 0 := by
  let rho := idealSeparatorFunctional J hJ a ha
  have hrho : rho ≠ 0 := idealSeparatorFunctional_ne_zero J hJ a ha
  intro hzero
  have hv := NonUnitalFunctional.recover rho hrho a
  rw [hzero, ContinuousLinearMap.zero_apply, inner_zero_right, mul_zero] at hv
  have hsep := idealSeparatorFunctional_apply J hJ a ha
  rw [hv] at hsep
  let M := MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ
  letI : IsClosed (M : Set A) := hJ
  have hqa : (((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)).mkQ a : A ⧸ ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ))) ≠ 0 := by
    intro h
    exact ha ((Submodule.Quotient.mk_eq_zero ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ))).mp h)
  have hnormC :
      (‖(((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)).mkQ a : A ⧸ ((MathlibAnnex.Analysis.CStarAlgebra.TwoSidedIdeal.closedComplexSubmodule J hJ)))‖ : ℂ) ≠ 0 := by
    exact_mod_cast norm_ne_zero_iff.mpr hqa
  exact hnormC hsep.symm

end HahnBanachRepresentation

section PureSeparator

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- A pure state of the unitization, positive on the specified square and
annihilating the copy of `J`. -/
theorem exists_pureState_unitization_annihilating_ideal
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) :
    ∃ phi : StrongDual ℂ (Unitization ℂ A),
      phi ∈ stateSpace (Unitization ℂ A) ∧
      IsPureState (Unitization ℂ A) phi ∧
      (∀ z : Unitization ℂ A, z ∈ unitizationIdeal J hJ → phi z = 0) ∧
      0 < (phi (star (Unitization.inr a) * Unitization.inr a)).re := by
  let f := idealSeparatorFunctional J hJ a ha
  have hf : f ≠ 0 := idealSeparatorFunctional_ne_zero J hJ a ha
  let pi := NonUnitalFunctional.representation f hf
  have hpa : pi a ≠ 0 := idealSeparatorRepresentation_apply_ne_zero J hJ a ha
  obtain ⟨x, hx⟩ : ∃ x : NonUnitalFunctional.HilbertSpace f hf, pi a x ≠ 0 := by
    by_contra h
    push_neg at h
    apply hpa
    ext x
    exact h x
  have hx0 : x ≠ 0 := by
    intro hzero
    rw [hzero, map_zero] at hx
    exact hx rfl
  let y : NonUnitalFunctional.HilbertSpace f hf := (‖x‖ : ℂ)⁻¹ • x
  have hy : ‖y‖ = 1 := by
    have hxn : 0 < ‖x‖ := norm_pos_iff.mpr hx0
    rw [norm_smul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hxn, inv_mul_cancel₀ hxn.ne']
  have hpay : pi a y ≠ 0 := by
    intro hzero
    change pi a ((‖x‖ : ℂ)⁻¹ • x) = 0 at hzero
    rw [map_smul] at hzero
    rcases smul_eq_zero.mp hzero with hscalar | hvec
    · exact (by
        have : ((‖x‖ : ℂ)⁻¹) ≠ 0 := inv_ne_zero (by exact_mod_cast norm_ne_zero_iff.mpr hx0)
        exact this hscalar)
    · exact hx hvec
  let psi : WeakDual ℂ (Unitization ℂ A) :=
    StrongDual.toWeakDual (Representation.vectorFunctional pi.unitization y)
  have hpsiState : psi ∈ weakStateSpace (Unitization ℂ A) :=
    vectorFunctional_unitization_mem_weakStateSpace pi hy
  have hpiJ (z : Unitization ℂ A) (hz : z ∈ unitizationIdeal J hJ) :
      pi.unitization z = 0 := by
    rw [eq_inr_snd_of_mem_unitizationIdeal J hJ hz,
      NonUnitalCStarRepresentation.unitization_inr,
      idealSeparatorRepresentation_eq_zero_of_mem J hJ a ha
        ((mem_unitizationIdeal_iff J hJ z).1 hz).2]
  have hpsiAnn : ∀ z : Unitization ℂ A, z ∈ unitizationIdeal J hJ → psi z = 0 := by
    intro z hz
    change inner ℂ y (pi.unitization z y) = 0
    rw [hpiJ z hz, ContinuousLinearMap.zero_apply, inner_zero_right]
  have hpsiFace : psi ∈ weakStateFace (unitizationIdeal J hJ) :=
    ⟨hpsiState, hpsiAnn⟩
  have hpos : 0 < (psi (star (Unitization.inr a) * Unitization.inr a)).re := by
    rw [show psi (star (Unitization.inr a) * Unitization.inr a) =
      (‖pi a y‖ ^ 2 : ℝ) by
        exact vectorFunctional_unitization_star_inr_mul_inr pi y a]
    simp only [Complex.ofReal_re]
    exact sq_pos_of_pos (norm_pos_iff.mpr hpay)
  obtain ⟨phi, hphi, hpure, hann, _hdom, hpositive⟩ :=
    exists_pureState_annihilating_of_pos_weakStateFace
      (unitizationIdeal J hJ) (star (Unitization.inr a) * Unitization.inr a)
      psi hpsiFace hpos
  exact ⟨phi, hphi, hpure, hann, hpositive⟩

/-- A pure unitization state with positive value on `a⋆a`, annihilating the
unitization ideal, yields the actual irreducible separator on the original
possibly nonunital algebra. -/
theorem pureState_restriction_separator
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A)) (a : A)
    (phi : StrongDual ℂ (Unitization ℂ A))
    (hphi : phi ∈ stateSpace (Unitization ℂ A))
    (hpure : IsPureState (Unitization ℂ A) phi)
    (hann : ∀ z : Unitization ℂ A, z ∈ unitizationIdeal J hJ → phi z = 0)
    (hpos : 0 < (phi (star (Unitization.inr a) * Unitization.inr a)).re) :
    let f := positiveLinearMapOfMemStateSpace phi hphi
    let rho := f.gnsStarAlgHom.toNonUnitalStarAlgHom.comp
      (Unitization.inrNonUnitalStarAlgHom ℂ A)
    NonUnitalCStarRepresentation.IsIrreducible rho ∧ rho a ≠ 0 ∧
      ∀ j : A, j ∈ J → rho j = 0 := by
  let f := positiveLinearMapOfMemStateSpace phi hphi
  let rhoU : Representation (Unitization ℂ A) f.GNS := f.gnsStarAlgHom
  let rho : NonUnitalCStarRepresentation A f.GNS :=
    rhoU.toNonUnitalStarAlgHom.comp (Unitization.inrNonUnitalStarAlgHom ℂ A)
  have hxi : ‖stateGNSVector phi hphi‖ = 1 := norm_stateGNSVector phi hphi
  have hxi0 : stateGNSVector phi hphi ≠ 0 := by
    intro hzero
    rw [hzero, norm_zero] at hxi
    exact zero_ne_one hxi
  letI : Nontrivial f.GNS := nontrivial_of_ne (stateGNSVector phi hphi) 0 hxi0
  have hrhoU : rhoU.IsIrreducible := by
    apply (Representation.isIrreducible_iff_starAlgHom rhoU).2
    exact isIrreducible_pureState_gnsStarAlgHom phi hphi hpure
  have hrhoa : rho a ≠ 0 := by
    intro hzero
    have hinr : rhoU (Unitization.inr a) = 0 := hzero
    have hb : rhoU (star (Unitization.inr a) * Unitization.inr a) = 0 := by
      rw [map_mul, map_star, hinr, mul_zero]
    have hv : phi (star (Unitization.inr a) * Unitization.inr a) = 0 := by
      rw [← inner_gnsStarAlgHom_stateGNSVector phi hphi]
      change inner ℂ (stateGNSVector phi hphi)
        (rhoU (star (Unitization.inr a) * Unitization.inr a)
          (stateGNSVector phi hphi)) = 0
      rw [hb, ContinuousLinearMap.zero_apply, inner_zero_right]
    rw [hv, Complex.zero_re] at hpos
    exact (lt_irrefl 0) hpos
  refine ⟨NonUnitalCStarRepresentation.isIrreducible_restriction_of_isIrreducible_unitization
    rhoU hrhoU ⟨a, hrhoa⟩, hrhoa, ?_⟩
  intro j hj
  exact gnsStarAlgHom_eq_zero_of_mem phi hphi (unitizationIdeal J hJ) hann
    ((inr_mem_unitizationIdeal_iff J hJ j).2 hj)

/-- A point outside a norm-closed two-sided ideal is separated by an actual
nonzero irreducible representation annihilating that ideal. -/
theorem exists_isIrreducible_annihilating_ideal_of_not_mem
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) :
    ∃ (H : Type u) (instN : NormedAddCommGroup H),
      letI := instN
      ∃ instI : InnerProductSpace ℂ H,
        letI := instI
        ∃ instC : CompleteSpace H,
          letI := instC
          ∃ rho : NonUnitalCStarRepresentation A H,
            NonUnitalCStarRepresentation.IsIrreducible rho ∧ rho a ≠ 0 ∧
              ∀ j : A, j ∈ J → rho j = 0 := by
  obtain ⟨phi, hphi, hpure, hann, hpos⟩ :=
    exists_pureState_unitization_annihilating_ideal J hJ a ha
  let f := positiveLinearMapOfMemStateSpace phi hphi
  exact ⟨f.GNS, inferInstance, inferInstance, inferInstance,
    f.gnsStarAlgHom.toNonUnitalStarAlgHom.comp
      (Unitization.inrNonUnitalStarAlgHom ℂ A),
    pureState_restriction_separator J hJ a phi hphi hpure hann hpos⟩

/-- Kernel formulation used by primitive-ideal arguments. -/
theorem exists_isIrreducible_ker_ge_and_apply_ne_zero
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A))
    (a : A) (ha : a ∉ J) :
    ∃ (H : Type u) (instN : NormedAddCommGroup H),
      letI := instN
      ∃ instI : InnerProductSpace ℂ H,
        letI := instI
        ∃ instC : CompleteSpace H,
          letI := instC
          ∃ rho : NonUnitalCStarRepresentation A H,
            NonUnitalCStarRepresentation.IsIrreducible rho ∧ J ≤ TwoSidedIdeal.ker rho ∧ rho a ≠ 0 := by
  obtain ⟨H, instN, instI, instC, rho, hirr, ha0, hJrho⟩ :=
    exists_isIrreducible_annihilating_ideal_of_not_mem J hJ a ha
  refine ⟨H, instN, instI, instC, rho, hirr, ?_, ha0⟩
  intro j hj
  exact (TwoSidedIdeal.mem_ker rho).mpr (hJrho j hj)


/-- A norm-closed two-sided ideal is exactly the common kernel condition for
all irreducible representations that annihilate it.  Quantification is over
actual Hilbert spaces and actual representations; no primitive-spectrum
quotient is used. -/
theorem mem_iff_forall_isIrreducible_of_ker_ge
    (J : TwoSidedIdeal A) (hJ : IsClosed (J : Set A)) (a : A) :
    a ∈ J ↔
      ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
        [CompleteSpace H] (rho : NonUnitalCStarRepresentation A H),
        NonUnitalCStarRepresentation.IsIrreducible rho → J ≤ TwoSidedIdeal.ker rho → rho a = 0 := by
  constructor
  · intro ha H _ _ _ rho _hirr hJrho
    have hz := hJrho ha
    exact (TwoSidedIdeal.mem_ker rho).mp hz
  · intro hall
    by_contra ha
    obtain ⟨H, instN, instI, instC, rho, hirr, hJrho, hne⟩ :=
      exists_isIrreducible_ker_ge_and_apply_ne_zero J hJ a ha
    letI : NormedAddCommGroup H := instN
    letI : InnerProductSpace ℂ H := instI
    letI : CompleteSpace H := instC
    exact hne (hall H rho hirr hJrho)

end PureSeparator

end MathlibAnnex.Analysis.CStarAlgebra
