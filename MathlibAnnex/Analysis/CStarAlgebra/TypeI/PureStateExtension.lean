import MathlibAnnex.Analysis.CStarAlgebra.State.Extension
import MathlibAnnex.Analysis.CStarAlgebra.Representation.CyclicRestriction

/-!
# Extending arbitrary pure states of closed unital subalgebras

The inclusion has the same unit. Hahn--Banach first gives a state extension;
the inverse image of a pure state under restriction is then a compact face.
An extreme point of this face is a pure ambient state. No multiplicativity
of the prescribed state is assumed.
-/

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1000000

open Metric Set
open scoped ComplexOrder Convex InnerProduct

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v w

variable {A : Type u} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

local instance restriction_fiber_isScalarTower : IsScalarTower ℝ ℂ (WeakDual ℂ A) :=
  inferInstanceAs (IsScalarTower ℝ ℂ (StrongDual ℂ A))

local instance restriction_fiber_locallyConvexSpace : LocallyConvexSpace ℝ (WeakDual ℂ A) :=
  inferInstanceAs (LocallyConvexSpace ℝ (WeakBilin (topDualPairing ℂ A)))

/-- The fiber of restriction over a prescribed functional on a unital star
subalgebra, inside the actual weak-star state space of the ambient algebra. -/
def weakStateRestrictionFiber (D : StarSubalgebra ℂ A) (phi : D →L[ℂ] ℂ) :
    Set (WeakDual ℂ A) :=
  {psi | psi ∈ weakStateSpace A ∧ ∀ d : D, psi d = phi d}

/-- The restriction equations are closed in the weak-star topology. -/
theorem isClosed_weakStateRestrictionFiber
    (D : StarSubalgebra ℂ A) (phi : D →L[ℂ] ℂ) :
    IsClosed (weakStateRestrictionFiber D phi) := by
  simp only [weakStateRestrictionFiber, setOf_and, setOf_forall]
  exact isClosed_weakStateSpace.inter
    (isClosed_iInter fun d =>
      isClosed_eq (WeakDual.eval_continuous (d : A)) continuous_const)

/-- The actual weak-star restriction fiber is compact. -/
theorem isCompact_weakStateRestrictionFiber
    (D : StarSubalgebra ℂ A) (phi : D →L[ℂ] ℂ) :
    IsCompact (weakStateRestrictionFiber D phi) := by
  apply (WeakDual.isCompact_closedBall (𝕜 := ℂ) (E := A) 0 1).of_isClosed_subset
    (isClosed_weakStateRestrictionFiber D phi)
  intro psi hpsi
  simpa only [mem_preimage, mem_closedBall_zero_iff] using
    norm_le_one_of_mem_weakStateSpace hpsi.1

/-- Equality of vector states embeds a cyclic representation isometrically
into the cyclic subspace generated by the target vector. Neither target
cyclicity nor separability is required. -/
theorem Representation.exists_isometry_of_eq_vector_state
    {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {K : Type w} [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
    (pi : Representation A H) (rho : Representation A K) (xi : H) (eta : K)
    (hcyclic : DenseRange (StarAlgHom.orbitMap pi xi))
    (hstate : ∀ a, inner ℂ xi (pi a xi) = inner ℂ eta (rho a eta)) :
    ∃ U : H →ₗᵢ[ℂ] K, U xi = eta ∧ ∀ a x, U (pi a x) = rho a (U x) := by
  let M := Representation.cyclicSubspace rho eta
  letI : CompleteSpace M :=
    (Representation.isClosed_cyclicSubspace rho eta).completeSpace_coe
  let z : M := ⟨eta, Representation.self_mem_cyclicSubspace rho eta⟩
  let tau : Representation A M := Representation.restrictToReducing rho M
    (Representation.reduces_cyclicSubspace rho eta)
  have htarget : DenseRange (StarAlgHom.orbitMap tau z) :=
    Representation.denseRange_orbitMap_restrictCyclic rho eta
  have hcoeff (a : A) : inner ℂ xi (pi a xi) = inner ℂ z (tau a z) := by
    exact hstate a
  obtain ⟨W, hW, -⟩ := StarAlgHom.existsUnique_pointedCyclicTransport
    pi tau xi z hcyclic htarget hcoeff
  let U : H →ₗᵢ[ℂ] K := M.subtypeₗᵢ.comp W.toLinearIsometry
  refine ⟨U, ?_, ?_⟩
  · exact congrArg Subtype.val hW.2.1
  · intro a x
    have hx := congrArg (fun T : H →L[ℂ] M => T x) (hW.2.2 a)
    exact congrArg Subtype.val hx

section ClosedSubalgebra

variable (D : StarSubalgebra ℂ A) [IsClosed (D : Set A)]
variable [ordD : PartialOrder D] [StarOrderedRing D]

/-- An arbitrary state on a closed unital star subalgebra has a state
extension with the same values on every element of that subalgebra. -/
theorem exists_state_extension_of_mem_stateSpace [Nontrivial A]
    (phi : D →L[ℂ] ℂ) (hphi : phi ∈ stateSpace D) :
    ∃ psi : A →L[ℂ] ℂ, psi ∈ stateSpace A ∧ ∀ d : D, psi d = phi d := by
  let p : Submodule ℂ A := D.toSubalgebra.toSubmodule
  let f : StrongDual ℂ p := phi
  obtain ⟨psi, hext, hnorm⟩ := exists_extension_norm_eq p f
  have hpsi_one : psi 1 = 1 := by
    calc
      psi 1 = f (⟨1, D.one_mem⟩ : p) := hext (⟨1, D.one_mem⟩ : p)
      _ = 1 := hphi.2
  have hpsi_norm : ‖psi‖ ≤ 1 := by
    rw [hnorm]
    change ‖phi‖ ≤ 1
    exact norm_le_one_of_mem_weakStateSpace (phi := StrongDual.toWeakDual phi) hphi
  refine ⟨psi, ⟨nonnegative_of_norm_le_one_of_apply_one psi hpsi_norm hpsi_one,
    hpsi_one⟩, ?_⟩
  intro d
  simpa [p, f] using hext (show p from d)

/-- A state supplies an actual point of its weak-star extension fiber. -/
theorem weakStateRestrictionFiber_nonempty [Nontrivial A]
    (phi : D →L[ℂ] ℂ) (hphi : phi ∈ stateSpace D) :
    (weakStateRestrictionFiber D phi).Nonempty := by
  obtain ⟨psi, hpsi, hext⟩ := exists_state_extension_of_mem_stateSpace D phi hphi
  exact ⟨StrongDual.toWeakDual psi, hpsi, hext⟩

/-- The restriction fiber over a pure state is a face. The proof restricts
both endpoints of each nontrivial convex decomposition to the subalgebra. -/
theorem isExtreme_weakStateRestrictionFiber
    (phi : D →L[ℂ] ℂ) (hphi : IsPureState D phi) :
    IsExtreme ℝ (weakStateSpace A) (weakStateRestrictionFiber D phi) := by
  have coe_nonnegative {d : D} (hd : @LE.le D ordD.toLE 0 d) : 0 ≤ (d : A) := by
    rw [StarOrderedRing.nonneg_iff] at hd
    induction hd using AddSubmonoid.closure_induction with
    | mem x hx =>
        obtain ⟨y, rfl⟩ := hx
        simpa using star_mul_self_nonneg (y : A)
    | zero => simp
    | add x y _ _ hx hy =>
        simpa using add_nonneg hx hy
  refine ⟨fun _ h => h.1, ?_⟩
  intro psi hpsi theta htheta omega homega hseg
  refine ⟨hpsi, ?_⟩
  let p : Submodule ℂ A := D.toSubalgebra.toSubmodule
  let psiD : D →L[ℂ] ℂ := psi.toStrongDual.comp p.subtypeL
  let thetaD : D →L[ℂ] ℂ := theta.toStrongDual.comp p.subtypeL
  have hpsiD : psiD ∈ stateSpace D := by
    refine ⟨?_, hpsi.2⟩
    intro d hd
    exact hpsi.1 (d : A) (coe_nonnegative hd)
  have hthetaD : thetaD ∈ stateSpace D := by
    refine ⟨?_, htheta.2⟩
    intro d hd
    exact htheta.1 (d : A) (coe_nonnegative hd)
  have hsegD : phi ∈ openSegment ℝ psiD thetaD := by
    rcases hseg with ⟨s, t, hs, ht, hst, hconv⟩
    refine ⟨s, t, hs, ht, hst, ?_⟩
    apply ContinuousLinearMap.ext
    intro d
    have hv := congrArg (fun q : WeakDual ℂ A => q (d : A)) hconv
    change s • psi (d : A) + t • theta (d : A) = omega (d : A) at hv
    change s • psi (d : A) + t • theta (d : A) = phi d
    simpa only [homega.2 d] using hv
  rw [IsPureState, mem_extremePoints] at hphi
  have hends := hphi.2 psiD hpsiD thetaD hthetaD hsegD
  intro d
  exact congrArg (fun q : D →L[ℂ] ℂ => q d) hends.1

/-- Every pure state of a closed unital star subalgebra extends to an actual
pure state of the ambient algebra. The source state need not be a character. -/
theorem exists_pure_state_extension [Nontrivial A]
    (phi : D →L[ℂ] ℂ) (hphi : IsPureState D phi) :
    ∃ psi : A →L[ℂ] ℂ,
      psi ∈ stateSpace A ∧ IsPureState A psi ∧ ∀ d : D, psi d = phi d := by
  have hphi_state : phi ∈ stateSpace D := hphi.1
  obtain ⟨f, hfext⟩ := (isCompact_weakStateRestrictionFiber D phi).extremePoints_nonempty
    (weakStateRestrictionFiber_nonempty D phi hphi_state)
  have hfstate : f ∈ (weakStateSpace A).extremePoints ℝ :=
    (isExtreme_weakStateRestrictionFiber D phi hphi).extremePoints_subset_extremePoints hfext
  refine ⟨f.toStrongDual, hfext.1.1, ?_, hfext.1.2⟩
  rw [IsPureState, mem_extremePoints_iff_left]
  rw [mem_extremePoints_iff_left] at hfstate
  refine ⟨hfstate.1, ?_⟩
  intro psi hpsi theta htheta hseg
  let psi' : WeakDual ℂ A := StrongDual.toWeakDual psi
  let theta' : WeakDual ℂ A := StrongDual.toWeakDual theta
  have hseg' : f ∈ openSegment ℝ psi' theta' := by
    rcases hseg with ⟨s, t, hs, ht, hst, hconv⟩
    refine ⟨s, t, hs, ht, hst, ?_⟩
    apply DFunLike.ext _ _
    intro a
    change s • psi a + t • theta a = f a
    exact congrArg (fun q : StrongDual ℂ A => q a) hconv
  have heq : psi' = f := hfstate.2 psi' hpsi theta' htheta hseg'
  apply ContinuousLinearMap.ext
  intro a
  exact congrArg (fun q : WeakDual ℂ A => q a) heq

/-- An actual state extension supplies the isometry between the concrete GNS
Hilbert spaces, with the prescribed cyclic vectors and the full intertwining
equations. The target space need not be cyclic for the subalgebra. -/
theorem exists_gns_isometry_of_state_extension
    (phi : D →L[ℂ] ℂ) (hphi : phi ∈ stateSpace D)
    (psi : A →L[ℂ] ℂ) (hpsi : psi ∈ stateSpace A)
    (hext : ∀ d : D, psi d = phi d) :
    ∃ U : (positiveLinearMapOfMemStateSpace phi hphi).GNS →ₗᵢ[ℂ]
        (positiveLinearMapOfMemStateSpace psi hpsi).GNS,
      U (stateGNSVector phi hphi) = stateGNSVector psi hpsi ∧
      ∀ (d : D) x,
        U ((positiveLinearMapOfMemStateSpace phi hphi).gnsStarAlgHom d x) =
          (positiveLinearMapOfMemStateSpace psi hpsi).gnsStarAlgHom (d : A) (U x) := by
  let pi := (positiveLinearMapOfMemStateSpace phi hphi).gnsStarAlgHom
  let rho := (positiveLinearMapOfMemStateSpace psi hpsi).gnsStarAlgHom
  let rhoD : Representation D (positiveLinearMapOfMemStateSpace psi hpsi).GNS :=
    rho.comp D.subtype
  apply Representation.exists_isometry_of_eq_vector_state pi rhoD
    (stateGNSVector phi hphi) (stateGNSVector psi hpsi)
    (denseRange_gnsStarAlgHom_stateGNSVector phi hphi)
  intro d
  calc
    inner ℂ (stateGNSVector phi hphi) (pi d (stateGNSVector phi hphi)) = phi d :=
      inner_gnsStarAlgHom_stateGNSVector phi hphi d
    _ = psi (d : A) := (hext d).symm
    _ = inner ℂ (stateGNSVector psi hpsi) (rhoD d (stateGNSVector psi hpsi)) :=
      (inner_gnsStarAlgHom_stateGNSVector psi hpsi (d : A)).symm

/-- Pure extension and the associated GNS embedding are supplied together,
with no cyclic-isometry hypothesis left to the consumer. -/
theorem exists_pure_state_extension_with_gns_isometry [Nontrivial A]
    (phi : D →L[ℂ] ℂ) (hphi : IsPureState D phi) :
    ∃ (psi : A →L[ℂ] ℂ) (hpsi : psi ∈ stateSpace A),
      IsPureState A psi ∧ (∀ d : D, psi d = phi d) ∧
      ∃ U : (positiveLinearMapOfMemStateSpace phi hphi.1).GNS →ₗᵢ[ℂ]
          (positiveLinearMapOfMemStateSpace psi hpsi).GNS,
        U (stateGNSVector phi hphi.1) = stateGNSVector psi hpsi ∧
        ∀ (d : D) x,
          U ((positiveLinearMapOfMemStateSpace phi hphi.1).gnsStarAlgHom d x) =
            (positiveLinearMapOfMemStateSpace psi hpsi).gnsStarAlgHom (d : A) (U x) := by
  obtain ⟨psi, hpsi, hpure, hext⟩ := exists_pure_state_extension D phi hphi
  exact ⟨psi, hpsi, hpure, hext,
    exists_gns_isometry_of_state_extension D phi hphi.1 psi hpsi hext⟩

end ClosedSubalgebra

end MathlibAnnex.Analysis.CStarAlgebra
