/-!
# Nonzero square-zero elements and hereditary splitting

A detected commutator gives an irreducible action with two nonzero orthogonal
vectors. Existing nonunital self-adjoint interpolation produces eigenvalues
`1` and `-1` on those vectors. The genuine positive and negative CFC parts
have disjoint support, and an existing orbit-surjectivity theorem supplies
the middle coefficient. Their product is nonzero and has square zero.

All algebra witnesses belong to the original algebra. The proof uses neither
a unit in that algebra nor separability of it or of a representing Hilbert
space. The hereditary specialization uses the norm closure of `a A a⋆` and
does not replace it by the commutative algebra generated by `a`.

This proves an existence step for orthogonal hereditary splitting. It makes
no claim to construct matrix units, a CAR algebra, or a quotient map to CAR.
-/

set_option autoImplicit false
noncomputable section

open Set
open scoped CStarAlgebra

namespace MathlibAnnex.Analysis.CStarAlgebra

universe u v

section HilbertSpace

variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H]

/-- If two operators fail to commute, the Hilbert space contains a nonzero
vector and a nonzero vector orthogonal to its entire complex line. -/
private theorem exists_nonzero_mem_orthogonal_of_not_commute [Nontrivial H]
    {S T : H →L[ℂ] H} (hST : S * T ≠ T * S) :
    ∃ x y : H, x ≠ 0 ∧ y ≠ 0 ∧ y ∈ (ℂ ∙ x)ᗮ := by
  classical
  obtain ⟨x, hx⟩ := exists_ne (0 : H)
  let L : Submodule ℂ H := ℂ ∙ x
  have hL : L ≠ ⊤ := by
    intro htop
    have hmem (z : H) : z ∈ L := by rw [htop]; trivial
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hmem (S x))
    obtain ⟨d, hd⟩ := Submodule.mem_span_singleton.mp (hmem (T x))
    apply hST
    apply ContinuousLinearMap.ext
    intro z
    obtain ⟨e, rfl⟩ := Submodule.mem_span_singleton.mp (hmem z)
    change S (T (e • x)) = T (S (e • x))
    simp only [map_smul, ← hc, ← hd, smul_smul]
    congr 1
    ring
  obtain ⟨z, hz⟩ : ∃ z : H, z ∉ L := by
    by_contra! h
    exact hL (top_unique fun z _ => h z)
  let y : H := z - L.starProjection z
  have hy : y ≠ 0 := by
    intro hyzero
    have hz_eq : z = L.starProjection z := sub_eq_zero.mp hyzero
    apply hz
    rw [hz_eq]
    exact L.starProjection_apply_mem z
  exact ⟨x, y, hx, hy, L.sub_starProjection_mem_orthogonal z⟩

/-- On an eigenvector with eigenvalue one, the positive CFC part acts as
the identity. The existing reducing-corner CFC theorem supplies this fact
without introducing a second functional-calculus construction. -/
private theorem posPart_apply_eq_self_of_apply_eq_self
    {T : H →L[ℂ] H} (hT : IsSelfAdjoint T) {x : H} (hx : T x = x) :
    T⁺ x = x := by
  let L : Submodule ℂ H := ℂ ∙ x
  let P : H →L[ℂ] H := L.starProjection
  have hP : IsSelfAdjoint P := isSelfAdjoint_starProjection L
  have hright : T * P = P := by
    apply ContinuousLinearMap.ext
    intro z
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (L.starProjection_apply_mem z)
    change T (L.starProjection z) = L.starProjection z
    calc
      T (L.starProjection z) = T (c • x) := congrArg T hc.symm
      _ = c • x := by rw [map_smul, hx]
      _ = L.starProjection z := hc
  have hleft : P * T = P := by
    simpa only [star_mul, hT.star_eq, hP.star_eq] using congrArg star hright
  have hcomm : Commute T P := by
    rw [commute_iff_eq]
    exact hright.trans hleft.symm
  have hone : IsSelfAdjoint (1 : H →L[ℂ] H) := by
    rw [IsSelfAdjoint, star_one]
  have hcone : Commute (1 : H →L[ℂ] H) P := by
    rw [commute_iff_eq, one_mul, mul_one]
  have hf : Continuous (fun t : ℝ => t⁺) := by fun_prop
  have hfzero : (0 : ℝ)⁺ = 0 := by simp
  have hcorner := cfc_mul_eq_of_mul_eq hT hone
    (show IsStarProjection P from isStarProjection_starProjection)
    hcomm hcone (by simpa only [one_mul] using hright)
    (fun t : ℝ => t⁺) hf hfzero
  have hcfc (R : H →L[ℂ] H) : cfc (fun t : ℝ => t⁺) R = R⁺ := by
    rw [CFC.posPart_def, cfcₙ_eq_cfc hf.continuousOn hfzero]
  have hpos : T⁺ * P = P := by
    simpa only [hcfc, CFC.posPart_one, one_mul] using hcorner
  have hPx : P x = x := L.starProjection_eq_self_iff.mpr
    (Submodule.mem_span_singleton_self x)
  have heval := congrArg (fun R : H →L[ℂ] H => R x) hpos
  change T⁺ (P x) = P x at heval
  simpa only [hPx] using heval

end HilbertSpace

section IrreducibleAction

variable {A : Type u} [NonUnitalCStarAlgebra A]
variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H]

/-- Self-adjoint interpolation in the original, possibly nonunital algebra
with a singleton family of irreducible representations. -/
private theorem exists_selfAdjoint_eq_on_pair
    (pi : NonUnitalCStarRepresentation A H) (hpi : pi.IsIrreducible)
    (T : H →L[ℂ] H) (hT : IsSelfAdjoint T) (x y : H) :
    ∃ a : A, IsSelfAdjoint a ∧ pi a x = T x ∧ pi a y = T y := by
  classical
  let E : Submodule ℂ H := Submodule.span ℂ (↑({x, y} : Finset H) : Set H)
  letI : FiniteDimensional ℂ E := by
    change FiniteDimensional ℂ (Submodule.span ℂ (↑({x, y} : Finset H) : Set H))
    infer_instance
  obtain ⟨a, ha, -, hexact⟩ :=
    NonUnitalCStarRepresentation.exists_selfAdjoint_norm_le_forall_eq_on
      (I := Unit) (H := fun _ => H) (fun _ => pi) (fun _ => hpi)
      (fun i j hij => False.elim (hij (Subsingleton.elim i j)))
      (fun _ => E) (fun _ => T) (fun _ => hT)
      ‖T‖ (norm_nonneg T) (fun _ => le_rfl)
  exact ⟨a, ha, hexact () x (Submodule.subset_span (by simp)),
    hexact () y (Submodule.subset_span (by simp))⟩

private theorem map_posPart_of_isSelfAdjoint
    (pi : NonUnitalCStarRepresentation A H) {a : A} (ha : IsSelfAdjoint a) :
    pi (a⁺) = (pi a)⁺ := by
  rw [CFC.posPart_def, CFC.posPart_def]
  exact pi.map_cfcₙ (fun t : ℝ => t⁺) a
    (hf := (show Continuous (fun t : ℝ => t⁺) by fun_prop).continuousOn)
    (hf₀ := by simp) (hφ := by fun_prop) (ha := ha) (hφa := ha.map pi)

/-- Disjoint positive and negative CFC parts produce an actual nonzero
square-zero element whenever an irreducible image contains noncommuting
operators. No nilpotent is supplied as a hypothesis. -/
theorem exists_ne_zero_mul_self_eq_zero_of_isIrreducible_of_not_commute
    (pi : NonUnitalCStarRepresentation A H) (hpi : pi.IsIrreducible)
    {b c : A} (hbc : pi b * pi c ≠ pi c * pi b) :
    ∃ x : A, x ≠ 0 ∧ x * x = 0 := by
  letI : Nontrivial H :=
    NonUnitalCStarRepresentation.nontrivial_of_isNonzero pi hpi.1
  obtain ⟨u, v, hu, hv, huv⟩ := exists_nonzero_mem_orthogonal_of_not_commute hbc
  let L : Submodule ℂ H := ℂ ∙ u
  let P : H →L[ℂ] H := L.starProjection
  let T : H →L[ℂ] H := P + P - 1
  have hP : IsSelfAdjoint P := isSelfAdjoint_starProjection L
  have hT : IsSelfAdjoint T := by
    rw [IsSelfAdjoint]
    simp only [T, star_sub, star_add, hP.star_eq, star_one]
  have hPu : P u = u := L.starProjection_eq_self_iff.mpr
    (Submodule.mem_span_singleton_self u)
  have hPv : P v = 0 := L.eq_starProjection_of_mem_orthogonal
    (L.zero_mem) (by simpa only [sub_zero] using huv)
  have hTu : T u = u := by
    change P u + P u - u = u
    rw [hPu]
    abel
  have hTv : T v = -v := by
    change P v + P v - v = -v
    rw [hPv]
    simp only [zero_add, zero_sub]
  obtain ⟨a, ha, hau, hav⟩ := exists_selfAdjoint_eq_on_pair pi hpi T hT u v
  rw [hTu] at hau
  rw [hTv] at hav
  have hpos : (pi a)⁺ u = u :=
    posPart_apply_eq_self_of_apply_eq_self (ha.map pi) hau
  have hneg : (pi a)⁻ v = v := by
    have h := posPart_apply_eq_self_of_apply_eq_self (ha.map pi).neg
      (x := v) (show (-pi a) v = v by
        simp only [ContinuousLinearMap.neg_apply, hav, neg_neg])
    simpa only [CFC.posPart_neg] using h
  have hmappos : pi (a⁺) = (pi a)⁺ := map_posPart_of_isSelfAdjoint pi ha
  have hmapneg : pi (a⁻) = (pi a)⁻ := by
    rw [← CFC.posPart_neg a, map_posPart_of_isSelfAdjoint pi ha.neg,
      map_neg, CFC.posPart_neg]
  obtain ⟨d, hd⟩ :=
    NonUnitalCStarRepresentation.apply_surjective_of_isIrreducible pi hpi hv u
  change pi d v = u at hd
  refine ⟨a⁺ * d * a⁻, ?_, ?_⟩
  · intro hz
    have heval : pi (a⁺ * d * a⁻) v = 0 := by rw [hz, map_zero]; rfl
    rw [map_mul, map_mul] at heval
    change pi (a⁺) (pi d (pi (a⁻) v)) = 0 at heval
    rw [hmapneg, hneg, hd, hmappos, hpos] at heval
    exact hu heval
  · calc
      (a⁺ * d * a⁻) * (a⁺ * d * a⁻) = a⁺ * d * (a⁻ * a⁺) * d * a⁻ := by
        simp only [mul_assoc]
      _ = 0 := by
        rw [CFC.negPart_mul_posPart]
        simp only [mul_zero, zero_mul]

end IrreducibleAction

variable {A : Type u} [NonUnitalCStarAlgebra A]

attribute [local instance] _root_.CStarAlgebra.spectralOrder
  _root_.CStarAlgebra.spectralOrderedRing

/-- Every noncommutative nonunital C-star algebra contains a nonzero
square-zero element. Primitive separation is used only to detect a concrete
nonzero commutator, before the independent disjoint-CFC construction. -/
theorem exists_ne_zero_mul_self_eq_zero_of_not_commutative
    (hcomm : ¬ ∀ b c : A, b * c = c * b) :
    ∃ x : A, x ≠ 0 ∧ x * x = 0 := by
  classical
  push_neg at hcomm
  obtain ⟨b, c, hbc⟩ := hcomm
  have hbot : IsClosed ((⊥ : TwoSidedIdeal A) : Set A) := by
    change IsClosed ({0} : Set A)
    exact isClosed_singleton
  have hnotmem : b * c - c * b ∉ (⊥ : TwoSidedIdeal A) := by
    simpa only [TwoSidedIdeal.mem_bot, sub_eq_zero] using hbc
  obtain ⟨H, instN, h⟩ :=
    exists_isIrreducible_annihilating_ideal_of_not_mem
      (⊥ : TwoSidedIdeal A) hbot (b * c - c * b) hnotmem
  letI : NormedAddCommGroup H := instN
  obtain ⟨instI, h⟩ := h
  letI : InnerProductSpace ℂ H := instI
  obtain ⟨instC, pi, hpi, hdetect, -⟩ := h
  letI : CompleteSpace H := instC
  have hnoncomm : pi b * pi c ≠ pi c * pi b := by
    intro heq
    apply hdetect
    simp only [map_sub, map_mul, heq, sub_self]
  exact exists_ne_zero_mul_self_eq_zero_of_isIrreducible_of_not_commute pi hpi hnoncomm

/-- In an antiliminal algebra every hereditary algebra with nonzero
generator contains an actual nonzero square-zero element. The generator
need not be positive or self-adjoint. -/
theorem IsAntiliminal.exists_ne_zero_mul_self_eq_zero_mem_hereditarySubalgebra
    (hA : IsAntiliminal A) {a : A} (ha : a ≠ 0) :
    ∃ x : A, x ∈ hereditarySubalgebra a ∧ x ≠ 0 ∧ x * x = 0 := by
  have hcomm : ¬ ∀ x y : hereditarySubalgebra a, x * y = y * x := by
    intro h
    have hp : a * star a ≠ 0 := fun hz => ha (mul_star_self_eq_zero.mp hz)
    apply hp
    apply hA
    refine ⟨mul_star_self_nonneg a, ?_⟩
    intro x hx y hy
    have hle := hereditarySubalgebra_le_of_mem
      (mul_star_self_mem_hereditarySubalgebra a)
    exact congrArg (fun z : hereditarySubalgebra a => (z : A))
      (h ⟨x, hle hx⟩ ⟨y, hle hy⟩)
  obtain ⟨x, hx, hxx⟩ :=
    exists_ne_zero_mul_self_eq_zero_of_not_commutative hcomm
  refine ⟨x, x.property, ?_, ?_⟩
  · intro hz
    exact hx (Subtype.ext hz)
  · exact congrArg (fun z : hereditarySubalgebra a => (z : A)) hxx

/-- The proved existence theorem discharges the square-zero premise of the
existing orthogonal-hereditary splitting result. Both descendant generators
are nonzero positive elements, and every pair of elements in their full
closed hereditary algebras multiplies to zero in both orders. -/
theorem IsAntiliminal.exists_orthogonal_hereditary_subalgebras
    (hA : IsAntiliminal A) {a : A} (ha : a ≠ 0) :
    ∃ p q : A, 0 ≤ p ∧ 0 ≤ q ∧ p ≠ 0 ∧ q ≠ 0 ∧
      hereditarySubalgebra p ≤ hereditarySubalgebra a ∧
      hereditarySubalgebra q ≤ hereditarySubalgebra a ∧
      (∀ u ∈ hereditarySubalgebra p, ∀ v ∈ hereditarySubalgebra q, u * v = 0) ∧
      (∀ v ∈ hereditarySubalgebra q, ∀ u ∈ hereditarySubalgebra p, v * u = 0) := by
  obtain ⟨x, hxa, hx, hxx⟩ :=
    hA.exists_ne_zero_mul_self_eq_zero_mem_hereditarySubalgebra ha
  exact exists_orthogonal_hereditary_subalgebras_of_square_zero hx hxx hxa

end MathlibAnnex.Analysis.CStarAlgebra
